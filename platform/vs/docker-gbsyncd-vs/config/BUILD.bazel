"""Gearbox startup files and Make-owned image labels."""

load("@sonic_build_infra//oci:accounts.bzl", "account_layer")
load("@tar.bzl", "tar")
load("//tools/bazel/oci:manifest_labels.bzl", "manifest_labels")

package(default_visibility = [
    "//platform/vs/docker-gbsyncd-vs:__subpackages__",
    "//tools/bazel/tests:__pkg__",
])

manifest_labels(
    name = "labels",
    manifest = "//:target/bazel-manifests/docker-gbsyncd-vs/manifest.json",
)

manifest_labels(
    name = "debug_labels",
    manifest = "//:target/bazel-manifests/docker-gbsyncd-vs-dbg/manifest.json",
)

# OpenSSH's ssh-agent uses the added _ssh group. Inherit all base accounts.
account_layer(
    name = "groups",
    architecture = "amd64",
    base = "//platform/vs/docker-gbsyncd-vs:config_engine_base_layout",
    groups = [{
        "name": "_ssh",
        "password": "x",
        "gid": 104,
    }],
)

tar(
    name = "files",
    srcs = [
        "//platform/vs/docker-gbsyncd-vs:critical_processes",
        "//platform/vs/docker-gbsyncd-vs:start.sh",
        "//platform/vs/docker-gbsyncd-vs:supervisord.conf",
        "//platform/vs/docker-syncd-vs/config:openssh-client.conf",
    ],
    mtree = [
        "./ uid=0 gid=0 mode=0755 time=0 type=dir",
        "./etc uid=0 gid=0 mode=0755 time=0 type=dir",
        "./etc/supervisor uid=0 gid=0 mode=0755 time=0 type=dir",
        "./etc/supervisor/conf.d uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr/bin uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr/lib uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr/lib/tmpfiles.d uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr/lib/tmpfiles.d/openssh-client.conf uid=0 gid=0 mode=0644 time=0 type=file content=$(location //platform/vs/docker-syncd-vs/config:openssh-client.conf)",
        "./usr/bin/start.sh uid=0 gid=0 mode=0755 time=0 type=file content=$(location //platform/vs/docker-gbsyncd-vs:start.sh)",
        "./etc/supervisor/conf.d/supervisord.conf uid=0 gid=0 mode=0644 time=0 type=file content=$(location //platform/vs/docker-gbsyncd-vs:supervisord.conf)",
        "./etc/supervisor/critical_processes uid=0 gid=0 mode=0644 time=0 type=file content=$(location //platform/vs/docker-gbsyncd-vs:critical_processes)",
    ],
)
