load("@aspect_bazel_lib//lib:run_binary.bzl", "run_binary")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_distroless//apt:defs.bzl", "apt_install")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("@syncd_apt_inputs//:apt_inputs.bzl", "APT_INPUTS")
load("@tar.bzl", "tar")
load("//tools/bazel/dpkg:defs.bzl", "dpkg_filter", "sonic_layer")
load("//tools/bazel/oci:apt_install_inputs.bzl", "apt_install_inputs")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:installed_source_metadata.bzl", "installed_source_metadata")
load("//tools/bazel/oci:normalize_layer.bzl", "normalize_layer")
load("//tools/bazel/oci:repack_oci.bzl", "repack_oci")
load("//tools/bazel/oci:rootfs_metadata.bzl", "rootfs_metadata")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")

package(default_visibility = ["//visibility:public"])

# Export the original Make inputs directly to the OCI image and its tests.
# Keeping the declarations beside the files avoids a second path via symlinks.
exports_files(
    [
        "Dockerfile.j2",
        "critical_processes",
        "start.sh",
        "supervisord.conf",
    ],
    visibility = [
        "//platform/vs/docker-syncd-vs:__subpackages__",
        "//tools/bazel/tests:__pkg__",
    ],
)

# Supported configuration: native AMD64 Trixie VS, DASH/FIPS, no ASAN/RPC.
# The Make selector and checked package manifests enforce the feature boundary.
_COMPATIBLE_WITH = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
] + select({
    ":supported_source_configuration": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# FIPS is selected in the runtime handoff; debug inherits those package records.
_APT_POLICY = {
    "schema": 1,
    "image": "docker-syncd-vs",
    "architecture": "amd64",
    "distribution": "trixie",
    "retained_source": "make",
    "features": {
        "include_vs_dash_sai": "y",
        "include_fips": "y",
        "enable_asan": "n",
        "enable_syncd_rpc": "n",
    },
}

_DEBUG_APT_PACKAGES = [
    "gdb",
    "gdbserver",
    "sshpass",
    "strace",
    "vim",
]

# The shared validators consume these expectations as data. Source identities,
# dependency controls and installed paths remain in config/source_packages.json.
_PACKAGE_POLICY = dict(
    _APT_POLICY,
    debug_tools = _DEBUG_APT_PACKAGES,
    image_validation = {
        "entrypoint": ["/usr/local/bin/supervisord"],
        "command": None,
        "environment": {"DEBIAN_FRONTEND": "noninteractive"},
        "startup_files": {
            "usr/bin/start.sh": {
                "source": "platform/vs/docker-syncd-vs/start.sh",
                "mode": 0o755,
            },
            "etc/supervisor/conf.d/supervisord.conf": {
                "source": "platform/vs/docker-syncd-vs/supervisord.conf",
                "mode": 0o644,
            },
            "etc/supervisor/critical_processes": {
                "source": "platform/vs/docker-syncd-vs/critical_processes",
                "mode": 0o644,
            },
        },
        "required_elf_paths": ["usr/bin/syncd"],
        "debug_alternatives": [{
            "paths": ["etc/alternatives/" + name for name in [
                "editor",
                "ex",
                "rview",
                "vi",
                "view",
            ]],
            "before": "/usr/bin/vim.tiny",
            "after": "/usr/bin/vim.basic",
        }],
        "runtime_tag": "docker-syncd-vs:latest",
        "debug_tag": "docker-syncd-vs-dbg:latest",
        "package_state": True,
    },
    native = {
        "required_packages": [
            "syncd-vs",
            "libsairedis",
            "libsaimetadata",
            "libsaivs",
            "libswsscommon",
            "openssh-client",
        ],
        "required_sonames": {
            "libsairedis": "libsairedis.so.0",
            "libsaimetadata": "libsaimetadata.so.0",
            "libsaivs": "libsaivs.so.0",
            "libswsscommon": "libswsscommon.so.0",
        },
        # Existing Make packages without a supplied matching symbol package.
        "gap_packages": [
            "libsai",
            "p4lang-pi",
            "p4lang-bmv2",
            "p4lang-p4c",
        ],
        "local_dependency_pattern": "lib(?:sai|swsscommon|MdioIpcClient|pi)",
        "require_source": True,
        "require_imported_symbols": False,
    },
    retained_requirements = [],
)

write_file(
    name = "package_policy",
    out = "package_policy.json",
    content = [json.encode(_PACKAGE_POLICY)],
)

# Reuse the source-built config-engine graph, including its installed package state.
alias(
    name = "config_engine_base_layout",
    actual = "//dockers/docker-config-engine-trixie:docker-config-engine-trixie",
)

config_setting(
    name = "supported_source_configuration",
    flag_values = {
        "@sonic_swss_common//tools/bazel:yang_modules": "true",
        "@sonic_sairedis//:sai_backend": "vs",
        "@sonic_sairedis//:asic_platform": "generic",
        "@sonic_sairedis//:enable_debug": "false",
        "@sonic_sairedis//:enable_coverage": "false",
        "@sonic_sairedis//:enable_asan": "false",
        "@sonic_sairedis//:enable_vpp": "false",
        "@sonic_sairedis//:enable_rpcserver": "false",
        "@sonic_sairedis//:enable_dashsai": "true",
    },
)

# Keep the source owners' binary layers and debug-aspect traversal. Only
# replacements of distribution packages need Debian package ownership.
_SOURCE_PACKAGES = {
    "libswsscommon": "@sonic_swss_common//:libswsscommon_pkg",
    "libsairedis": "@sonic_sairedis//lib:libsairedis_pkg",
    "libsaimetadata": "@sonic_sairedis//meta:libsaimetadata_pkg",
    "libsaivs": "@sonic_sairedis//vslib:libsaivs_pkg",
    "syncd-vs": "@sonic_sairedis//syncd:syncd_pkg",
    "openssh-client": "@sonic_fips//openssh:openssh_client_pkg",
    "libnl-3-dev": "@libnl3//:libnl-3-dev_files",
    "libnl-route-3-dev": "@libnl3//:libnl-route-3-dev_files",
}

_SOURCE_DEBS = {
    "openssh-client": "@sonic_fips//openssh:openssh_client_deb",
    "libnl-3-dev": "@libnl3//:libnl_3_dev_deb",
    "libnl-route-3-dev": "@libnl3//:libnl_route_3_dev_deb",
}

_SOURCE_LAYERS = {name: target for name, target in _SOURCE_PACKAGES.items() if name not in _SOURCE_DEBS}

_SOURCE_TARGETS = dict(_SOURCE_LAYERS)

_SOURCE_TARGETS.update(_SOURCE_DEBS)

sonic_layer(
    name = "source_runtime_files",
    root_owned = True,
    tars = _SOURCE_LAYERS.values(),
)

# Common's runtime uses /var/run; preserve the base's /var/run -> /run link.
normalize_layer(
    name = "source_runtime_layer",
    src = ":source_runtime_files",
    base = ":config_engine_base_layout",
    expected_platform = "linux/amd64",
    modes = {"run/redis/sonic-db/database_config.json": "0644"},
    root_owned = True,
    tars = _SOURCE_LAYERS.values(),
)

# Inspect Debian replacements with the upstream tar toolchain. Ordinary
# source layers retain their existing TAR inputs and do not enter dpkg state.
_SOURCE_DATA = {
    name: "source_debs/" + name + "/data.archive"
    for name in _SOURCE_DEBS
}

_SOURCE_DATA.update(_SOURCE_LAYERS)

[
    genrule(
        name = "extract_source_" + name,
        srcs = [source],
        outs = [_SOURCE_DATA[name]],
        cmd = """set -euo pipefail
mapfile -t members < <("$(BSDTAR_BIN)" -tf "$(execpath {source})")
[[ "$${{#members[@]}}" == 3 && "$${{members[0]}}" == debian-binary ]]
case "$${{members[2]}}" in data.tar|data.tar.gz|data.tar.xz|data.tar.bz2) ;; *) exit 1 ;; esac
"$(BSDTAR_BIN)" -xOf "$(execpath {source})" "$${{members[2]}}" > "$@"
""".format(source = source),
        toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
        tools = ["@bsd_tar_toolchains//:resolved_toolchain"],
    )
    for name, source in _SOURCE_DEBS.items()
]

genrule(
    name = "source_contract",
    srcs = ["//platform/vs/docker-syncd-vs/config:source_packages.json"] + _SOURCE_DEBS.values(),
    outs = ["source_contract.json"],
    cmd = '"$(execpath //tools/bazel/oci:source_package_contract)"' +
          ' --spec="$(execpath //platform/vs/docker-syncd-vs/config:source_packages.json)"' +
          ' --tar="$(BSDTAR_BIN)" --output="$@" ' +
          " ".join(['--package="' + name + "=$(execpath " + target + ')"' for name, target in _SOURCE_DEBS.items()]) + " " +
          " ".join(['--package-target="' + name + "=" + target + '"' for name, target in _SOURCE_TARGETS.items()]),
    toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
    tools = [
        "//tools/bazel/oci:source_package_contract",
        "@bsd_tar_toolchains//:resolved_toolchain",
    ],
)

run_binary(
    name = "checked_source_runtime",
    srcs = [
        ":source_contract",
        "//platform/vs/docker-syncd-vs:config_engine_base_layout",
        "@syncd_source_modules//:libnl3.MODULE.bazel",
        "@syncd_source_modules//:sonic-fips.MODULE.bazel",
        "@syncd_source_modules//:sonic-sairedis.MODULE.bazel",
        "@syncd_source_modules//:sonic-swss-common.MODULE.bazel",
    ] + _SOURCE_DATA.values(),
    outs = [
        "source_packages.receipt.json",
        "source_runtime.tar",
    ],
    args = [
               "--contract=$(execpath :source_contract)",
               "--base=$(execpath //platform/vs/docker-syncd-vs:config_engine_base_layout)",
               "--module=sonic-swss-common=$(execpath @syncd_source_modules//:sonic-swss-common.MODULE.bazel)",
               "--module=sonic-sairedis=$(execpath @syncd_source_modules//:sonic-sairedis.MODULE.bazel)",
               "--module=sonic-fips=$(execpath @syncd_source_modules//:sonic-fips.MODULE.bazel)",
               "--module=libnl3=$(execpath @syncd_source_modules//:libnl3.MODULE.bazel)",
               "--out-tar=$(execpath source_runtime.tar)",
               "--receipt=$(execpath source_packages.receipt.json)",
           ] + ["--package=" + name + "=$(execpath " + target + ")" for name, target in _SOURCE_DATA.items()] +
           ["--package-target=" + name + "=" + target for name, target in _SOURCE_TARGETS.items()],
    mnemonic = "ValidateSyncdSourceRuntime",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ] + select({
        ":supported_source_configuration": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    tool = "//tools/bazel/oci:package_contract",
)

# Keep runtime independent of Make's debug handoff. Each selection input binds
# its own original manifest to the same checked source outputs.
[
    run_binary(
        name = variant + "_retained_packages",
        srcs = [
            "source_packages.receipt.json",
            ":" + variant + "_import_manifest",
            ":package_policy",
            ":source_contract",
        ],
        outs = [variant + "_retained_packages.json"],
        args = [
            "--contract=$(execpath :source_contract)",
            "--policy=$(execpath :package_policy)",
            "--merge-manifest=$(execpath :" + variant + "_import_manifest)",
            "--source-receipt=$(execpath source_packages.receipt.json)",
            "--out-manifest=$@",
        ],
        mnemonic = "SyncdRetainedPackages",
        tool = "//tools/bazel/oci:package_contract",
    )
    for variant in [
        "runtime",
        "debug",
    ]
]

[
    filegroup(
        name = name,
        srcs = [output],
    )
    for name, output in {
        "source_runtime_payloads": "source_runtime.tar",
        "source_package_receipt": "source_packages.receipt.json",
    }.items()
]

# Keep the public symbol label while collecting once from the shared owner graph.
alias(
    name = "source_debug_payloads",
    actual = "//platform/vs/docker-syncd-vs:rdeps_debug_symbols",
)

# Imported package bytes are declared inputs to Bazel. Make only builds these
# prerequisite files; extraction, hashing and assembly are ordinary cached actions.
# Each existing DEB is extracted directly by the declared upstream BSD tar
# toolchain. Order belongs to this image; Make remains the package producer.

# These four producer migrations are explicitly deferred. All other project
# runtime and debug inputs come from their source-owner targets or the base.
_RUNTIME_DEBS = [
    "//:target/debs/trixie/p4lang-pi_0.1.3-2_amd64.deb",
    "//:target/debs/trixie/p4lang-bmv2_1.15.0-9_amd64.deb",
    "//:target/debs/trixie/p4lang-p4c_1.2.4.2-3_amd64.deb",
    "//:target/debs/trixie/libsai_1.0.0_amd64.deb",
]

# A package shared by runtime and debug is extracted once. These public
# toolchain variables are provided by tar.bzl; no local extraction rule wraps it.
_DEB_ARCHIVES = {
    source: "extracted_debs/" + source.split("/")[-1]
    for source in _RUNTIME_DEBS
}

[
    genrule(
        name = "extract_" + source.split("/")[-1],
        srcs = [source],
        outs = [directory + "/" + filename for filename in [
            "members.txt",
            "debian-binary",
            "control.archive",
            "data.archive",
        ]],
        cmd = """set -euo pipefail
export LC_ALL=C.UTF-8
"$(BSDTAR_BIN)" -tf "$(execpath {source})" > "$(RULEDIR)/{directory}/members.txt"
mapfile -t members < "$(RULEDIR)/{directory}/members.txt"
[[ "$${{#members[@]}}" == 3 && "$${{members[0]}}" == debian-binary ]]
case "$${{members[1]}}" in control.tar|control.tar.gz|control.tar.xz|control.tar.bz2) ;; *) exit 1 ;; esac
case "$${{members[2]}}" in data.tar|data.tar.gz|data.tar.xz|data.tar.bz2) ;; *) exit 1 ;; esac
"$(BSDTAR_BIN)" -xOf "$(execpath {source})" debian-binary > "$(RULEDIR)/{directory}/debian-binary"
"$(BSDTAR_BIN)" -xOf "$(execpath {source})" "$${{members[1]}}" > "$(RULEDIR)/{directory}/control.archive"
"$(BSDTAR_BIN)" -xOf "$(execpath {source})" "$${{members[2]}}" > "$(RULEDIR)/{directory}/data.archive"
""".format(
            directory = directory,
            source = source,
        ),
        toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
        tools = ["@bsd_tar_toolchains//:resolved_toolchain"],
        visibility = ["//visibility:private"],
    )
    for source, directory in _DEB_ARCHIVES.items()
]

# Assemble the inherited P4 payload once. BSD tar preserves extended metadata
# with PAX headers; Distroless flatten writes GNU headers instead.
genrule(
    name = "runtime_debs_payload",
    srcs = [_DEB_ARCHIVES[source] + "/data.archive" for source in _RUNTIME_DEBS],
    outs = ["runtime_debs/payload.tar"],
    cmd = "set -euo pipefail\nexport LC_ALL=C.UTF-8\n" +
          "\"$(BSDTAR_BIN)\" --format=pax -cf \"$@\" " +
          " ".join(["\"@$(execpath " + _DEB_ARCHIVES[source] + "/data.archive)\"" for source in _RUNTIME_DEBS]),
    toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
    tools = ["@bsd_tar_toolchains//:resolved_toolchain"],
    visibility = ["//visibility:private"],
)

# Receipts resolve payload.tar beside manifest.json. Preserve that public file
# layout with a declared symlink, without assembling or storing a second TAR.
copy_file(
    name = "debug_debs_payload",
    src = "runtime_debs/payload.tar",
    out = "debug_debs/payload.tar",
    allow_symlink = True,
    visibility = ["//visibility:private"],
)

# Validate policy and provenance separately for each image variant. Debug
# inherits the same package bytes and binds its receipt to the runtime receipt.
_PACKAGE_SETS = {
    "runtime_debs": {
        "srcs": _RUNTIME_DEBS,
        "context": {
            "image": _APT_POLICY["image"],
            "variant": "runtime",
            "distribution": _APT_POLICY["distribution"],
            "features": _APT_POLICY["features"],
            "required_packages": [
                "libsai",
                "p4lang-bmv2",
                "p4lang-p4c",
                "p4lang-pi",
            ],
            "debug_apt_packages": [],
        },
        "parent": "",
    },
    "debug_debs": {
        "srcs": _RUNTIME_DEBS,
        "context": {
            "image": _APT_POLICY["image"],
            "variant": "debug",
            "distribution": _APT_POLICY["distribution"],
            "features": _APT_POLICY["features"],
            "required_packages": [
                "libsai",
                "p4lang-bmv2",
                "p4lang-p4c",
                "p4lang-pi",
            ],
            "debug_apt_packages": _DEBUG_APT_PACKAGES,
        },
        "parent": ":runtime_import_manifest",
    },
}

[
    genrule(
        name = name + "_receipt",
        srcs = inputs["srcs"] + [name + "/payload.tar"] + [
            _DEB_ARCHIVES[source] + "/" + filename
            for source in inputs["srcs"]
            for filename in [
                "members.txt",
                "debian-binary",
                "control.archive",
                "data.archive",
            ]
        ] + ([inputs["parent"]] if inputs["parent"] else []),
        outs = [name + "/manifest.json"],
        cmd = "set -euo pipefail\nexport LC_ALL=C.UTF-8\n" +
              "\"$(execpath //tools/bazel/oci:package_receipts)\"" +
              " --payload='$(execpath " + name + "/payload.tar)'" +
              " --out='$(RULEDIR)/" + name + "/manifest.json'" +
              " --architecture=" + _APT_POLICY["architecture"] +
              " --context='" + json.encode(inputs["context"]) + "'" +
              (" --runtime-manifest='$(execpath " + inputs["parent"] + ")'" if inputs["parent"] else "") +
              " ".join([" --package='" + json.encode({
                  "source_label": source,
                  "source": "$(execpath " + source + ")",
                  "members": "$(execpath " + _DEB_ARCHIVES[source] + "/members.txt)",
                  "version": "$(execpath " + _DEB_ARCHIVES[source] + "/debian-binary)",
                  "control": "$(execpath " + _DEB_ARCHIVES[source] + "/control.archive)",
                  "data": "$(execpath " + _DEB_ARCHIVES[source] + "/data.archive)",
              }) + "'" for source in inputs["srcs"]]),
        tools = ["//tools/bazel/oci:package_receipts"],
        visibility = ["//visibility:private"],
    )
    for name, inputs in _PACKAGE_SETS.items()
]

[
    filegroup(
        name = name,
        srcs = [name + "/payload.tar"],
    )
    for name in _PACKAGE_SETS
]

filegroup(
    name = "runtime_import_manifest",
    srcs = ["runtime_debs/manifest.json"],
)

normalize_layer(
    name = "checked_runtime_payloads",
    src = ":runtime_debs",
    base = ":config_engine_base_layout",
    expected_platform = "linux/amd64",
)

# Runtime inputs. Common, sairedis and metadata reuse SWSS's source targets.
# Only the cached PI/BMv2/p4c and DASH SAI packages remain imported.
# Both input adapters preserve the base's merged-usr directory aliases.
apt_layer(
    name = "runtime_layer",
    base = ":config_engine_base_layout",
    dependency_set = "syncd_vs_debian",
    lock = "//platform/vs/docker-syncd-vs/bazel:apt.lock.json",
    packages = APT_INPUTS["syncd_vs_debian"]["amd64"],
    policy = _APT_POLICY,
    retained_manifest = ":runtime_retained_packages",
    variant = "runtime",
)

filegroup(
    name = "runtime_apt_selection",
    srcs = [":runtime_layer"],
    output_group = "selection",
)

# The runtime adapter has already combined and normalized these owner TARs.
# Keep their original tars edges, as sonic_layer does, so the shared collector
# can find symbols through each owner's flatten/sonic_deploy_tar graph.
dpkg_filter(
    name = "rdeps",
    src = ":source_runtime_payloads",
    tars = _SOURCE_PACKAGES.values(),
)

debug_symbols_layer(
    name = "rdeps_debug_symbols",
    image = ":rdeps",
)

apt_install_inputs(
    name = "runtime_install_inputs",
    additional_packages = _RUNTIME_DEBS + _SOURCE_DEBS.values(),
    packages = {key: label + ":deb" for key, label in APT_INPUTS["syncd_vs_debian"]["amd64"].items()},
    selection = ":runtime_apt_selection",
)

# Install selected Debian packages and genuine Debian replacements together:
# libibverbs-dev needs source libnl development packages, and openmpi-bin needs
# the source OpenSSH client. APT must see both sides in the same transaction.
apt_install(
    name = "configured_sources",
    architecture = "amd64",
    base = "//dockers/docker-config-engine-trixie:rootfs",
    bwrap = "//tools/bazel/oci:bubblewrap",
    execution_environment = "debian:trixie-20260918@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c",
    packages = [label + ":deb" for label in APT_INPUTS["syncd_vs_debian"]["amd64"].values()] + _RUNTIME_DEBS + _SOURCE_DEBS.values(),
    packages_manifest = ":runtime_install_inputs",
    tags = ["manual"],
)

filegroup(
    name = "installation_receipt",
    srcs = [":configured_sources"],
    output_group = "receipt",
)

installed_source_metadata(
    name = "runtime_package_metadata",
    architecture = "amd64",
    installation = ":installation_receipt",
    packages = _SOURCE_DEBS,
    payloads = _SOURCE_LAYERS,
    rootfs = ":configured_sources",
    runtime_layer = ":source_runtime_layer",
    selection = ":runtime_apt_selection",
    spec = "//platform/vs/docker-syncd-vs/config:source_packages.json",
)

tar(
    name = "source_provenance",
    srcs = [":runtime_package_metadata"],
    mtree = [
        "usr/share/sonic/bazel type=dir mode=0755 uid=0 gid=0 time=0",
        "usr/share/sonic/bazel/syncd-packages.json type=file mode=0644 uid=0 gid=0 time=0 content=$(location :runtime_package_metadata)",
    ],
)

flatten(
    name = "complete_filesystem",
    deduplicate = True,
    tars = [
        ":configured_sources",
        ":source_runtime_layer",
        "//platform/vs/docker-syncd-vs/config:files",
        ":source_provenance",
    ],
)

rootfs_metadata(
    name = "rootfs",
    src = ":complete_filesystem",
    tars = [
        "//dockers/docker-config-engine-trixie:rootfs",
        ":rdeps",
    ],
)

repack_oci(
    name = "configured_image",
    base = "//dockers/docker-config-engine-trixie:docker-config-engine-trixie",
    execution_environment = "debian:trixie-20260918@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c",
    platform = "linux/amd64",
    tars = [":rootfs"],
)

oci_image(
    name = "docker-syncd-vs",
    base = ":configured_image",
    entrypoint = ["/usr/local/bin/supervisord"],
    env = {"DEBIAN_FRONTEND": "noninteractive"},
    labels = "//platform/vs/docker-syncd-vs/config:labels",
    target_compatible_with = _COMPATIBLE_WITH,
)

sonic_docker_archive(
    name = "docker-syncd-vs.gz",
    image = ":docker-syncd-vs",
)

filegroup(
    name = "debug_import_manifest",
    srcs = ["debug_debs/manifest.json"],
)

normalize_layer(
    name = "checked_debug_payloads",
    src = ":debug_debs",
    base = ":docker-syncd-vs",
    expected_platform = "linux/amd64",
)

# The base's source graph supplies its exact companion symbols. The installed
# image validator checks every source ELF against the declared base receipts.
sonic_layer(
    name = "debug_packages",
    tars = [
