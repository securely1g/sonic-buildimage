"""Syncd startup files and Make-owned image labels."""

load("@aspect_bazel_lib//lib:run_binary.bzl", "run_binary")
load("@tar.bzl", "tar")
load("//tools/bazel/oci:manifest_labels.bzl", "manifest_labels")

package(default_visibility = [
    "//platform/vs/docker-syncd-vs:__subpackages__",
    "//tools/bazel/tests:__pkg__",
])

manifest_labels(
    name = "labels",
    manifest = "//:target/bazel-manifests/docker-syncd-vs/manifest.json",
)

manifest_labels(
    name = "debug_labels",
    manifest = "//:target/bazel-manifests/docker-syncd-vs-dbg/manifest.json",
)

tar(
    name = "files",
    srcs = [
        "//platform/vs/docker-syncd-vs:critical_processes",
        "//platform/vs/docker-syncd-vs:start.sh",
        "//platform/vs/docker-syncd-vs:supervisord.conf",
    ],
    mtree = [
        "./ uid=0 gid=0 mode=0755 time=0 type=dir",
        "./etc uid=0 gid=0 mode=0755 time=0 type=dir",
        "./etc/supervisor uid=0 gid=0 mode=0755 time=0 type=dir",
        "./etc/supervisor/conf.d uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr/bin uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr/bin/start.sh uid=0 gid=0 mode=0755 time=0 type=file content=$(location //platform/vs/docker-syncd-vs:start.sh)",
        "./etc/supervisor/conf.d/supervisord.conf uid=0 gid=0 mode=0644 time=0 type=file content=$(location //platform/vs/docker-syncd-vs:supervisord.conf)",
        "./etc/supervisor/critical_processes uid=0 gid=0 mode=0644 time=0 type=file content=$(location //platform/vs/docker-syncd-vs:critical_processes)",
    ],
)

exports_files(
    [
        "runtime_package_state.json",
        "source_packages.json",
    ],
    visibility = ["//visibility:public"],
)

run_binary(
    name = "runtime_package_state",
    srcs = [
        "runtime_package_state.json",
        "source_packages.json",
        "//platform/vs/docker-syncd-vs:package_policy",
        "//platform/vs/docker-syncd-vs:apt_deps",
        "//platform/vs/docker-syncd-vs:config_engine_base_layout",
        "//platform/vs/docker-syncd-vs:runtime_apt_selection",
        "//platform/vs/docker-syncd-vs:runtime_import_manifest",
        "//platform/vs/docker-syncd-vs:runtime_packages",
        "//platform/vs/docker-syncd-vs/bazel:apt.lock.json",
    ],
    outs = ["runtime_package_state.tar"],
    args = [
        "--policy",
        "$(execpath //platform/vs/docker-syncd-vs:package_policy)",
        "--source-contract",
        "$(execpath source_packages.json)",
        "--contract",
        "$(execpath runtime_package_state.json)",
        "--apt-lock",
        "$(execpath //platform/vs/docker-syncd-vs/bazel:apt.lock.json)",
        "--selection",
        "$(execpath //platform/vs/docker-syncd-vs:runtime_apt_selection)",
        "--base",
        "$(execpath //platform/vs/docker-syncd-vs:config_engine_base_layout)",
        "--apt-layer",
        "$(execpath //platform/vs/docker-syncd-vs:apt_deps)",
        "--runtime-layer",
        "$(execpath //platform/vs/docker-syncd-vs:runtime_packages)",
        "--make-manifest",
        "$(execpath //platform/vs/docker-syncd-vs:runtime_import_manifest)",
        "--out",
        "$@",
    ],
    mnemonic = "BuildSyncdPackageState",
    tool = "//tools/bazel/oci:package_state",
)
