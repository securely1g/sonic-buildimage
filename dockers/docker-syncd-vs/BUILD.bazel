load("@rules_oci//oci:defs.bzl", "oci_image")
load("@tar.bzl", "tar")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:manifest_labels.bzl", "manifest_labels")
load("//tools/bazel/oci:oci_base_layout.bzl", "oci_base_layout")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")
load("@syncd_apt_inputs//:apt_inputs.bzl", "APT_INPUTS")

package(default_visibility = ["//visibility:public"])

exports_files([
    "legacy/Dockerfile.j2",
    "legacy/critical_processes",
    "legacy/start.sh",
    "legacy/supervisord.conf",
], visibility = ["//dockers/docker-syncd-vs/bazel:__pkg__"])

# Supported configuration: native AMD64 Trixie VS, DASH/FIPS, no ASAN/RPC.
# The Make selector and checked package manifests enforce the feature boundary.
_COMPATIBLE_WITH = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
]

# Keep Make package ownership and the reviewed debug replacement with the image.
_APT_POLICY = {
    "schema": 1,
    "image": "docker-syncd-vs",
    "architecture": "amd64",
    "distribution": "trixie",
    "retained_source": "make",
    "features": {
        "include_vs_dash_sai": "y",
        "include_fips": "y",
        "enable_asan": "n",
        "enable_syncd_rpc": "n",
    },
    "debug_replacements": [
        {"package": "openssh-client", "version_contains": "+fips"},
    ],
}

# Base and Make metadata. The same shared rules are used by docker-orchagent.
oci_base_layout(
    name = "config_engine_base_layout",
    srcs = [
        "//:config_engine_oci_files",
        "//:target/docker-config-engine-trixie.oci/oci-layout",
    ],
    expected_platform = "linux/amd64",
    marker = "$(execpath //:target/docker-config-engine-trixie.oci/oci-layout)",
    root = "target/docker-config-engine-trixie.oci",
)

manifest_labels(
    name = "labels",
    manifest = "//:target/bazel-manifests/docker-syncd-vs/manifest.json",
)

manifest_labels(
    name = "debug_labels",
    manifest = "//:target/bazel-manifests/docker-syncd-vs-dbg/manifest.json",
)

# Runtime inputs. Make still builds PI/BMv2/p4c, DASH SAI and syncd packages.
# Use the same shared dpkg path filtering as SWSS. The Make handoff supplies
# one ordered data tar from the native package closure. Validation
# preserves the base's merged-usr aliases before the layer is flattened.
apt_layer(
    name = "runtime_layer",
    base = ":config_engine_base_layout",
    packages = APT_INPUTS["syncd_vs_debian"]["amd64"],
    dependency_set = "syncd_vs_debian",
    lock = "//dockers/docker-syncd-vs/bazel:apt.lock.json",
    policy = _APT_POLICY,
    retained_manifest = "//:target/bazel-inputs/docker-syncd-vs/runtime/manifest.json",
    variant = "runtime",
)

filegroup(
    name = "runtime_apt_selection",
    srcs = [":runtime_layer"],
    output_group = "selection",
)

sonic_layer(
    name = "apt_deps",
    tars = [":runtime_layer"],
)

alias(
    name = "checked_runtime_payloads",
    actual = "//dockers/docker-syncd-vs/bazel:checked_runtime_payloads",
)

sonic_layer(
    name = "runtime_packages",
    tars = [
        ":checked_runtime_payloads",
    ],
)

alias(
    name = "runtime_package_state",
    actual = "//dockers/docker-syncd-vs/bazel:runtime_package_state",
)

tar(
    name = "files",
    srcs = [
        "legacy/critical_processes",
        "legacy/start.sh",
        "legacy/supervisord.conf",
    ],
    mtree = [
        "./ uid=0 gid=0 mode=0755 time=0 type=dir",
        "./etc uid=0 gid=0 mode=0755 time=0 type=dir",
        "./etc/supervisor uid=0 gid=0 mode=0755 time=0 type=dir",
        "./etc/supervisor/conf.d uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr/bin uid=0 gid=0 mode=0755 time=0 type=dir",
        "./usr/bin/start.sh uid=0 gid=0 mode=0755 time=0 type=file content=$(location legacy/start.sh)",
        "./etc/supervisor/conf.d/supervisord.conf uid=0 gid=0 mode=0644 time=0 type=file content=$(location legacy/supervisord.conf)",
        "./etc/supervisor/critical_processes uid=0 gid=0 mode=0644 time=0 type=file content=$(location legacy/critical_processes)",
    ],
)

# Runtime image and Make-compatible archive; keep the layer order explicit.
oci_image(
    name = "docker-syncd-vs",
    base = ":config_engine_base_layout",
    entrypoint = ["/usr/local/bin/supervisord"],
    env = {"DEBIAN_FRONTEND": "noninteractive"},
    labels = ":labels",
    target_compatible_with = _COMPATIBLE_WITH,
    tars = [
        ":apt_deps",
        ":runtime_packages",
        ":runtime_package_state",
        ":files",
    ],
)

sonic_docker_archive(
    name = "docker-syncd-vs.gz",
    image = ":docker-syncd-vs",
)

# Debug inputs are checked against the exact runtime image and package handoff.
alias(
    name = "checked_debug_payloads",
    actual = "//dockers/docker-syncd-vs/bazel:checked_debug_payloads",
)

sonic_layer(
    name = "debug_packages",
    tars = [
        ":checked_debug_payloads",
    ],
)

apt_layer(
    name = "debug_layer",
    base = ":docker-syncd-vs",
    packages = APT_INPUTS["syncd_vs_debug_debian"]["amd64"],
    dependency_set = "syncd_vs_debug_debian",
    lock = "//dockers/docker-syncd-vs/bazel:apt.lock.json",
    base_package_metadata = ":runtime_apt_selection",
    policy = _APT_POLICY,
    retained_manifest = "//:target/bazel-inputs/docker-syncd-vs/debug/manifest.json",
    variant = "debug",
)

filegroup(
    name = "debug_apt_selection",
    srcs = [":debug_layer"],
    output_group = "selection",
)

# Match the standard FIPS Make debug package set. The selector retains runtime
# packages and ELF files. Matching FIPS OpenSSH and native symbols come from
# debug_packages. Reuse the existing Vim alternatives implementation.
sonic_layer(
    name = "debug_tools",
    tars = [
        ":debug_layer",
        "@sonic_build_infra//deps/vim:vim_pkg",
        "@sonic_build_infra//deps/vim:vim_runtime_pkg",
        "@sonic_build_infra//deps/vim:vim_alternatives_pkg",
    ],
)

# Debug extends the runtime layers; imported symbols retain their documented gaps.
oci_image(
    name = "docker-syncd-vs-dbg",
    base = ":docker-syncd-vs",
    labels = ":debug_labels",
    target_compatible_with = _COMPATIBLE_WITH,
    tars = [
        ":debug_tools",
        ":debug_packages",
    ],
)

sonic_docker_archive(
    name = "docker-syncd-vs-dbg.gz",
    image = ":docker-syncd-vs-dbg",
)

# Public validation and contract-test labels. CI runs the owner tests.
# See bazel/README.md for separate complete-image, runtime and installer checks.
alias(
    name = "validate_payloads",
    actual = "//dockers/docker-syncd-vs/bazel:validate_payloads",
)

alias(
    name = "package_state_layer",
    actual = "//dockers/docker-syncd-vs/bazel:package_state_layer",
)

alias(
    name = "validate_payloads_test",
    actual = "//dockers/docker-syncd-vs/bazel:validate_payloads_test",
)

alias(
    name = "validate_image_test",
    actual = "//dockers/docker-syncd-vs/bazel:validate_image_test",
)

alias(
    name = "select_apt_payloads_test",
    actual = "//dockers/docker-syncd-vs/bazel:select_apt_payloads_test",
)

alias(
    name = "package_state_layer_test",
    actual = "//dockers/docker-syncd-vs/bazel:package_state_layer_test",
)

alias(
    name = "manifest_labels_test",
    actual = "//dockers/docker-syncd-vs/bazel:manifest_labels_test",
)
