"""Syncd's source-package and Make-package inputs, with OCI contract tests."""

load("@aspect_bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

package(default_visibility = ["//dockers/docker-syncd-vs:__pkg__"])

exports_files([
    "apt.lock.json",
    "apt_inputs.MODULE.bazel",
    "runtime_package_state.json",
    "source_packages.json",
    "base_debug_symbols.json",
])

py_library(
    name = "base_debug_symbols",
    srcs = ["base_debug_symbols.py"],
    data = ["base_debug_symbols.json"],
    imports = ["."],
    deps = ["//tools/bazel/ci:artifact_validation"],
)

py_test(
    name = "base_debug_symbols_test",
    srcs = ["tests/base_debug_symbols_test.py"],
    main = "tests/base_debug_symbols_test.py",
    python_version = "3.11",
    deps = [":base_debug_symbols"],
)

py_library(
    name = "package_policy",
    srcs = ["package_policy.py"],
    imports = ["."],
    deps = [":base_debug_symbols"],
)

_VALIDATION_DEPS = [
    ":package_policy",
    ":base_debug_symbols",
    "@sonic_build_infra//apt:lib",
    "//tools/bazel/ci:artifact_validation",
    "//tools/bazel/oci:oci_layout",
    "//tools/bazel/oci:oci_inventory",
]
_TEST_DEPS = _VALIDATION_DEPS + ["//tools/bazel/tests:oci_base_fixture_lib"]

# The shared libraries use SWSS's ordinary source configuration. DASH remains
# enabled for the separate Make-built syncd executable and SAI implementation.
config_setting(
    name = "supported_source_configuration",
    flag_values = {
        "@sonic_swss_common//tools/bazel:yang_modules": "true",
        "@sonic_sairedis//:sai_backend": "vs",
        "@sonic_sairedis//:asic_platform": "generic",
        "@sonic_sairedis//:enable_debug": "false",
        "@sonic_sairedis//:enable_coverage": "false",
        "@sonic_sairedis//:enable_asan": "false",
        "@sonic_sairedis//:enable_vpp": "false",
        "@sonic_sairedis//:enable_rpcserver": "false",
        "@sonic_sairedis//:enable_dashsai": "false",
    },
)

# These are the exact owner targets also consumed by Orchagent. The source
# libraries and their symbols share Bazel's normal dependency and cache graph.
_SOURCE_PACKAGES = {
    "libswsscommon": "@sonic_swss_common//:libswsscommon_pkg",
    "libsairedis": "@sonic_sairedis//lib:libsairedis_pkg",
    "libsaimetadata": "@sonic_sairedis//meta:libsaimetadata_pkg",
}

py_binary(
    name = "source_packages",
    srcs = ["source_packages.py", "validate_payloads.py"],
    main = "source_packages.py",
    python_version = "3.11",
    deps = _VALIDATION_DEPS,
)

run_binary(
    name = "checked_source_runtime",
    srcs = [
        "source_packages.json",
        "//dockers/docker-syncd-vs:config_engine_base_layout",
        "@syncd_source_modules//:sonic-swss-common.MODULE.bazel",
        "@syncd_source_modules//:sonic-sairedis.MODULE.bazel",
    ] + _SOURCE_PACKAGES.values(),
    outs = [
        "source_runtime.tar",
        "source_packages.receipt.json",
    ],
    args = [
        "--contract=$(execpath source_packages.json)",
        "--base=$(execpath //dockers/docker-syncd-vs:config_engine_base_layout)",
        "--module=sonic-swss-common=$(execpath @syncd_source_modules//:sonic-swss-common.MODULE.bazel)",
        "--module=sonic-sairedis=$(execpath @syncd_source_modules//:sonic-sairedis.MODULE.bazel)",
        "--out-tar=$(execpath source_runtime.tar)",
        "--receipt=$(execpath source_packages.receipt.json)",
    ] + ["--package=" + name + "=$(execpath " + target + ")" for name, target in _SOURCE_PACKAGES.items()],
    mnemonic = "ValidateSyncdSourceRuntime",
    tool = ":source_packages",
    target_compatible_with = ["@platforms//cpu:x86_64", "@platforms//os:linux"] + select({
        ":supported_source_configuration": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

# Keep runtime independent of Make's debug handoff. Each selection input binds
# its own original manifest to the same checked source outputs.
[
    run_binary(
        name = variant + "_retained_packages",
        srcs = [
            "source_packages.receipt.json",
            "//:target/bazel-inputs/docker-syncd-vs/" + variant + "/manifest.json",
        ],
        outs = [variant + "_retained_packages.json"],
        args = [
            "--merge-manifest=$(execpath //:target/bazel-inputs/docker-syncd-vs/" + variant + "/manifest.json)",
            "--source-receipt=$(execpath source_packages.receipt.json)",
            "--out-manifest=$@",
        ],
        mnemonic = "SyncdRetainedPackages",
        tool = ":source_packages",
    )
    for variant in ["runtime", "debug"]
]

[
    filegroup(
        name = name,
        srcs = [output],
    )
    for name, output in {
        "source_runtime_payloads": "source_runtime.tar",
        "source_package_receipt": "source_packages.receipt.json",
    }.items()
]

# Keep the public symbol label while collecting once from the shared owner graph.
alias(
    name = "source_debug_payloads",
    actual = "//dockers/docker-syncd-vs:rdeps_debug_symbols",
)

py_test(
    name = "source_packages_test",
    srcs = ["tests/source_packages_test.py", "source_packages.py", "validate_payloads.py"],
    main = "tests/source_packages_test.py",
    data = ["source_packages.json"],
    python_version = "3.11",
    deps = _TEST_DEPS,
)

# These actions consume the existing Make manifest and ordered tar; no DEB is built.
py_binary(
    name = "validate_payloads",
    srcs = ["validate_payloads.py"],
    main = "validate_payloads.py",
    python_version = "3.11",
    deps = _VALIDATION_DEPS,
)

py_binary(
    name = "package_state_layer",
    srcs = ["package_state_layer.py"],
    main = "package_state_layer.py",
    python_version = "3.11",
    deps = _VALIDATION_DEPS,
)

run_binary(
    name = "checked_runtime_payloads",
    srcs = [
        "//dockers/docker-syncd-vs:config_engine_base_layout",
        "//:target/bazel-inputs/docker-syncd-vs/runtime/manifest.json",
        "//:target/bazel-inputs/docker-syncd-vs/runtime/payload.tar",
    ],
    outs = ["runtime_payloads.checked.tar"],
    args = [
        "--manifest",
        "$(execpath //:target/bazel-inputs/docker-syncd-vs/runtime/manifest.json)",
        "--payload",
        "$(execpath //:target/bazel-inputs/docker-syncd-vs/runtime/payload.tar)",
        "--variant",
        "runtime",
        "--base",
        "$(execpath //dockers/docker-syncd-vs:config_engine_base_layout)",
        "--out-tar",
        "$@",
    ],
    mnemonic = "ValidateSyncdRuntimePayloads",
    tool = ":validate_payloads",
)

run_binary(
    name = "checked_debug_payloads",
    srcs = [
        "//dockers/docker-syncd-vs:docker-syncd-vs",
        "//:target/bazel-inputs/docker-syncd-vs/debug/manifest.json",
        "//:target/bazel-inputs/docker-syncd-vs/debug/payload.tar",
        "//:target/bazel-inputs/docker-syncd-vs/runtime/manifest.json",
    ],
    outs = ["debug_payloads.checked.tar"],
    args = [
        "--manifest",
        "$(execpath //:target/bazel-inputs/docker-syncd-vs/debug/manifest.json)",
        "--payload",
        "$(execpath //:target/bazel-inputs/docker-syncd-vs/debug/payload.tar)",
        "--variant",
        "debug",
        "--runtime-manifest",
        "$(execpath //:target/bazel-inputs/docker-syncd-vs/runtime/manifest.json)",
        "--base",
        "$(execpath //dockers/docker-syncd-vs:docker-syncd-vs)",
        "--out-tar",
        "$@",
    ],
    mnemonic = "ValidateSyncdDebugPayloads",
    tool = ":validate_payloads",
)

run_binary(
    name = "runtime_package_state",
    srcs = [
        "apt.lock.json",
        "runtime_package_state.json",
        "//dockers/docker-syncd-vs:apt_deps",
        "//dockers/docker-syncd-vs:config_engine_base_layout",
        "//dockers/docker-syncd-vs:runtime_apt_selection",
        "//dockers/docker-syncd-vs:runtime_packages",
        "//:target/bazel-inputs/docker-syncd-vs/runtime/manifest.json",
    ],
    outs = ["runtime_package_state.tar"],
    args = [
        "--contract",
        "$(execpath runtime_package_state.json)",
        "--apt-lock",
        "$(execpath apt.lock.json)",
        "--selection",
        "$(execpath //dockers/docker-syncd-vs:runtime_apt_selection)",
        "--base",
        "$(execpath //dockers/docker-syncd-vs:config_engine_base_layout)",
        "--apt-layer",
        "$(execpath //dockers/docker-syncd-vs:apt_deps)",
        "--runtime-layer",
        "$(execpath //dockers/docker-syncd-vs:runtime_packages)",
        "--make-manifest",
        "$(execpath //:target/bazel-inputs/docker-syncd-vs/runtime/manifest.json)",
        "--out",
        "$@",
    ],
    mnemonic = "BuildSyncdPackageState",
    tool = ":package_state_layer",
)

# This test uses only tar fixtures and creates no Debian packages. The native
# preparation tests are intentionally run directly with Python instead.
py_test(
    name = "validate_payloads_test",
    srcs = [
        "tests/validate_payloads_test.py",
        "validate_payloads.py",
    ],
    main = "tests/validate_payloads_test.py",
    python_version = "3.11",
    deps = _TEST_DEPS,
)

py_test(
    name = "validate_image_test",
    srcs = [
        "source_packages.py",
        "tests/validate_image_test.py",
        "validate_image.py",
        "validate_payloads.py",
    ],
    data = [
        "source_packages.json",
        "//dockers/docker-syncd-vs:legacy/critical_processes",
        "//dockers/docker-syncd-vs:legacy/start.sh",
        "//dockers/docker-syncd-vs:legacy/supervisord.conf",
        "//dockers/docker-base-trixie:dpkg_01_drop",
    ],
    main = "tests/validate_image_test.py",
    python_version = "3.11",
    deps = _TEST_DEPS,
)

py_test(
    name = "select_apt_payloads_test",
    srcs = [
        "tests/select_apt_payloads_test.py",
        "validate_payloads.py",
    ],
    args = ["--policy=$(rootpath //dockers/docker-syncd-vs:runtime_layer_policy)"],
    data = [
        "apt.lock.json",
        "apt_inputs.MODULE.bazel",
        "//dockers/docker-syncd-vs:runtime_layer_policy",
    ],
    main = "tests/select_apt_payloads_test.py",
    python_version = "3.11",
    deps = _TEST_DEPS + ["//tools/bazel/oci:apt_selection"],
)

py_test(
    name = "package_state_layer_test",
    srcs = [
        "package_state_layer.py",
        "tests/package_state_layer_test.py",
    ],
    main = "tests/package_state_layer_test.py",
    data = [
        "apt.lock.json",
        "runtime_package_state.json",
        "//dockers/docker-syncd-vs:legacy/Dockerfile.j2",
    ],
    python_version = "3.11",
    deps = _TEST_DEPS,
)

py_test(
    name = "manifest_labels_test",
    size = "small",
    srcs = ["tests/integration/manifest_labels_test.py"],
    args = [
        "--runtime-manifest=$(rootpath //:target/bazel-manifests/docker-syncd-vs/manifest.json)",
        "--debug-manifest=$(rootpath //:target/bazel-manifests/docker-syncd-vs-dbg/manifest.json)",
        "--runtime-labels=$(rootpath //dockers/docker-syncd-vs/config:labels)",
        "--debug-labels=$(rootpath //dockers/docker-syncd-vs/config:debug_labels)",
    ],
    data = [
        "//dockers/docker-syncd-vs/config:debug_labels",
        "//dockers/docker-syncd-vs/config:labels",
        "//:target/bazel-manifests/docker-syncd-vs-dbg/manifest.json",
        "//:target/bazel-manifests/docker-syncd-vs/manifest.json",
    ],
    main = "tests/integration/manifest_labels_test.py",
)
