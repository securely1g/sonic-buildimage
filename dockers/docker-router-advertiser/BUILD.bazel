"""AMD64 router-advertisement images using the source-built config-engine parent."""

load("@radv_apt_inputs//:apt_inputs.bzl", "APT_INPUTS")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("@sonic_build_infra//oci:installed_packages.bzl", "installed_packages")
load("@tar.bzl", "tar")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")

package(default_visibility = ["//visibility:public"])

exports_files([
    "start.sh",
    "docker-init.sh",
    "radvd.conf.j2",
    "wait_for_link.sh.j2",
    "docker-router-advertiser.supervisord.conf.j2",
    "critical_processes",
])

_COMPATIBLE = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
    "@sonic_build_infra//platforms:trixie",
]

# All project runtime files are supplied by the source-built config-engine parent.
apt_layer(
    name = "debian_runtime",
    base = "//dockers/docker-config-engine-trixie:docker-config-engine-trixie",
    dependency_set = "radv_runtime_debian",
    lock = "//dockers/docker-router-advertiser/bazel:apt.lock.json",
    packages = APT_INPUTS["radv_runtime_debian"]["amd64"],
    policy = {
        "schema": 1,
        "image": "docker-router-advertiser",
        "architecture": "amd64",
        "distribution": "trixie",
        "retained_source": "none",
        "features": {},
    },
    variant = "runtime",
)

sonic_layer(
    name = "debian_runtime_filtered",
    tars = [":debian_runtime"],
)

filegroup(
    name = "runtime_apt_selection",
    srcs = [":debian_runtime"],
    output_group = "selection",
)

# Extend inherited state with the locked radvd package control facts.
installed_packages(
    name = "installed_packages",
    apt_receipt = ":runtime_apt_selection",
    architecture = "amd64",
    base = "//dockers/docker-config-engine-trixie:docker-config-engine-trixie",
    controls = [label + ":control" for label in APT_INPUTS["radv_runtime_debian"]["amd64"].values()],
    source_spec = "//dockers/docker-router-advertiser/bazel:source_paths.json",
)

filegroup(
    name = "runtime_package_metadata",
    srcs = [":installed_packages"],
    output_group = "metadata",
)

tar(
    name = "installed_package_state",
    srcs = [
        ":installed_packages",
        ":runtime_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :installed_packages)",
        "usr/share/sonic/bazel/radv-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :runtime_package_metadata)",
    ],
)

oci_image(
    name = "docker-router-advertiser",
    base = "//dockers/docker-config-engine-trixie:docker-config-engine-trixie",
    entrypoint = ["/usr/bin/docker-init.sh"],
    env = "//:target/bazel-manifests/docker-router-advertiser/image.env",
    labels = "//dockers/docker-router-advertiser/config:labels",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":debian_runtime_filtered",
        "//dockers/docker-router-advertiser/config:accounts",
        "//dockers/docker-router-advertiser/config:files",
        ":installed_package_state",
    ],
)

debug_symbols_layer(
    name = "docker-router-advertiser.debug_symbols",
    image = ":docker-router-advertiser",
)

apt_layer(
    name = "debian_debug",
    base = ":docker-router-advertiser",
    dependency_set = "radv_debug_debian",
    lock = "//dockers/docker-router-advertiser/bazel:apt.lock.json",
    packages = APT_INPUTS["radv_debug_debian"]["amd64"],
    policy = {
        "schema": 1,
        "image": "docker-router-advertiser",
        "architecture": "amd64",
        "distribution": "trixie",
        "retained_source": "none",
        "features": {},
    },
    variant = "debug",
)

sonic_layer(
    name = "debug_tools",
    tars = [
        ":debian_debug",
        "@sonic_build_infra//deps/vim:vim_alternatives_pkg",
    ],
)

sonic_layer(
    name = "debug_client",
    tars = ["@sonic_fips//openssh:openssh_client_pkg"],
)

debug_symbols_layer(
    name = "debug_client_symbols",
    image = ":debug_client",
)

filegroup(
    name = "debug_apt_selection",
    srcs = [":debian_debug"],
    output_group = "selection",
)

installed_packages(
    name = "debug_installed_packages",
    apt_receipt = ":debug_apt_selection",
    architecture = "amd64",
    base = ":docker-router-advertiser",
    controls = [label + ":control" for label in APT_INPUTS["radv_debug_debian"]["amd64"].values()],
    owner_metadata = ["@sonic_fips//:runtime_packages.json"],
    source_modules = {"sonic-fips": "@image_source_modules//:sonic-fips.MODULE.bazel"},
    source_spec = "//dockers/docker-router-advertiser/bazel:debug_source_paths.json",
    sources = {"openssh-client": "@sonic_fips//openssh:openssh_client_pkg"},
)

filegroup(
    name = "debug_package_metadata",
    srcs = [":debug_installed_packages"],
    output_group = "metadata",
)

tar(
    name = "debug_package_state",
    srcs = [
        ":debug_installed_packages",
        ":debug_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_installed_packages)",
        "usr/share/sonic/bazel/radv-debug-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_package_metadata)",
    ],
)

oci_image(
    name = "docker-router-advertiser-dbg",
    base = ":docker-router-advertiser",
    labels = "//dockers/docker-router-advertiser/config:debug_labels",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":debug_tools",
        ":docker-router-advertiser.debug_symbols",
        ":debug_client",
        ":debug_client_symbols",
        "//dockers/docker-router-advertiser/config:debug_accounts",
        ":debug_package_state",
    ],
)

[
    sonic_docker_archive(
        name = "docker-router-advertiser" + suffix + ".gz",
        image = ":docker-router-advertiser" + suffix,
    )
    for suffix in [
        "",
        "-dbg",
    ]
]

flatten(
    name = "all_debug_symbols",
    deduplicate = True,
    tars = [
        ":docker-router-advertiser.debug_symbols",
        ":debug_client_symbols",
    ],
)

# Existing eventd test dependency; the private Redis fixture is not installed.
flatten(
    name = "test_redis",
    testonly = True,
    tars = ["@eventd_deps//redis-server"],
)
