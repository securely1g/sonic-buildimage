"""Only image-owned additions are installed; parent metadata remains checked."""
load("@pmon_runtime_pip//:requirements.bzl", child_whl = "whl_requirement")
load("@config_engine_pip//:requirements.bzl", parent_whl = "whl_requirement")
load("@sonic_build_infra//python:runtime_lock.bzl", "checked_python_runtime")
load("@sonic_build_infra//python:wheel_layer.bzl", "wheel_layer")
load("//tools/bazel/image/vs/python:update.bzl", "runtime_lock_update")
package(default_visibility = ["//visibility:public"])
exports_files(["requirements.in", "requirements_lock.txt", "runtime.inputs.json"])
wheel_layer(
    name = 'third_party',
    wheels = [child_whl(name) for name in ['certifi', 'charset-normalizer', 'enum34', 'grpcio-tools', 'guacamole', 'idna', 'libpci', 'psutil', 'python-dateutil', 'requests', 'smbus2', 'thrift', 'urllib3']],
    site_packages = "/usr/local/lib/python3.13/dist-packages",
    headers = "/usr/local/include/python3.13",
)
wheel_layer(
    name = 'parent_third_party',
    wheels = [parent_whl(name) for name in ['grpcio', 'ijson', 'jinja2', 'jsondiff', 'jsonpointer', 'lxml', 'markupsafe', 'natsort', 'netaddr', 'protobuf', 'pyyaml', 'six', 'tabulate']],
    site_packages = "/usr/local/lib/python3.13/dist-packages",
    headers = "/usr/local/include/python3.13",
)
checked_python_runtime(
    name = "runtime",
    plan = "//dockers/docker-platform-monitor/bazel:python_plan",
    requirements = "requirements.in", lock = "requirements_lock.txt", inputs = "runtime.inputs.json",
    sources = ['//tools/bazel/image/vs/python:platform_common_runtime', '@sonic_platform_daemons//:daemons.runtime', '@blkinfo//:blkinfo.runtime'],
    inherited_sources = ['//src/sonic-py-common:sonic-py-common.runtime', '//src/sonic-config-engine:sonic-config-engine.runtime', '//src/sonic-yang-mgmt:sonic-yang-mgmt.runtime', '//src/sonic-yang-models:sonic-yang-models.runtime', '@bitarray//:bitarray.runtime', '@redis_dump_load//:install', '//dockers/docker-platform-monitor/bazel:apt_setuptools', '//dockers/docker-platform-monitor/bazel:apt_cffi', '//dockers/docker-platform-monitor/bazel:apt_pycparser', '//dockers/docker-platform-monitor/bazel:apt_redis'],
    third_party = [":third_party"], inherited_third_party = [":parent_third_party"],
    update_command = 'bazel run //dockers/docker-platform-monitor/bazel/python:update -- --uv "$(command -v uv)"',
)

runtime_lock_update(name = "update", plan = "//dockers/docker-platform-monitor/bazel:python_plan")
