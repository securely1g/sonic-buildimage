"""AMD64 database-service images using the source-built config-engine parent."""

load("@database_apt_inputs//:apt_inputs.bzl", "APT_INPUTS")
load("@database_pip//:requirements.bzl", "whl_requirement")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("@sonic_build_infra//oci:installed_packages.bzl", "installed_packages")
load("@sonic_build_infra//python:wheel_layer.bzl", "wheel_layer")
load("@tar.bzl", "tar")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")

package(default_visibility = ["//visibility:public"])

exports_files([
    "docker-database-init.sh",
    "flush_unused_database",
    "supervisord.conf.j2",
    "critical_processes.j2",
    "database_config.json.j2",
    "database_global.json.j2",
    "multi_database_config.json.j2",
])

_COMPATIBLE = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
    "@sonic_build_infra//platforms:trixie",
]

# Common and sonic-db-cli are already in config-engine. DASH API owns its
# generated APIs and source-built Protobuf runtime; the child consumes both.
sonic_layer(
    name = "source_runtime",
    tars = [
        "@sonic_dash_api//:libdashapi_pkg",
        "@sonic_dash_api//:protobuf_runtime_pkg",
    ],
)

debug_symbols_layer(
    name = "source_debug_symbols",
    image = ":source_runtime",
)

wheel_layer(
    name = "python_runtime",
    headers = "/usr/local/include/python3.13",
    site_packages = "/usr/local/lib/python3.13/dist-packages",
    wheels = [whl_requirement("click")],
)

apt_layer(
    name = "debian_runtime",
    base = "//dockers/docker-config-engine-trixie:docker-config-engine-trixie",
    dependency_set = "database_runtime_debian",
    lock = "//dockers/docker-database/bazel:apt.lock.json",
    packages = APT_INPUTS["database_runtime_debian"]["amd64"],
    policy = {
        "schema": 1,
        "image": "docker-database",
        "architecture": "amd64",
        "distribution": "trixie",
        "retained_source": "none",
        "features": {},
    },
    variant = "runtime",
)

sonic_layer(
    name = "debian_runtime_filtered",
    tars = [":debian_runtime"],
)

filegroup(
    name = "runtime_apt_selection",
    srcs = [":debian_runtime"],
    output_group = "selection",
)

# Preserve inherited state and real imported control facts. The selected DASH
# owner has source TARs, not a dpkg package-identity interface: do not invent one.
installed_packages(
    name = "installed_packages",
    apt_receipt = ":runtime_apt_selection",
    architecture = "amd64",
    base = "//dockers/docker-config-engine-trixie:docker-config-engine-trixie",
    controls = [label + ":control" for label in APT_INPUTS["database_runtime_debian"]["amd64"].values()],
    source_spec = "//dockers/docker-database/bazel:source_paths.json",
)

filegroup(
    name = "runtime_package_metadata",
    srcs = [":installed_packages"],
    output_group = "metadata",
)

tar(
    name = "installed_package_state",
    srcs = [
        ":installed_packages",
        ":runtime_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :installed_packages)",
        "usr/share/sonic/bazel/database-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :runtime_package_metadata)",
    ],
)

oci_image(
    name = "docker-database",
    base = "//dockers/docker-config-engine-trixie:docker-config-engine-trixie",
    entrypoint = ["/usr/local/bin/docker-database-init.sh"],
    env = "//:target/bazel-manifests/docker-database/image.env",
    labels = "//dockers/docker-database/config:labels",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":debian_runtime_filtered",
        ":source_runtime",
        ":python_runtime",
        "//dockers/docker-database/config:files",
        ":installed_package_state",
    ],
)

debug_symbols_layer(
    name = "docker-database.debug_symbols",
    image = ":docker-database",
)

apt_layer(
    name = "debian_debug",
    base = ":docker-database",
    dependency_set = "database_debug_debian",
    lock = "//dockers/docker-database/bazel:apt.lock.json",
    packages = APT_INPUTS["database_debug_debian"]["amd64"],
    policy = {
        "schema": 1,
        "image": "docker-database",
        "architecture": "amd64",
        "distribution": "trixie",
        "retained_source": "none",
        "features": {},
    },
    variant = "debug",
)

sonic_layer(
    name = "debug_tools",
    tars = [
        ":debian_debug",
        "@sonic_build_infra//deps/vim:vim_alternatives_pkg",
    ],
)

sonic_layer(
    name = "debug_client",
    tars = ["@sonic_fips//openssh:openssh_client_pkg"],
)

debug_symbols_layer(
    name = "debug_client_symbols",
    image = ":debug_client",
)

filegroup(
    name = "debug_apt_selection",
    srcs = [":debian_debug"],
    output_group = "selection",
)

installed_packages(
    name = "debug_installed_packages",
    apt_receipt = ":debug_apt_selection",
    architecture = "amd64",
    base = ":docker-database",
    controls = [label + ":control" for label in APT_INPUTS["database_debug_debian"]["amd64"].values()],
    owner_metadata = ["@sonic_fips//:runtime_packages.json"],
    source_modules = {"sonic-fips": "@image_source_modules//:sonic-fips.MODULE.bazel"},
    source_spec = "//dockers/docker-database/bazel:debug_source_paths.json",
    sources = {"openssh-client": "@sonic_fips//openssh:openssh_client_pkg"},
)

filegroup(
    name = "debug_package_metadata",
    srcs = [":debug_installed_packages"],
    output_group = "metadata",
)

tar(
    name = "debug_package_state",
    srcs = [
        ":debug_installed_packages",
        ":debug_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_installed_packages)",
        "usr/share/sonic/bazel/database-debug-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_package_metadata)",
    ],
)

oci_image(
    name = "docker-database-dbg",
    base = ":docker-database",
    labels = "//dockers/docker-database/config:debug_labels",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":debug_tools",
        ":docker-database.debug_symbols",
        ":debug_client",
        ":debug_client_symbols",
        "//dockers/docker-database/config:debug_accounts",
        ":debug_package_state",
    ],
)

[
    sonic_docker_archive(
        name = "docker-database" + suffix + ".gz",
        image = ":docker-database" + suffix,
    )
    for suffix in [
        "",
        "-dbg",
    ]
]

flatten(
    name = "all_debug_symbols",
    deduplicate = True,
    tars = [
        ":docker-database.debug_symbols",
        ":debug_client_symbols",
    ],
)
