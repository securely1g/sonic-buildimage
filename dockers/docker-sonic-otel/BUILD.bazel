"""OTEL images consume the collector owner’s runtime and matching debug TARs."""

load("@otel_apt_inputs//:apt_inputs.bzl", "APT_INPUTS")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@sonic_build_infra//oci:accounts.bzl", "account_layer")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("@sonic_build_infra//oci:installed_packages.bzl", "installed_packages")
load("@tar.bzl", "tar")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:manifest_labels.bzl", "manifest_labels")
load("//tools/bazel/oci:normalize_layer.bzl", "normalize_layer")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")

package(default_visibility = ["//visibility:public"])

_BASE = "//dockers/docker-config-engine-trixie:docker-config-engine-trixie"

_LOCK = "//dockers/docker-sonic-otel/bazel:apt.lock.json"

_COMPATIBLE = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
    "@sonic_build_infra//platforms:trixie",
] + select({
    "@sonic_swss//tools/bazel:asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

_POLICY = {
    "schema": 1,
    "image": "docker-sonic-otel",
    "architecture": "amd64",
    "distribution": "trixie",
    "retained_source": "none",
    "features": {},
}

_FILES = {
    "start.sh": "usr/bin/start.sh",
    "otel.sh": "usr/bin/otel.sh",
    "supervisord.conf": "etc/supervisor/conf.d/supervisord.conf",
    "critical_processes": "etc/supervisor/critical_processes",
}

exports_files(_FILES.keys() + ["Dockerfile.j2"])

tar(
    name = "files",
    srcs = _FILES.keys(),
    mtree = [
        path + " uid=0 gid=0 mode=" + ("0755" if source.endswith(".sh") else "0644") +
        " time=0 type=file content=$(location " + source + ")"
        for source, path in _FILES.items()
    ] + [
        "usr/local/bin/otelcol-contrib uid=0 gid=0 mode=0777 time=0 type=link link=/usr/bin/otelcol-contrib",
    ],
)

# Match the official package's system account without running its maintainer
# scripts. The public rule locks passwd/group directly and preserves inherited
# shadow databases; it rejects actual-parent ID/name collisions.
account_layer(
    name = "accounts",
    architecture = "amd64",
    base = _BASE,
    groups = [{
        "name": "otelcol-contrib",
        "password": "!",
        "gid": 999,
    }],
    users = [{
        "username": "otelcol-contrib",
        "password": "!",
        "uid": 999,
        "gid": 999,
        "home": "/home/otelcol-contrib",
        "shell": "/sbin/nologin",
    }],
)

[
    manifest_labels(
        name = "labels" + suffix,
        out = "manifest" + suffix + ".labels",
        manifest = "//:target/bazel-manifests/docker-sonic-otel" + suffix + "/manifest.json",
    )
    for suffix in [
        "",
        "-dbg",
    ]
]

# Preserve the owner's files and metadata, adapting /lib to the real /usr/lib
# directory of the merged-usr parent. Keep the owner edge for matching symbols.
sonic_layer(
    name = "source_runtime_original_paths",
    tars = ["@otelcol_contrib//:runtime"],
)

normalize_layer(
    name = "source_runtime",
    src = ":source_runtime_original_paths",
    base = _BASE,
    directory_aliases = {"lib": "usr/lib"},
    expected_platform = "linux/amd64",
    root_owned = True,
    tars = ["@otelcol_contrib//:runtime"],
)

filegroup(
    name = "runtime_path_normalization",
    srcs = [":source_runtime"],
    output_group = "normalization",
)

# Retain the Dockerfile's ca-certificates, curl and wget from the same snapshot.
# Existing parent packages are retained when their versions satisfy the request.
apt_layer(
    name = "debian_runtime",
    base = _BASE,
    dependency_set = "otel_debian",
    lock = _LOCK,
    packages = APT_INPUTS["otel_debian"]["amd64"],
    policy = _POLICY,
    variant = "runtime",
)

filegroup(
    name = "runtime_apt_selection",
    srcs = [":debian_runtime"],
    output_group = "selection",
)

sonic_layer(
    name = "debian_runtime_payload",
    tars = [":debian_runtime"],
)

installed_packages(
    name = "installed_packages",
    apt_receipt = ":runtime_apt_selection",
    architecture = "amd64",
    base = _BASE,
    controls = [label + ":control" for label in APT_INPUTS["otel_debian"]["amd64"].values()],
    normalization_receipt = ":runtime_path_normalization",
    owner_metadata = ["@otelcol_contrib//:runtime_packages.json"],
    source_modules = {"otelcol-contrib": "@image_source_modules//:otelcol-contrib.MODULE.bazel"},
    source_spec = "//dockers/docker-sonic-otel/bazel:source_paths.json",
    sources = {"otelcol-contrib": "@otelcol_contrib//distributions/otelcol-contrib:runtime"},
)

filegroup(
    name = "runtime_package_metadata",
    srcs = [":installed_packages"],
    output_group = "metadata",
)

tar(
    name = "installed_package_state",
    srcs = [
        ":installed_packages",
        ":runtime_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :installed_packages)",
        "usr/share/sonic/bazel/otel-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :runtime_package_metadata)",
    ],
)

oci_image(
    name = "docker-sonic-otel",
    base = _BASE,
    entrypoint = ["/usr/local/bin/supervisord"],
    env = "//:target/bazel-manifests/docker-sonic-otel/image.env",
    labels = ":labels",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":debian_runtime_payload",
        ":source_runtime",
        ":files",
        ":accounts",
        ":installed_package_state",
    ],
)

debug_symbols_layer(
    name = "docker-sonic-otel.debug_symbols",
    image = ":docker-sonic-otel",
)

apt_layer(
    name = "debian_debug",
    base = ":docker-sonic-otel",
    dependency_set = "otel_debug_debian",
    lock = _LOCK,
    packages = APT_INPUTS["otel_debug_debian"]["amd64"],
    policy = _POLICY,
    variant = "debug",
)

# Activate full Vim over the source base's vim.tiny hardlink.
tar(
    name = "debug_vim_link",
    mtree = ["usr/bin/vim uid=0 gid=0 mode=0777 time=0 type=link link=/etc/alternatives/vim"],
)

sonic_layer(
    name = "debug_tools",
    tars = [
        ":debian_debug",
        "@sonic_build_infra//deps/vim:vim_alternatives_pkg",
        ":debug_vim_link",
    ],
)

sonic_layer(
    name = "debug_client",
    tars = ["@sonic_fips//openssh:openssh_client_pkg"],
)

debug_symbols_layer(
    name = "debug_client_symbols",
    image = ":debug_client",
)

# Match the selected FIPS OpenSSH owner's ssh-agent group contract.
account_layer(
    name = "debug_accounts",
    architecture = "amd64",
    base = ":docker-sonic-otel",
    groups = [{
        "name": "_ssh",
        "password": "x",
        "gid": 104,
    }],
)

filegroup(
    name = "debug_apt_selection",
    srcs = [":debian_debug"],
    output_group = "selection",
)

installed_packages(
    name = "debug_installed_packages",
    apt_receipt = ":debug_apt_selection",
    architecture = "amd64",
    base = ":docker-sonic-otel",
    controls = [label + ":control" for label in APT_INPUTS["otel_debug_debian"]["amd64"].values()],
    owner_metadata = ["@sonic_fips//:runtime_packages.json"],
    source_modules = {"sonic-fips": "@image_source_modules//:sonic-fips.MODULE.bazel"},
    source_spec = "//dockers/docker-sonic-otel/bazel:debug_source_paths.json",
    sources = {"openssh-client": "@sonic_fips//openssh:openssh_client_pkg"},
)

filegroup(
    name = "debug_package_metadata",
    srcs = [":debug_installed_packages"],
    output_group = "metadata",
)

tar(
    name = "debug_package_state",
    srcs = [
        ":debug_installed_packages",
        ":debug_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_installed_packages)",
        "usr/share/sonic/bazel/otel-debug-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_package_metadata)",
    ],
)

oci_image(
    name = "docker-sonic-otel-dbg",
    base = ":docker-sonic-otel",
    labels = ":labels-dbg",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":debug_tools",
        ":docker-sonic-otel.debug_symbols",
        ":debug_client",
        ":debug_client_symbols",
        ":debug_accounts",
        ":debug_package_state",
    ],
)

[
    sonic_docker_archive(
        name = "docker-sonic-otel" + suffix + ".gz",
        image = ":docker-sonic-otel" + suffix,
    )
    for suffix in [
        "",
        "-dbg",
    ]
]

sonic_layer(
    name = "all_debug_symbols",
    tars = [
        ":docker-sonic-otel.debug_symbols",
        ":debug_client_symbols",
    ],
)

# Private Redis fixture for the original startup and Rust supervisor listener.
flatten(
    name = "test_redis",
    testonly = True,
    tars = ["@otel_test_debian//redis-server"],
)
