"""MACsec image composition; WPA, SWSS and shared libraries retain their source ownership."""

load("@macsec_apt_inputs//:apt_inputs.bzl", "APT_INPUTS")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@sonic_build_infra//oci:accounts.bzl", "account_layer")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("@sonic_build_infra//oci:installed_packages.bzl", "installed_packages")
load("@tar.bzl", "tar")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:manifest_labels.bzl", "manifest_labels")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")

package(default_visibility = ["//visibility:public"])

_BASE = "//dockers/docker-swss-layer-trixie:docker-swss-layer-trixie"

_LOCK = "//dockers/docker-macsec/bazel:apt.lock.json"

_COMPATIBLE = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
    "@sonic_build_infra//platforms:trixie",
] + select({
    "@sonic_swss//tools/bazel:asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

_POLICY = {
    "schema": 1,
    "image": "docker-macsec",
    "architecture": "amd64",
    "distribution": "trixie",
    "retained_source": "none",
    "features": {},
}

_FILES = {
    "supervisord.conf": "etc/supervisor/conf.d/supervisord.conf",
    "critical_processes": "etc/supervisor/critical_processes",
    "etc/wpa_supplicant.conf": "etc/wpa_supplicant.conf",
    "cli/config/plugins/macsec.py": "cli/config/plugins/macsec.py",
    "cli/show/plugins/show_macsec.py": "cli/show/plugins/show_macsec.py",
    "cli/clear/plugins/clear_macsec_counter.py": "cli/clear/plugins/clear_macsec_counter.py",
}

exports_files(_FILES.keys() + ["Dockerfile.j2"])

tar(
    name = "files",
    srcs = _FILES.keys(),
    mtree = [
        path + " uid=0 gid=0 mode=0644 time=0 type=file content=$(location " + source + ")"
        for source, path in _FILES.items()
    ],
)

[
    manifest_labels(
        name = "labels" + suffix,
        out = "manifest" + suffix + ".labels",
        manifest = "//:target/bazel-manifests/docker-macsec" + suffix + "/manifest.json",
    )
    for suffix in [
        "",
        "-dbg",
    ]
]

# macsecmgrd and the selected Common, OpenSSL and native libnl runtime already
# belong to the source-built parent. Only WPA's owner TAR is added here.
sonic_layer(
    name = "source_runtime",
    tars = ["@sonic_wpa_supplicant//:wpasupplicant_pkg"],
)

debug_symbols_layer(
    name = "source_debug_symbols",
    image = ":source_runtime",
)

# The external roots follow WPA's actual DT_NEEDED and declared Debian
# dependencies. Existing parent packages are retained when versions satisfy it.
apt_layer(
    name = "debian_runtime",
    base = _BASE,
    dependency_set = "macsec_debian",
    lock = _LOCK,
    packages = APT_INPUTS["macsec_debian"]["amd64"],
    policy = _POLICY,
    variant = "runtime",
)

filegroup(
    name = "runtime_apt_selection",
    srcs = [":debian_runtime"],
    output_group = "selection",
)

sonic_layer(
    name = "debian_runtime_payload",
    tars = [":debian_runtime"],
)

installed_packages(
    name = "installed_packages",
    apt_receipt = ":runtime_apt_selection",
    architecture = "amd64",
    base = _BASE,
    controls = [label + ":control" for label in APT_INPUTS["macsec_debian"]["amd64"].values()],
    owner_metadata = ["@sonic_wpa_supplicant//:runtime_packages.json"],
    source_modules = {"sonic-wpa-supplicant": "@image_source_modules//:sonic-wpa-supplicant.MODULE.bazel"},
    source_spec = "//dockers/docker-macsec/bazel:source_paths.json",
    sources = {"wpasupplicant": "@sonic_wpa_supplicant//:wpasupplicant_pkg"},
)

filegroup(
    name = "runtime_package_metadata",
    srcs = [":installed_packages"],
    output_group = "metadata",
)

tar(
    name = "installed_package_state",
    srcs = [
        ":installed_packages",
        ":runtime_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :installed_packages)",
        "usr/share/sonic/bazel/macsec-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :runtime_package_metadata)",
    ],
)

oci_image(
    name = "docker-macsec",
    base = _BASE,
    entrypoint = ["/usr/local/bin/supervisord"],
    env = {"DEBIAN_FRONTEND": "noninteractive"},
    labels = ":labels",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":debian_runtime_payload",
        ":source_runtime",
        ":files",
        ":installed_package_state",
    ],
)

debug_symbols_layer(
    name = "docker-macsec.debug_symbols",
    image = ":docker-macsec",
)

apt_layer(
    name = "debian_debug",
    base = ":docker-macsec",
    dependency_set = "macsec_debug_debian",
    lock = _LOCK,
    packages = APT_INPUTS["macsec_debug_debian"]["amd64"],
    policy = _POLICY,
    variant = "debug",
)

# Activate full Vim over the source base's vim.tiny hardlink.
tar(
    name = "debug_vim_link",
    mtree = ["usr/bin/vim uid=0 gid=0 mode=0777 time=0 type=link link=/etc/alternatives/vim"],
)

sonic_layer(
    name = "debug_tools",
    tars = [
        ":debian_debug",
        "@sonic_build_infra//deps/vim:vim_alternatives_pkg",
        ":debug_vim_link",
    ],
)

sonic_layer(
    name = "debug_client",
    tars = ["@sonic_fips//openssh:openssh_client_pkg"],
)

debug_symbols_layer(
    name = "debug_client_symbols",
    image = ":debug_client",
)

# Match the selected FIPS OpenSSH owner's ssh-agent group contract.
account_layer(
    name = "debug_accounts",
    architecture = "amd64",
    base = ":docker-macsec",
    groups = [{
        "name": "_ssh",
        "password": "x",
        "gid": 104,
    }],
)

filegroup(
    name = "debug_apt_selection",
    srcs = [":debian_debug"],
    output_group = "selection",
)

installed_packages(
    name = "debug_installed_packages",
    apt_receipt = ":debug_apt_selection",
    architecture = "amd64",
    base = ":docker-macsec",
    controls = [label + ":control" for label in APT_INPUTS["macsec_debug_debian"]["amd64"].values()],
    owner_metadata = ["@sonic_fips//:runtime_packages.json"],
    source_modules = {"sonic-fips": "@image_source_modules//:sonic-fips.MODULE.bazel"},
    source_spec = "//dockers/docker-macsec/bazel:debug_source_paths.json",
    sources = {"openssh-client": "@sonic_fips//openssh:openssh_client_pkg"},
)

filegroup(
    name = "debug_package_metadata",
    srcs = [":debug_installed_packages"],
    output_group = "metadata",
)

tar(
    name = "debug_package_state",
    srcs = [
        ":debug_installed_packages",
        ":debug_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_installed_packages)",
        "usr/share/sonic/bazel/macsec-debug-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_package_metadata)",
    ],
)

oci_image(
    name = "docker-macsec-dbg",
    base = ":docker-macsec",
    labels = ":labels-dbg",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":debug_tools",
        ":docker-macsec.debug_symbols",
        ":debug_client",
        ":debug_client_symbols",
        ":debug_accounts",
        ":debug_package_state",
    ],
)

[
    sonic_docker_archive(
        name = "docker-macsec" + suffix + ".gz",
        image = ":docker-macsec" + suffix,
    )
    for suffix in [
        "",
        "-dbg",
    ]
]

sonic_layer(
    name = "all_debug_symbols",
    tars = [
        ":docker-macsec.debug_symbols",
        ":debug_client_symbols",
    ],
)

# Private validation service only; this payload never enters the production image.
flatten(
    name = "test_redis",
    testonly = True,
    tars = ["@macsec_test_debian//redis-server"],
)
