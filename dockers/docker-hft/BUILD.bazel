"""High-frequency telemetry service over the source-built SWSS runtime."""

load("@config_engine_pip//:requirements.bzl", "requirement")
load("@orchagent_debug_apt_inputs//:apt_inputs.bzl", DEBUG_APT_INPUTS = "APT_INPUTS")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_python//python:defs.bzl", "py_test")
load("@sonic_build_infra//oci:accounts.bzl", "account_layer")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("@sonic_build_infra//oci:installed_packages.bzl", "installed_packages")
load("@tar.bzl", "tar")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:manifest_labels.bzl", "manifest_labels")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")

package(default_visibility = ["//visibility:public"])

_COMPATIBLE = [
    "@platforms//os:linux",
    "@platforms//cpu:x86_64",
    "@sonic_build_infra//platforms:trixie",
] + select({
    "@sonic_swss//tools/bazel:asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

_FILES = {
    "docker_init.sh": ("usr/bin/docker_init.sh", "0755"),
    "start.sh": ("usr/bin/start.sh", "0755"),
    "countersyncd.sh": ("usr/bin/countersyncd.sh", "0755"),
    "readiness_probe_hook": ("usr/bin/readiness_probe_hook", "0755"),
    "supervisord.conf": ("etc/supervisor/conf.d/supervisord.conf", "0644"),
    "critical_processes": ("etc/supervisor/critical_processes", "0644"),
}

tar(
    name = "service_files",
    srcs = _FILES.keys(),
    mtree = [
        path + " uid=0 gid=0 mode=" + mode + " time=0 type=file content=$(location " + source + ")"
        for source, (path, mode) in _FILES.items()
    ],
)

manifest_labels(
    name = "labels",
    manifest = "//tools/bazel/image/vs/metadata:docker-hft.manifest",
)

manifest_labels(
    name = "labels-dbg",
    manifest = "//tools/bazel/image/vs/metadata:docker-hft-dbg.manifest",
)

# SWSS supplies countersyncd and its runtime libraries. HFT only configures the service.
oci_image(
    name = "docker-hft",
    base = "//dockers/docker-swss-layer-trixie:docker-swss-layer-trixie",
    entrypoint = ["/usr/bin/docker_init.sh"],
    env = "//tools/bazel/image/vs/metadata:docker-hft.environment",
    labels = ":labels",
    target_compatible_with = _COMPATIBLE,
    tars = [":service_files"],
)

debug_symbols_layer(
    name = "docker-hft.debug_symbols",
    image = ":docker-hft",
)

_POLICY = {
    "schema": 1,
    "image": "docker-hft",
    "architecture": "amd64",
    "distribution": "trixie",
    "retained_source": "none",
    "features": {},
}

apt_layer(
    name = "debian_debug",
    base = ":docker-hft",
    dependency_set = "orchagent_debug_subset_debian",
    lock = "//dockers/docker-orchagent/bazel:debug_apt.lock.json",
    packages = DEBUG_APT_INPUTS["sysmgr_debug_debian"]["amd64"],
    policy = _POLICY,
    variant = "debug",
)

# The maintained base now supplies vim as a hardlink to vim.tiny. Match the
# shared debug-image convention when selecting the full Vim package.
tar(
    name = "debug_vim_link",
    mtree = ["usr/bin/vim uid=0 gid=0 mode=0777 time=0 type=link link=/etc/alternatives/vim"],
)

sonic_layer(
    name = "debug_tools",
    tars = [
        ":debian_debug",
        "@sonic_build_infra//deps/vim:vim_alternatives_pkg",
        ":debug_vim_link",
    ],
)

sonic_layer(
    name = "debug_client",
    tars = ["@sonic_fips//openssh:openssh-client.runtime"],
)

debug_symbols_layer(
    name = "debug_client_symbols",
    image = ":debug_client",
)

# Match the selected FIPS OpenSSH owner's ssh-agent group contract.
account_layer(
    name = "debug_accounts",
    architecture = "amd64",
    base = ":docker-hft",
    groups = [{
        "name": "_ssh",
        "password": "x",
        "gid": 104,
    }],
)

filegroup(
    name = "debug_apt_selection",
    srcs = [":debian_debug"],
    output_group = "selection",
)

installed_packages(
    name = "debug_installed_packages",
    apt_receipt = ":debug_apt_selection",
    architecture = "amd64",
    base = ":docker-hft",
    controls = [label + ":control" for label in DEBUG_APT_INPUTS["sysmgr_debug_debian"]["amd64"].values()],
    owner_metadata = ["@sonic_fips//openssh:openssh-client.runtime_metadata"],
    source_modules = {"sonic-fips": "@image_source_modules//:sonic-fips.MODULE.bazel"},
    source_spec = "//dockers/docker-orchagent/bazel:debug_source_paths.json",
    sources = {"openssh-client": "@sonic_fips//openssh:openssh-client.runtime"},
)

filegroup(
    name = "debug_package_metadata",
    srcs = [":debug_installed_packages"],
    output_group = "metadata",
)

tar(
    name = "debug_package_state",
    srcs = [
        ":debug_installed_packages",
        ":debug_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_installed_packages)",
        "usr/share/sonic/bazel/hft-debug-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_package_metadata)",
    ],
)

oci_image(
    name = "docker-hft-dbg",
    base = ":docker-hft",
    labels = ":labels-dbg",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":debug_tools",
        ":docker-hft.debug_symbols",
        ":debug_client",
        ":debug_client_symbols",
        ":debug_accounts",
        ":debug_package_state",
    ],
)

[
    sonic_docker_archive(
        name = "docker-hft" + suffix + ".gz",
        image = ":docker-hft" + suffix,
    )
    for suffix in [
        "",
        "-dbg",
    ]
]

# Used by the installed daemon and readiness tests.
flatten(
    name = "test_redis",
    tars = ["@sysmgr_test_debian//redis-server"],
    testonly = True,
)

py_test(
    name = "upstream_tests",
    size = "small",
    args = [
        "--noconftest",
        "--import-mode=importlib",
        "-p",
        "no:cacheprovider",
        "$(rootpath cli-plugin-tests/test_countersyncd_launcher.py)",
    ],
    data = _FILES.keys() + ["cli-plugin-tests/test_countersyncd_launcher.py"],
    main_module = "pytest",
    python_version = "3.13",
    deps = [requirement("pytest")],
)
