load("@base_apt_inputs//:apt_inputs.bzl", "APT_INPUTS")
load("@config_engine_pip//:requirements.bzl", "whl_requirement")
load("@rules_distroless//distroless:defs.bzl", "cacerts", "group", "passwd")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("@sonic_build_infra//python:wheel_layer.bzl", "wheel_layer")
load("@tar.bzl", "tar")
load("//dockers/docker-base-trixie/bazel:accounts.bzl", "GROUP", "PASSWD")
load("//dockers/docker-base-trixie/bazel:installed_packages.bzl", "installed_packages")
load("//src/sonic-config-engine:template.bzl", "sonic_cfggen_template")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:manifest_labels.bzl", "manifest_labels")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")

package(default_visibility = ["//visibility:public"])

# Package marker so //tools/bazel/dpkg can read the same dpkg configuration the
# Make build installs into this image's /etc/dpkg/dpkg.cfg.d.
#
# etc/rsyslog.conf is the file this image's Dockerfile COPYs to /etc/rsyslog.conf.
# Each container image then edits its own name into it, which we replicate per image.

exports_files([
    "dpkg_01_drop",
    "etc/rsyslog.conf",
])

_ARCH = select({
    "@platforms//cpu:x86_64": "amd64",
    "@platforms//cpu:arm64": "arm64",
})

oci_image(
    name = "debian_base",
    base = "@debian_trixie",
)

# Keep the image-specific roots in the checked lock. The shared rule checks
# package identities, dependencies and collisions against the actual base.
# Each architecture has its own generated policy and reviewed package labels.
[
    apt_layer(
        name = "debian_runtime_" + arch,
        base = ":debian_base",
        dependency_set = "base_debian",
        lock = "//dockers/docker-base-trixie/bazel:apt.lock.json",
        packages = APT_INPUTS["base_debian"][arch],
        policy = {
            "schema": 1,
            "image": "docker-base-trixie",
            "architecture": arch,
            "distribution": "trixie",
            "retained_source": "none",
            "features": {},
        },
        variant = "runtime",
    )
    for arch in [
        "amd64",
        "arm64",
    ]
]

alias(
    name = "debian_runtime",
    actual = select({
        "@platforms//cpu:x86_64": ":debian_runtime_amd64",
        "@platforms//cpu:arm64": ":debian_runtime_arm64",
    }),
)

filegroup(
    name = "debian_runtime_selection",
    srcs = [":debian_runtime"],
    output_group = "selection",
)

sonic_layer(
    name = "debian_runtime_filtered",
    tars = [":debian_runtime"],
)

# Install the wheels through PyPA installer so metadata and console scripts
# follow their wheel declarations, including a direct Python shebang.
wheel_layer(
    name = "python_runtime",
    headers = "/usr/local/include/python3.13",
    site_packages = "/usr/local/lib/python3.13/dist-packages",
    wheels = [whl_requirement(name) for name in [
        "attrs",
        "jinja2",
        "jinjanator",
        "jinjanator-plugins",
        "markupsafe",
        "pluggy",
        "python-dotenv",
        "pyyaml",
        "supervisor",
        "supervisord-dependent-startup",
        "toposort",
        "typing-extensions",
    ]],
)

cacerts(
    name = "certificates",
    package = "@base_debian//ca-certificates:data",
)

[
    sonic_cfggen_template(
        name = "apt_sources_" + arch,
        out = "sources.list." + arch,
        additional_data = {
            "DISTRIBUTION": "trixie",
            "ARCHITECTURE": arch,
            "MIRROR_URLS": "https://deb.debian.org/debian/",
            "MIRROR_SECURITY_URLS": "https://deb.debian.org/debian-security/",
        },
        template = "//files/apt:sources.list.j2",
    )
    for arch in [
        "amd64",
        "arm64",
    ]
]

_CONFIG_FILES = {
    "dpkg_01_drop": "etc/dpkg/dpkg.cfg.d/01_drop",
    "pip.conf": "etc/pip.conf",
    "root/.vimrc": "root/.vimrc",
    "etc/rsyslog.conf": "etc/rsyslog.conf",
    "etc/rsyslog.d/supervisor.conf": "etc/rsyslog.d/supervisor.conf",
    "etc/supervisor/supervisord.conf": "etc/supervisor/supervisord.conf",
}

_APT_CONFIGS = [
    "81norecommends",
    "apt-clean",
    "apt-gzip-indexes",
    "apt-no-languages",
    "apt-timeout-n-retries",
    "no-check-valid-until",
]

# The Dockerfile uses a hard link, not an empty mtree file or a symlink.
# Extract the pinned payload with upstream BSD tar and let the same tool record
# the two names of the inode. No Debian package is built or installed here.
genrule(
    name = "vim_command",
    srcs = ["@base_debian//vim-tiny:data"],
    outs = ["vim-command.tar"],
    cmd = "set -euo pipefail\nexport LC_ALL=C.UTF-8 TZ=UTC\n" +
          'mkdir -p "$(@D)/vim-command/usr/bin"\n' +
          '"$(BSDTAR_BIN)" -xOf "$(execpath @base_debian//vim-tiny:data)" ./usr/bin/vim.tiny > "$(@D)/vim-command/usr/bin/vim.tiny"\n' +
          'chmod 0755 "$(@D)/vim-command/usr/bin/vim.tiny"\n' +
          'ln "$(@D)/vim-command/usr/bin/vim.tiny" "$(@D)/vim-command/usr/bin/vim"\n' +
          'touch -t 197001010000 "$(@D)/vim-command/usr/bin/vim.tiny"\n' +
          '"$(BSDTAR_BIN)" --format=gnutar --uid 0 --gid 0 --uname root --gname root -cf "$@" -C "$(@D)/vim-command" usr/bin/vim.tiny usr/bin/vim',
    toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
    tools = ["@bsd_tar_toolchains//:resolved_toolchain"],
)

[
    tar(
        name = "config_files_" + arch,
        srcs = list(_CONFIG_FILES) + [":apt_sources_" + arch] + ["//files/apt:apt.conf.d/" + name for name in _APT_CONFIGS],
        mtree = [
            "./" + path + " uid=0 gid=0 mode=0755 time=0 type=dir"
            for path in [
                "etc",
                "etc/apt",
                "etc/apt/apt.conf.d",
                "etc/dpkg",
                "etc/dpkg/dpkg.cfg.d",
                "etc/rsyslog.d",
                "etc/supervisor",
                "etc/supervisor/conf.d",
                "root",
                "var",
                "var/log",
                "var/log/supervisor",
                "var/spool",
                "var/spool/rsyslog",
            ]
        ] + [
            "./" + dest + " uid=0 gid=0 mode=0644 time=0 type=file content=$(location " + src + ")"
            for src, dest in _CONFIG_FILES.items()
        ] + [
            "./etc/apt/apt.conf.d/" + name + " uid=0 gid=0 mode=0644 time=0 type=file content=$(location //files/apt:apt.conf.d/" + name + ")"
            for name in _APT_CONFIGS
        ] + [
            "./etc/apt/sources.list uid=0 gid=0 mode=0644 time=0 type=file content=$(location :apt_sources_" + arch + ")",
        ],
    )
    for arch in [
        "amd64",
        "arm64",
    ]
]

alias(
    name = "config_files",
    actual = select({
        "@platforms//cpu:x86_64": ":config_files_amd64",
        "@platforms//cpu:arm64": ":config_files_arm64",
    }),
)

# Reproduce the reviewed system account state without running postinst on the host.
passwd(
    name = "accounts",
    entries = [dict(entry) for entry in PASSWD],
)

group(
    name = "groups",
    entries = GROUP,
)

# Source-owned runtime and development payloads that Make installs in this base.
_SOURCE_TARS = {
    "socat": "@socat//:socat_pkg",
    "iproute2": "@iproute2//:iproute2_pkg",
    "libssl3t64": "@sonic_fips//openssl:libssl3t64_pkg",
    "libssl-dev": "@sonic_fips//openssl:libssl_dev_pkg",
    "openssl": "@sonic_fips//openssl:openssl_pkg",
    "libk5crypto3": "@sonic_fips//krb5:libk5crypto3_pkg",
    "libkrb5support0": "@sonic_fips//krb5:libkrb5support0_pkg",
    "libkrb5-3": "@sonic_fips//krb5:libkrb5_3_pkg",
    "libgssapi-krb5-2": "@sonic_fips//krb5:libgssapi_krb5_2_pkg",
    "symcrypt-openssl": "@sonic_fips//symcrypt:runtime",
}

sonic_layer(
    name = "source_runtime",
    tars = _SOURCE_TARS.values(),
)

installed_packages(
    name = "installed_packages",
    apt_receipt = ":debian_runtime_selection",
    architecture = _ARCH,
    base = ":debian_base",
    controls = select({
        "@platforms//cpu:" + cpu: [label + ":control" for label in APT_INPUTS["base_debian"][arch].values()]
        for cpu, arch in [
            ("x86_64", "amd64"),
            ("arm64", "arm64"),
        ]
    }),
    source_spec = "//dockers/docker-base-trixie/bazel:source_packages.json",
    sources = _SOURCE_TARS,
)

filegroup(
    name = "runtime_package_metadata",
    srcs = [":installed_packages"],
    output_group = "metadata",
)

tar(
    name = "installed_package_state",
    srcs = [
        ":installed_packages",
        ":runtime_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :installed_packages)",
        "usr/share/sonic/bazel/base-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :runtime_package_metadata)",
    ],
)

manifest_labels(
    name = "labels",
    out = "manifest.labels",
    manifest = "//:target/bazel-manifests/docker-base-trixie/manifest.json",
)

oci_image(
    name = "docker-base-trixie",
    base = ":debian_base",
    cmd = [],
    entrypoint = [],
    labels = ":labels",
    tars = [
        ":debian_runtime_filtered",
        ":source_runtime",
        ":python_runtime",
        ":certificates",
        ":vim_command",
        ":config_files",
        ":accounts",
        ":groups",
        ":installed_package_state",
    ],
    workdir = "/",
)

debug_symbols_layer(
    name = "docker-base-trixie.debug_symbols",
    image = ":docker-base-trixie",
)

sonic_docker_archive(
    name = "docker-base-trixie.gz",
    image = ":docker-base-trixie",
)
