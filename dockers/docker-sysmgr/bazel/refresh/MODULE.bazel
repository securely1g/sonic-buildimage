module(name = "sysmgr_image_lock")

bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.13")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = [
        "trixie",
        "trixie-updates",
    ],
    uris = ["https://snapshot.debian.org/archive/debian/20260727T143429Z"],
)
apt.sources_list(
    architectures = ["amd64"],
    components = ["main"],
    suites = ["trixie-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20260726T121236Z"],
)

# Sysmgr keeps Common and Protobuf with their source owners.
# These external roots cover the actual loader and declared Debian dependencies.
apt.install(
    dependency_set = "sysmgr_debian",
    packages = [
        "libdbus-1-3:amd64",
        "libdbus-c++-1-0v5:amd64",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "sysmgr_debian")

# Match the legacy debug tools and the public FIPS OpenSSH client's external
# library closure. The OpenSSH program itself is built by its source owner.
apt.install(
    dependency_set = "sysmgr_debug_debian",
    packages = [
        "gdb:amd64",
        "gdbserver:amd64",
        "libaudit1:amd64",
        "libcap-ng0:amd64",
        "libcbor0.10:amd64",
        "libcrypt1:amd64",
        "libedit2:amd64",
        "libfido2-1:amd64",
        "libpam0g:amd64",
        "libselinux1:amd64",
        "libtinfo6:amd64",
        "libudev1:amd64",
        "libwrap0:amd64",
        "libwtmpdb0:amd64",
        "sshpass:amd64",
        "strace:amd64",
        "vim:amd64",
        "zlib1g:amd64",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "sysmgr_debug_debian")

# Private database and mock D-Bus services; never production image layers.
apt.install(
    dependency_set = "sysmgr_test_debian",
    packages = [
        "dbus-daemon:amd64",
        "redis-server:amd64",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "sysmgr_test_debian")
