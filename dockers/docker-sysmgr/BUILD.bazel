load("@bazel_lib//lib:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_python//python:py_test.bzl", "py_test")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("@tar.bzl", "tar")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:oci_base_layout.bzl", "oci_base_layout")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")

oci_base_layout(
    name = "config_engine_base_layout",
    srcs = [
        "//:config_engine_oci_files",
        "//:target/docker-config-engine-trixie.oci/oci-layout",
    ],
    expected_platform = "linux/amd64",
    marker = "$(execpath //:target/docker-config-engine-trixie.oci/oci-layout)",
    root = "target/docker-config-engine-trixie.oci",
)

write_file(
    name = "config_status_gen",
    out = "config_status",
    content = [
        "# Config files managed by sonic-config-engine",
        "",  # Intentional trailing newline
    ],
)

sonic_layer(
    name = "apt_deps",
    tars = [
        "@trixie//libdbus-1-3",
        "@trixie//libdbus-c++-1-0v5",
    ],
)

# Replicate how Dockerfile.j2 edits the container's name into the rsyslog template.
expand_template(
    name = "rsyslog_conf_gen",
    out = "rsyslog.conf",
    substitutions = {"%syslogtag%": "sysmgr#%syslogtag%"},
    template = "//dockers/docker-base-trixie:etc/rsyslog.conf",
)

tar(
    name = "source_files",
    srcs = [
        "critical_processes",
        "supervisord.conf",
        ":config_status_gen",
        ":rsyslog_conf_gen",
    ],
    mtree = [
        "./etc/rsyslog.conf uid=0 gid=0 mode=0644 time=0 type=file content=$(location :rsyslog_conf_gen)",
        "./etc/supervisor/conf.d/supervisord.conf uid=0 gid=0 mode=0644 time=0 type=file content=$(location :supervisord.conf)",
        "./etc/supervisor/critical_processes uid=0 gid=0 mode=0644 time=0 type=file content=$(location :critical_processes)",
        "./var/sonic uid=0 gid=0 mode=0755 type=dir time=0",
        "./var/sonic/config_status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :config_status_gen)",
    ],
)

sonic_layer(
    name = "rdeps",
    tars = [
        # libswsscommon (and libnl3/libyang3) come from the config-engine base.
        "@sonic_sysmgr//:sysmgr_pkg",
        "@sonic_protobuf//:libprotobuf_pkg",
    ],
    visibility = ["//tools/bazel/ci/sysmgr:__pkg__"],
)

oci_image(
    name = "docker-sysmgr",
    base = ":config_engine_base_layout",
    entrypoint = ["/usr/local/bin/supervisord"],
    env = {
        "DEBIAN_FRONTEND": "noninteractive",
    },
    tars = [
        ":apt_deps",
        ":rdeps",
        ":source_files",
    ],
    visibility = ["//visibility:public"],
)

sonic_docker_archive(
    name = "docker-sysmgr.gz",
    image = ":docker-sysmgr",
)

debug_symbols_layer(
    name = "docker-sysmgr.debug_symbols_raw",
    image = ":docker-sysmgr",
)

# Shared debug-symbol layers already normalize archive ownership.
filegroup(
    name = "docker-sysmgr.debug_symbols",
    srcs = [":docker-sysmgr.debug_symbols_raw"],
    visibility = ["//visibility:public"],
)

py_test(
    name = "debug_symbols_test",
    size = "small",
    srcs = ["debug_symbols_test.py"],
    args = [
        "$(location :docker-sysmgr.debug_symbols)",
        "$(location :source_files)",
    ],
    data = [
        ":docker-sysmgr.debug_symbols",
        ":source_files",
    ],
)

oci_image(
    name = "docker-sysmgr-dbg",
    base = ":docker-sysmgr",
    env = {
        "DEBIAN_FRONTEND": "noninteractive",
    },
    tars = [
        "//tools/bazel:debug_utils_pkg",
        ":docker-sysmgr.debug_symbols",
    ],
    visibility = ["//visibility:public"],
)

sonic_docker_archive(
    name = "docker-sysmgr-dbg.gz",
    image = ":docker-sysmgr-dbg",
)
