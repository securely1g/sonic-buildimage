load("@rules_oci//oci:defs.bzl", "oci_image")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:oci_base_layout.bzl", "oci_base_layout")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")
load("@orchagent_apt_inputs//:apt_inputs.bzl", "APT_INPUTS")


package(default_visibility = ["//visibility:public"])

exports_files(glob([
    "*.j2",
    "*.conf",
    "*.sh",
    "*.py",
]))

# Keep direct Bazel calls within the same boundary as the Make selector.
_COMPATIBLE_WITH = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
] + select({
    "@sonic_swss//tools/bazel:asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Native SWSS payloads follow the APT layer; no Make package handoff is retained.
_APT_POLICY = {
    "schema": 1,
    "image": "docker-orchagent",
    "architecture": "amd64",
    "distribution": "trixie",
    "retained_source": "none",
    "features": {},
}

# Make publishes the config-engine image as OCI files before invoking Bazel.
# Its Python/config-engine utilities and libnl/libyang runtime are retained.
oci_base_layout(
    name = "config_engine_base_layout",
    srcs = [
        "//:config_engine_oci_files",
        "//:target/docker-config-engine-trixie.oci/oci-layout",
    ],
    expected_platform = "linux/amd64",
    marker = "$(execpath //:target/docker-config-engine-trixie.oci/oci-layout)",
    root = "target/docker-config-engine-trixie.oci",
)

# Select checked Debian contents before filtering the final layer. Packages
# already supplied by the config-engine base retain their existing versions.
apt_layer(
    name = "runtime_layer",
    base = ":config_engine_base_layout",
    packages = APT_INPUTS["orchagent_debian"]["amd64"],
    dependency_set = "orchagent_debian",
    lock = "//dockers/docker-orchagent/bazel:apt.lock.json",
    policy = _APT_POLICY,
    variant = "runtime",
)

filegroup(
    name = "runtime_apt_selection",
    srcs = [":runtime_layer"],
    output_group = "selection",
)

sonic_layer(
    name = "apt_deps",
    tars = [":runtime_layer"],
)

sonic_layer(
    name = "rdeps",
    root_owned = True,
    tars = [
        "@sonic_swss//dist:swss_pkg",
        "@sonic_swss_common//:libswsscommon_pkg",
        "@sonic_sairedis//lib:libsairedis_pkg",
        "@sonic_sairedis//meta:libsaimetadata_pkg",
        "@sonic_dash_api//:libdashapi_pkg",
        "@sonic_dash_api//:protobuf_runtime_pkg",
    ],
)

# Check the runtime dependencies' transitive symbols without requiring the
# config-engine base container that Make builds for complete image assembly.
debug_symbols_layer(
    name = "rdeps_debug_symbols",
    image = ":rdeps",
)

oci_image(
    name = "docker-orchagent",
    base = ":config_engine_base_layout",
    entrypoint = ["/usr/bin/docker-init.sh"],
    env = {"DEBIAN_FRONTEND": "noninteractive"},
    labels = "//dockers/docker-orchagent/config:labels",
    target_compatible_with = _COMPATIBLE_WITH,
    tars = [
        ":apt_deps",
        ":rdeps",
        "//dockers/docker-orchagent/config:python_runtime",
        "//dockers/docker-orchagent/config:files",
    ],
)

sonic_docker_archive(
    name = "docker-orchagent.gz",
    image = ":docker-orchagent",
    visibility = ["//visibility:public"],
)

debug_symbols_layer(
    name = "docker-orchagent.debug_symbols",
    image = ":docker-orchagent",
)

# Inspect the completed runtime image when adding debugger tools, including
# its source-built SWSS libraries. Debug additions cannot replace runtime ELF.
apt_layer(
    name = "debug_layer",
    base = ":docker-orchagent",
    base_package_metadata = ":runtime_apt_selection",
    packages = APT_INPUTS["orchagent_debug_debian"]["amd64"],
    dependency_set = "orchagent_debug_debian",
    lock = "//dockers/docker-orchagent/bazel:apt.lock.json",
    policy = _APT_POLICY,
    variant = "debug",
)

filegroup(
    name = "debug_apt_selection",
    srcs = [":debug_layer"],
    output_group = "selection",
)

sonic_layer(
    name = "debug_tools",
    tars = [":debug_layer"],
)

oci_image(
    name = "docker-orchagent-dbg",
    base = ":docker-orchagent",
    labels = "//dockers/docker-orchagent/config:debug_labels",
    target_compatible_with = _COMPATIBLE_WITH,
    tars = [
        ":debug_tools",
        ":docker-orchagent.debug_symbols",
    ],
)

sonic_docker_archive(
    name = "docker-orchagent-dbg.gz",
    image = ":docker-orchagent-dbg",
    visibility = ["//visibility:public"],
)
