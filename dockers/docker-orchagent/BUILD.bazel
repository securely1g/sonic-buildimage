load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@orchagent_apt_inputs//:apt_inputs.bzl", "APT_INPUTS")
load("@rules_distroless//apt:defs.bzl", "apt_install")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("@tar.bzl", "tar")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:apt_install_inputs.bzl", "apt_install_inputs")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:installed_source_metadata.bzl", "installed_source_metadata")
load("//tools/bazel/oci:normalize_layer.bzl", "normalize_layer")
load("//tools/bazel/oci:oci_base_layout.bzl", "oci_base_layout")
load("//tools/bazel/oci:repack_oci.bzl", "repack_oci")
load("//tools/bazel/oci:rootfs_metadata.bzl", "rootfs_metadata")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")
load("//tools/bazel/oci:source_contract.bzl", "source_contract")
load("//tools/bazel/oci:unpack_oci.bzl", "unpack_oci")

package(default_visibility = ["//visibility:public"])

exports_files(glob([
    "*.j2",
    "*.conf",
    "*.sh",
    "*.py",
]))

# Keep direct Bazel calls within the same boundary as the Make selector.
_COMPATIBLE_WITH = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
] + select({
    "@sonic_swss//tools/bazel:asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Native SWSS payloads follow the APT layer; no Make package handoff is retained.
_APT_POLICY = {
    "schema": 1,
    "image": "docker-orchagent",
    "architecture": "amd64",
    "distribution": "trixie",
    "retained_source": "none",
    "features": {},
}

# Expectations for the common OCI validators. Program and Lua inventories stay
# in the source owner's BUILD/install files; this describes how to read them.
_PACKAGE_POLICY = dict(
    _APT_POLICY,
    config_paths = {"usr/bin/docker-init.sh": {
        "kind": "file",
        "mode": 0o755,
    }},
    debug_tools = [
        "gdb",
        "gdbserver",
        "sshpass",
        "strace",
        "vim",
    ],
    image_validation = {
        "entrypoint": ["/usr/bin/docker-init.sh"],
        "command": None,
        "environment": {"DEBIAN_FRONTEND": "noninteractive"},
        "startup_files": {},
        "required_elf_paths": ["usr/bin/orchagent"],
        "debug_alternatives": [],
        "runtime_tag": "docker-orchagent:latest",
        "debug_tag": "docker-orchagent-dbg:latest",
        "package_state": True,
    },
    install_inventory = {
        "architecture": _APT_POLICY["architecture"],
        "declaration_file": "dist/BUILD.bazel",
        "groups": [
            {
                "variable": "CPP_BINARIES",
                "destination": "usr/bin",
                "kind": "elf",
                "mode": 0o755,
            },
            {
                "variable": "LUA_FILES",
                "aliases_variable": "LUA_INSTALL_ALIASES",
                "destination": "usr/share/swss",
                "kind": "file",
                "mode": 0o644,
            },
        ],
        "install_file": "debian/swss.install",
        "generated_programs": ["target/release/countersyncd"],
        "executable_directories": ["usr/bin"],
        "expected_program_count": 30,
    },
    libraries = {
        "protobuf.tar": {
            "architecture": _APT_POLICY["architecture"],
            "runtime_path": "usr/lib/x86_64-linux-gnu/libprotobuf.so.32.0.12",
            "soname_links": {"usr/lib/x86_64-linux-gnu/libprotobuf.so.32": "libprotobuf.so.32.0.12"},
            "exclusive_pattern": "*/libprotobuf.so*",
        },
    },
    native = {
        "required_packages": [],
        "required_sonames": {},
        "gap_packages": [],
        "local_dependency_pattern": "lib(?:sai|swsscommon|MdioIpcClient|pi)",
        "imported_symbol_packages": [],
        "required_imported_symbol_paths": [],
        "require_source": False,
        "require_imported_symbols": False,
    },
    required_debug_paths = [
        "usr/lib/libdashapi.so",
        "usr/lib/python3/dist-packages/dash_api/_utils.so",
        "usr/lib/x86_64-linux-gnu/libprotobuf.so.32.0.12",
    ],
    retained_requirements = [],
)

write_file(
    name = "package_policy",
    out = "package_policy.json",
    content = [json.encode(_PACKAGE_POLICY)],
)

# FIPS builds already select the source-built config-engine image. Consume its
# native OCI graph directly; its Docker export is only an installer artifact.
bool_flag(
    name = "source_config_engine",
    build_setting_default = False,
)

config_setting(
    name = "source_config_engine_enabled",
    flag_values = {":source_config_engine": "true"},
)

alias(
    name = "config_engine_base_layout",
    actual = select({
        ":source_config_engine_enabled": "//dockers/docker-config-engine-trixie:docker-config-engine-trixie",
        "//conditions:default": ":make_config_engine_base_layout",
    }),
)

# Other builds retain the native OCI layout prepared from the Make archive.
oci_base_layout(
    name = "make_config_engine_base_layout",
    srcs = [
        "//:config_engine_oci_files",
        "//:target/docker-config-engine-trixie.oci/oci-layout",
    ],
    expected_platform = "linux/amd64",
    marker = "$(execpath //:target/docker-config-engine-trixie.oci/oci-layout)",
    root = "target/docker-config-engine-trixie.oci",
)

# The source image already exposes its complete root filesystem. For the
# existing multi-layer Make input, upstream umoci applies its OCI whiteouts.
unpack_oci(
    name = "make_config_engine_rootfs",
    execution_environment = "debian:trixie-20260918@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c",
    image = ":make_config_engine_base_layout",
    platform = "linux/amd64",
)

alias(
    name = "config_engine_rootfs",
    actual = select({
        ":source_config_engine_enabled": "//dockers/docker-config-engine-trixie:rootfs",
        "//conditions:default": ":make_config_engine_rootfs",
    }),
)

# Select checked Debian contents before filtering the final layer. Packages
# already supplied by the config-engine base retain their existing versions.
apt_layer(
    name = "runtime_layer",
    base = ":config_engine_base_layout",
    dependency_set = "orchagent_debian",
    lock = "//dockers/docker-orchagent/bazel:apt.lock.json",
    packages = APT_INPUTS["orchagent_debian"]["amd64"],
    policy = _APT_POLICY,
    variant = "runtime",
)

filegroup(
    name = "runtime_apt_selection",
    srcs = [":runtime_layer"],
    output_group = "selection",
)

_SOURCE_PACKAGES = {
    "swss": "@sonic_swss//dist:swss_pkg",
    "libswsscommon": "@sonic_swss_common//dist:libswsscommon_pkg",
    "libsairedis": "@sonic_sairedis//lib:libsairedis_pkg",
    "libsaimetadata": "@sonic_sairedis//meta:libsaimetadata_pkg",
    "libdashapi": "@sonic_dash_api//:libdashapi_pkg",
    "libprotobuf32t64": "@sonic_dash_api//:protobuf_runtime_pkg",
}

# Source identities come from selected module declarations, including SWSS's
# root git_override. The JSON retains only installed-path expectations.
source_contract(
    name = "source_contract",
    architecture = "amd64",
    expectations = "//dockers/docker-orchagent/bazel:source_paths.json",
    mode = "provenance",
    module_sources = {
        "libdashapi": "sonic-dash-api",
        "libprotobuf32t64": "protobuf-legacy",
        "swss": "sonic-swss",
    },
    owner_metadata = [
        "@sonic_swss_common//:runtime_packages.json",
        "@sonic_sairedis//:runtime_packages.json",
    ],
    root_module = "@orchagent_source_modules//:sonic-buildimage.MODULE.bazel",
    source_modules = {
        "sonic-swss-common": "@orchagent_source_modules//:sonic-swss-common.MODULE.bazel",
        "sonic-sairedis": "@orchagent_source_modules//:sonic-sairedis.MODULE.bazel",
        "sonic-dash-api": "@orchagent_source_modules//:sonic-dash-api.MODULE.bazel",
        "protobuf-legacy": "@orchagent_source_modules//:protobuf-legacy.MODULE.bazel",
        "sonic-swss": "@orchagent_source_modules//:sonic-swss.MODULE.bazel",
    },
    sources = _SOURCE_PACKAGES,
)

sonic_layer(
    name = "rdeps",
    root_owned = True,
    tars = _SOURCE_PACKAGES.values(),
)

# Check the runtime dependencies' transitive symbols without requiring the
# config-engine base container that Make builds for complete image assembly.
debug_symbols_layer(
    name = "rdeps_debug_symbols",
    image = ":rdeps",
)

apt_install_inputs(
    name = "runtime_install_inputs",
    packages = {key: label + ":deb" for key, label in APT_INPUTS["orchagent_debian"]["amd64"].items()},
    selection = ":runtime_apt_selection",
)

apt_install(
    name = "configured_debian",
    architecture = "amd64",
    base = ":config_engine_rootfs",
    bwrap = "//tools/bazel/oci:bubblewrap",
    execution_environment = "debian:trixie-20260918@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c",
    packages = [label + ":deb" for label in APT_INPUTS["orchagent_debian"]["amd64"].values()],
    packages_manifest = ":runtime_install_inputs",
    tags = ["manual"],
)

# Linux installs symlinks with mode 0777, even when a producer's TAR records
# mode 000. Record that installed representation before the debug APT roundtrip;
# keep regular-file permissions and source bytes unchanged.
normalize_layer(
    name = "source_runtime_layer",
    src = ":rdeps",
    base = ":configured_debian",
    expected_platform = "linux/amd64",
    root_owned = True,
    tars = _SOURCE_PACKAGES.values(),
)

filegroup(
    name = "installation_receipt",
    srcs = [":configured_debian"],
    output_group = "receipt",
)

installed_source_metadata(
    name = "runtime_package_metadata",
    allow_same_owner_overlays = True,
    architecture = "amd64",
    installation = ":installation_receipt",
    payloads = _SOURCE_PACKAGES,
    rootfs = ":configured_debian",
    runtime_layer = ":source_runtime_layer",
    spec = ":source_contract",
)

filegroup(
    name = "source_apt_preferences",
    srcs = [":runtime_package_metadata"],
    output_group = "apt_preferences",
)

tar(
    name = "source_provenance",
    srcs = [
        ":runtime_package_metadata",
        ":source_apt_preferences",
    ],
    mtree = [
        "etc/apt/preferences.d type=dir mode=0755 uid=0 gid=0 time=0",
        "etc/apt/preferences.d/sonic-source-orchagent type=file mode=0644 uid=0 gid=0 time=0 content=$(location :source_apt_preferences)",
        "usr/share/sonic/bazel type=dir mode=0755 uid=0 gid=0 time=0",
        "usr/share/sonic/bazel/orchagent-packages.json type=file mode=0644 uid=0 gid=0 time=0 content=$(location :runtime_package_metadata)",
    ],
)

flatten(
    name = "complete_filesystem",
    deduplicate = True,
    tars = [
        ":configured_debian",
        ":source_runtime_layer",
        "//dockers/docker-orchagent/config:python_runtime",
        "//dockers/docker-orchagent/config:files",
        ":source_provenance",
    ],
)

rootfs_metadata(
    name = "rootfs",
    src = ":complete_filesystem",
    tars = [
        ":config_engine_rootfs",
        ":rdeps",
    ],
)

repack_oci(
    name = "configured_image",
    base = ":config_engine_base_layout",
    execution_environment = "debian:trixie-20260918@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c",
    platform = "linux/amd64",
    tars = [":rootfs"],
)

oci_image(
    name = "docker-orchagent",
    base = ":configured_image",
    entrypoint = ["/usr/bin/docker-init.sh"],
    env = {"DEBIAN_FRONTEND": "noninteractive"},
    labels = "//dockers/docker-orchagent/config:labels",
    target_compatible_with = _COMPATIBLE_WITH,
)

sonic_docker_archive(
    name = "docker-orchagent.gz",
    image = ":docker-orchagent",
    visibility = ["//visibility:public"],
)

debug_symbols_layer(
    name = "docker-orchagent.debug_symbols",
    image = ":docker-orchagent",
)

# Inspect the completed runtime image when adding debugger tools, including
# its source-built SWSS libraries. Debug additions cannot replace runtime ELF.
apt_layer(
    name = "debug_layer",
    base = ":docker-orchagent",
    base_package_metadata = ":runtime_package_metadata",
    dependency_set = "orchagent_debug_debian",
    lock = "//dockers/docker-orchagent/bazel:apt.lock.json",
    packages = APT_INPUTS["orchagent_debug_debian"]["amd64"],
    policy = _APT_POLICY,
    variant = "debug",
)

filegroup(
    name = "debug_apt_selection",
    srcs = [":debug_layer"],
    output_group = "selection",
)

apt_install_inputs(
    name = "debug_install_inputs",
    packages = {key: label + ":deb" for key, label in APT_INPUTS["orchagent_debug_debian"]["amd64"].items()},
    selection = ":debug_apt_selection",
)

apt_install(
    name = "configured_debug",
    architecture = "amd64",
    base = ":rootfs",
    bwrap = "//tools/bazel/oci:bubblewrap",
    execution_environment = "debian:trixie-20260918@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c",
    packages = [label + ":deb" for label in APT_INPUTS["orchagent_debug_debian"]["amd64"].values()],
    packages_manifest = ":debug_install_inputs",
    tags = ["manual"],
)

filegroup(
    name = "debug_installation_receipt",
    srcs = [":configured_debug"],
    output_group = "receipt",
)

installed_source_metadata(
    name = "debug_package_metadata",
    architecture = "amd64",
    inherited_metadata = ":runtime_package_metadata",
    inherited_metadata_path = "usr/share/sonic/bazel/orchagent-packages.json",
    installation = ":debug_installation_receipt",
    payloads = _SOURCE_PACKAGES,
    rootfs = ":configured_debug",
    spec = ":source_contract",
)

tar(
    name = "debug_provenance",
    srcs = [":debug_package_metadata"],
    mtree = [
        "usr/share/sonic/bazel type=dir mode=0755 uid=0 gid=0 time=0",
        "usr/share/sonic/bazel/orchagent-packages.json type=file mode=0644 uid=0 gid=0 time=0 content=$(location :debug_package_metadata)",
    ],
)

flatten(
    name = "debug_rootfs",
    deduplicate = True,
    tars = [
        ":configured_debug",
        ":debug_provenance",
        ":docker-orchagent.debug_symbols",
    ],
)

repack_oci(
    name = "configured_debug_image",
    base = ":docker-orchagent",
    execution_environment = "debian:trixie-20260918@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c",
    platform = "linux/amd64",
    tars = [":debug_rootfs"],
)

oci_image(
    name = "docker-orchagent-dbg",
    base = ":configured_debug_image",
    entrypoint = ["/usr/bin/docker-init.sh"],
    env = {"DEBIAN_FRONTEND": "noninteractive"},
    labels = "//dockers/docker-orchagent/config:debug_labels",
    target_compatible_with = _COMPATIBLE_WITH,
)

sonic_docker_archive(
    name = "docker-orchagent-dbg.gz",
    image = ":docker-orchagent-dbg",
    visibility = ["//visibility:public"],
)

# CI owns an explicit selection of source and image-contract tests. The package
# check consumes the actual runtime/debug archives as declared Bazel inputs.
test_suite(
    name = "ci_tests",
    tests = [
        "//src/sonic-config-engine:sonic_cfggen_cli_test",
        "//tools/bazel/tests:apt_selection_test",
        "//tools/bazel/tests:common_rust_runtime_test",
        "//tools/bazel/tests:containercfgd_full_test",
        "//tools/bazel/tests:containercfgd_wheel_test",
        "//tools/bazel/tests:manifest_labels_action_test",
        "//tools/bazel/tests:manifest_labels_test",
        "//tools/bazel/tests:oci_apt_overlay_test",
        "//tools/bazel/tests:oci_image_test",
        "//tools/bazel/tests:oci_inventory_test",
        "//tools/bazel/tests:oci_native_packages_test",
        "//tools/bazel/tests:oci_package_contract_test",
        "//tools/bazel/tests:oci_package_payloads_test",
        "//tools/bazel/tests:oci_package_receipts_test",
        "//tools/bazel/tests:select_apt_payloads_test",
        "//tools/bazel/tests:sonic_config_engine_full_test",
        "//tools/bazel/tests:sonic_py_common_full_test",
        "//tools/bazel/tests:sonic_py_common_test",
        "//tools/bazel/tests:sonic_python_wheels_test",
        "//tools/bazel/tests:sonic_yang_mgmt_full_test",
        "//tools/bazel/tests:sonic_yang_mgmt_wheel_test",
        "//tools/bazel/tests:supervisor_python_full_test",
        "//tools/bazel/tests:supervisor_python_wheel_test",
        "//tools/bazel/tests:swss_common_rust_test",
        "//tools/bazel/tests:swss_manifest_labels_test",
        "//tools/bazel/tests:swss_package_contract_test",
        "//tools/bazel/tests:swss_render_test",
        "//tools/bazel/tests:test_dpkg_patterns_up_to_date",
    ],
)

# Keep published artifact names stable while allowing the shared CI runner to
# discover this owner's outputs through an ordinary filegroup.
[
    copy_file(
        name = "ci_" + name.replace("-", "_"),
        src = source,
        out = "ci/" + name + ".tar",
    )
    for name, source in {
        "swss": "@sonic_swss//dist:swss_pkg",
        "protobuf": "@sonic_dash_api//:protobuf_runtime_pkg",
        "rdeps": ":rdeps",
        "config": "//dockers/docker-orchagent/config:files",
        "debug-symbols": ":rdeps_debug_symbols",
    }.items()
]

filegroup(
    name = "ci_artifacts",
    srcs = [
        ":ci_config",
        ":ci_debug_symbols",
        ":ci_protobuf",
        ":ci_rdeps",
        ":ci_swss",
    ],
)
