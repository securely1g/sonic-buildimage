# Intentional refresh roots. In a clean preparation checkout, replace the
# generated full-candidate MODULE include with these ordinary apt.install calls.

apt.install(
    dependency_set = "orchagent_debian",
    packages = [
        "arping",
        "bridge-utils",
        "conntrack",
        # Require the concrete Trixie implementation instead of virtual Provides.
        "ifupdown (>= 0.8.44)",
        "iproute2",
        "iputils-ping",
        "libjansson4",
        "libjemalloc2",
        "libprotobuf-lite32t64",
        "libxml2",
        "libyaml-cpp0.8",
        "ndisc6",
        "ndppd",
        "pciutils",
        "python3-click",
        "python3-netifaces",
        "python3-protobuf",
        "tcpdump",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)

apt.install(
    dependency_set = "orchagent_debug_debian",
    packages = ["gdb", "gdbserver", "libedit2", "libfido2-1", "sshpass", "strace", "vim"],
    suites = ["trixie", "trixie-updates", "trixie-security"],
)
