load("@rules_python//python:defs.bzl", "py_binary", "py_test")

package(default_visibility = ["//dockers/docker-orchagent:__pkg__"])

exports_files(["apt.lock.json", "apt_policy.json"])

_SELECTION_DEPS = [
    "@sonic_build_infra//apt:lib",
    "//tools/bazel/ci:artifact_validation",
    "//tools/bazel/oci:oci_inventory",
    "//tools/bazel/oci:oci_layout",
]

py_binary(
    name = "select_apt_payloads",
    python_version = "3.11",
    srcs = ["select_apt_payloads.py"],
    deps = _SELECTION_DEPS,
)

# These tests inspect tar/OCI fixtures and never produce Debian packages.
py_test(
    name = "select_apt_payloads_test",
    python_version = "3.11",
    srcs = ["select_apt_payloads.py", "tests/select_apt_payloads_test.py"],
    main = "tests/select_apt_payloads_test.py",
    data = ["apt_policy.json"],
    deps = _SELECTION_DEPS + ["//tools/bazel/tests:oci_base_fixture_lib"],
)
