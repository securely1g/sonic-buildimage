load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//dockers/docker-orchagent:__pkg__"])

exports_files(["apt.lock.json", "apt_policy.json", "apt_inputs.MODULE.bazel"])

_SELECTION_DEPS = [
    "@sonic_build_infra//apt:lib",
    "//tools/bazel/ci:artifact_validation",
    "//tools/bazel/oci:oci_inventory",
    "//tools/bazel/oci:oci_layout",
]

py_binary(
    name = "select_apt_payloads",
    srcs = ["select_apt_payloads.py"],
    deps = _SELECTION_DEPS,
)

# Keep the production selector with the image; central tests import this library.
py_library(
    name = "select_apt_payloads_lib",
    srcs = ["select_apt_payloads.py"],
    imports = ["."],
    deps = _SELECTION_DEPS,
    visibility = ["//tools/bazel/tests:__pkg__"],
)
