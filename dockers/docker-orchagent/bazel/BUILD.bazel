load("@aspect_bazel_lib//lib:jq.bzl", "jq")

package(default_visibility = [
    "//dockers/docker-orchagent:__pkg__",
    "//tools/bazel/tests:__pkg__",
])

exports_files([
    "debug_source_paths.json",
    "package_state.json",
])

# The OCI selector validates every member of the supplied dependency set.
# Give it this layer's exact seven debug roots and closure from the shared lock.
jq(
    name = "debug_lock_view",
    srcs = ["@sonic_build_infra//apt:apt.lock.json"],
    args = [
        "--sort-keys",
        "--slurpfile",
        "selection",
        "$(execpath @orchagent_debug_apt_inputs//:apt_manifest.json)",
    ],
    data = ["@orchagent_debug_apt_inputs//:apt_manifest.json"],
    expand_args = True,
    filter_file = "debug_lock.jq",
    out = "debug_apt.lock.json",
)
