"""P4RT images consume the source owner's verified Bazel 6 TAR handoff."""

load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@p4rt_apt_inputs//:apt_inputs.bzl", "APT_INPUTS")
load("@rules_distroless//distroless:defs.bzl", "flatten")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@sonic_build_infra//oci:accounts.bzl", "account_layer")
load("@sonic_build_infra//oci:debug_symbols_layer.bzl", "debug_symbols_layer")
load("@sonic_build_infra//oci:installed_packages.bzl", "installed_packages")
load("@tar.bzl", "tar")
load("//tools/bazel/dpkg:defs.bzl", "sonic_layer")
load("//tools/bazel/oci:apt_layer.bzl", "apt_layer")
load("//tools/bazel/oci:manifest_labels.bzl", "manifest_labels")
load("//tools/bazel/oci:sonic_docker_archive.bzl", "sonic_docker_archive")

package(default_visibility = ["//visibility:public"])

_BASE = "//dockers/docker-config-engine-trixie:docker-config-engine-trixie"

_LOCK = "//dockers/docker-sonic-p4rt/bazel:apt.lock.json"

_COMPATIBLE = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
    "@sonic_build_infra//platforms:trixie",
] + select({
    "@sonic_swss//tools/bazel:asan_enabled": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

_POLICY = {
    "schema": 1,
    "image": "docker-sonic-p4rt",
    "architecture": "amd64",
    "distribution": "trixie",
    "retained_source": "none",
    "features": {},
}

_FILES = {
    "start.sh": ("usr/bin/start.sh", "0755"),
    "p4rt.sh": ("usr/bin/p4rt.sh", "0755"),
    "p4rt_vars.j2": ("usr/share/sonic/templates/p4rt_vars.j2", "0644"),
    "supervisord.conf": ("etc/supervisor/conf.d/supervisord.conf", "0644"),
    "critical_processes": ("etc/supervisor/critical_processes", "0644"),
}

exports_files(_FILES.keys() + ["Dockerfile.j2"])

tar(
    name = "files",
    srcs = _FILES.keys(),
    mtree = [
        path + " uid=0 gid=0 mode=" + mode + " time=0 type=file content=$(location " + source + ")"
        for source, (path, mode) in _FILES.items()
    ],
)

[
    manifest_labels(
        name = "labels" + suffix,
        out = "manifest" + suffix + ".labels",
        manifest = "//:target/bazel-manifests/docker-sonic-p4rt" + suffix + "/manifest.json",
    )
    for suffix in [
        "",
        "-dbg",
    ]
]

filegroup(
    name = "source_runtime",
    srcs = ["@p4rt_owner_payload//:p4rt_runtime.tar"],
)

tar(
    name = "owner_handoff",
    srcs = ["@p4rt_owner_payload//:handoff.json"],
    mtree = ["usr/share/sonic/bazel/p4rt-handoff.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location @p4rt_owner_payload//:handoff.json)"],
)

debug_symbols_layer(
    name = "parent_debug_symbols",
    image = _BASE,
)

flatten(
    name = "source_debug_symbols",
    deduplicate = True,
    tars = [
        ":parent_debug_symbols",
        "@p4rt_owner_payload//:p4rt_runtime_debug.tar",
    ],
)

# The owner has a real WORKSPACE identity, not a Bzlmod MODULE. Each flat
# contract is sealed by that owner to its clean source revision and TAR bytes.
# Keep runtime and DWP package state in separate stages. Every APT receipt is
# evaluated against that stage's exact base; no receipt crosses a base digest.
[
    apt_layer(
        name = stage + "_debian",
        base = base,
        dependency_set = "p4rt_debian",
        lock = _LOCK,
        packages = APT_INPUTS["p4rt_debian"]["amd64"],
        policy = _POLICY,
        variant = variant,
    )
    for stage, base, variant in [
        ("runtime", _BASE, "runtime"),
        ("symbols", ":docker-sonic-p4rt", "debug"),
    ]
]

[
    filegroup(
        name = stage + "_apt_selection",
        srcs = [":" + stage + "_debian"],
        output_group = "selection",
    )
    for stage in [
        "runtime",
        "symbols",
    ]
]

[
    installed_packages(
        name = stage + "_installed_packages",
        apt_receipt = ":" + stage + "_apt_selection",
        architecture = "amd64",
        base = base,
        controls = [label + ":control" for label in APT_INPUTS["p4rt_debian"]["amd64"].values()],
        source_spec = "@p4rt_owner_payload//:" + target + "_contract.json",
        sources = {package_name: "@p4rt_owner_payload//:" + target + ".tar"},
    )
    for stage, base, package_name, target in [
        ("runtime", _BASE, "sonic-p4rt", "p4rt_runtime"),
        ("symbols", ":docker-sonic-p4rt", "sonic-p4rt-dbgsym", "p4rt_runtime_debug"),
    ]
]

[
    filegroup(
        name = stage + "_package_metadata",
        srcs = [":" + stage + "_installed_packages"],
        output_group = "metadata",
    )
    for stage in [
        "runtime",
        "symbols",
    ]
]

[
    tar(
        name = stage + "_package_state",
        srcs = [
            ":" + stage + "_installed_packages",
            ":" + stage + "_package_metadata",
        ],
        mtree = [
            "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :" + stage + "_installed_packages)",
            "usr/share/sonic/bazel/p4rt-" + stage + "-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :" + stage + "_package_metadata)",
        ],
    )
    for stage in [
        "runtime",
        "symbols",
    ]
]

sonic_layer(
    name = "runtime_debian_payload",
    tars = [":runtime_debian"],
)

oci_image(
    name = "docker-sonic-p4rt",
    base = _BASE,
    entrypoint = ["/usr/local/bin/supervisord"],
    env = {"DEBIAN_FRONTEND": "noninteractive"},
    labels = ":labels",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":runtime_debian_payload",
        ":source_runtime",
        ":owner_handoff",
        ":files",
        ":runtime_package_state",
    ],
)

oci_image(
    name = "p4rt_with_symbols",
    base = ":docker-sonic-p4rt",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":symbols_debian",
        ":source_debug_symbols",
        ":symbols_package_state",
    ],
)

apt_layer(
    name = "debug_debian",
    base = ":p4rt_with_symbols",
    dependency_set = "p4rt_debug_debian",
    lock = _LOCK,
    packages = APT_INPUTS["p4rt_debug_debian"]["amd64"],
    policy = _POLICY,
    variant = "debug",
)

tar(
    name = "debug_vim_link",
    mtree = ["usr/bin/vim uid=0 gid=0 mode=0777 time=0 type=link link=/etc/alternatives/vim"],
)

sonic_layer(
    name = "debug_tools",
    tars = [
        ":debug_debian",
        "@sonic_build_infra//deps/vim:vim_alternatives_pkg",
        ":debug_vim_link",
    ],
)

sonic_layer(
    name = "debug_client",
    tars = ["@sonic_fips//openssh:openssh_client_pkg"],
)

debug_symbols_layer(
    name = "debug_client_symbols",
    image = ":debug_client",
)

# Legacy LIBSAIREDIS_DBG pulls its runtime package; the selected source
# implementation also links the owner's metadata libraries. Keep this closure
# in the debug image and consume the existing library-only metadata interface.
flatten(
    name = "debug_sai_runtime",
    tars = [
        "@sonic_sairedis//lib:libsairedis_pkg",
        "@sonic_sairedis//meta:libsaimetadata_pkg",
    ],
)

flatten(
    name = "debug_sai_symbols",
    deduplicate = True,
    tars = [
        "@sonic_sairedis//lib:libsairedis_pkg.debug_symbols",
        "@sonic_sairedis//meta:libsaimetadata_pkg.debug_symbols",
    ],
)

account_layer(
    name = "debug_accounts",
    architecture = "amd64",
    base = ":p4rt_with_symbols",
    groups = [{
        "name": "_ssh",
        "password": "x",
        "gid": 104,
    }],
)

filegroup(
    name = "debug_apt_selection",
    srcs = [":debug_debian"],
    output_group = "selection",
)

installed_packages(
    name = "debug_installed_packages",
    apt_receipt = ":debug_apt_selection",
    architecture = "amd64",
    base = ":p4rt_with_symbols",
    controls = [label + ":control" for label in APT_INPUTS["p4rt_debug_debian"]["amd64"].values()],
    owner_metadata = [
        "@sonic_fips//:runtime_packages.json",
        "@sonic_sairedis//:library_runtime_packages.json",
    ],
    source_modules = {
        "sonic-fips": "@image_source_modules//:sonic-fips.MODULE.bazel",
        "sonic-sairedis": "@image_source_modules//:sonic-sairedis.MODULE.bazel",
    },
    source_spec = "//dockers/docker-sonic-p4rt/bazel:debug_source_paths.json",
    sources = {
        "openssh-client": "@sonic_fips//openssh:openssh_client_pkg",
        "libsairedis": "@sonic_sairedis//lib:libsairedis_pkg",
        "libsaimetadata": "@sonic_sairedis//meta:libsaimetadata_pkg",
    },
)

filegroup(
    name = "debug_package_metadata",
    srcs = [":debug_installed_packages"],
    output_group = "metadata",
)

tar(
    name = "debug_package_state",
    srcs = [
        ":debug_installed_packages",
        ":debug_package_metadata",
    ],
    mtree = [
        "var/lib/dpkg/status uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_installed_packages)",
        "usr/share/sonic/bazel/p4rt-debug-packages.json uid=0 gid=0 mode=0644 time=0 type=file content=$(location :debug_package_metadata)",
    ],
)

oci_image(
    name = "docker-sonic-p4rt-dbg",
    base = ":p4rt_with_symbols",
    labels = ":labels-dbg",
    target_compatible_with = _COMPATIBLE,
    tars = [
        ":debug_tools",
        ":debug_sai_runtime",
        ":debug_sai_symbols",
        ":debug_client",
        ":debug_client_symbols",
        ":debug_accounts",
        ":debug_package_state",
    ],
)

[
    sonic_docker_archive(
        name = "docker-sonic-p4rt" + suffix + ".gz",
        image = ":docker-sonic-p4rt" + suffix,
    )
    for suffix in [
        "",
        "-dbg",
    ]
]

flatten(
    name = "native_debug_symbols",
    tars = [
        ":parent_debug_symbols",
        ":debug_sai_symbols",
        ":debug_client_symbols",
    ],
)

flatten(
    name = "all_debug_symbols",
    tars = [
        ":native_debug_symbols",
        "@p4rt_owner_payload//:p4rt_runtime_debug.tar",
    ],
)

flatten(
    name = "test_services",
    testonly = True,
    tars = ["@p4rt_test_debian//redis-server"],
)

# The selected Common owner supplies the runtime and declared-loader runner.
# P4RT additionally links generic netlink and the image's locked GMP runtime.
flatten(
    name = "owner_test_runtime",
    testonly = True,
    tars = [
        "@sonic_swss_common//tools/bazel/runtime:test_runtime",
        "@libnl3//:libnl-genl-3-runtime_files",
        "@p4rt_debian//libgmp10:data",
        "@p4rt_debian//libgmpxx4ldbl:data",
    ],
)

# Export declared preparation tools as ordinary outputs for the shared CI
# collector. Direct external source labels are relative to Bazel's execroot.
[
    copy_file(
        name = name,
        testonly = True,
        src = source,
        out = output,
    )
    for name, source, output in [
        ("owner_common_module", "@image_source_modules//:sonic-swss-common.MODULE.bazel", "owner-common.MODULE.bazel"),
        ("owner_runtime_runner", "@sonic_swss_common//tools/bazel/runtime:run_with_runtime.py", "owner-run-with-runtime.py"),
        ("owner_patchelf", "@patchelf//:patchelf", "owner-patchelf"),
    ]
]
