# docker image for teamd agent

DOCKER_TEAMD_STEM = docker-teamd
DOCKER_TEAMD = $(DOCKER_TEAMD_STEM).gz
DOCKER_TEAMD_DBG = $(DOCKER_TEAMD_STEM)-$(DBG_IMAGE_MARK).gz

$(DOCKER_TEAMD)_PATH = $(DOCKERS_PATH)/$(DOCKER_TEAMD_STEM)

$(DOCKER_TEAMD)_DEPENDS += $(LIBTEAMDCTL) $(LIBTEAM_UTILS)
$(DOCKER_TEAMD)_DBG_DEPENDS = $($(DOCKER_SWSS_LAYER_TRIXIE)_DBG_DEPENDS)
$(DOCKER_TEAMD)_DBG_DEPENDS += $(LIBTEAMDCTL_DBG) $(LIBTEAM_UTILS_DBG)

$(DOCKER_TEAMD)_DBG_IMAGE_PACKAGES = $($(DOCKER_SWSS_LAYER_TRIXIE)_DBG_IMAGE_PACKAGES)

$(DOCKER_TEAMD)_LOAD_DOCKERS += $(DOCKER_SWSS_LAYER_TRIXIE)

$(DOCKER_TEAMD)_VERSION = 1.0.0
$(DOCKER_TEAMD)_PACKAGE_NAME = teamd
$(DOCKER_TEAMD)_WARM_SHUTDOWN_BEFORE = syncd
$(DOCKER_TEAMD)_WARM_SHUTDOWN_AFTER = swss
$(DOCKER_TEAMD)_FAST_SHUTDOWN_BEFORE = syncd
$(DOCKER_TEAMD)_FAST_SHUTDOWN_AFTER = swss

SONIC_DOCKER_IMAGES += $(DOCKER_TEAMD)
ifeq ($(INCLUDE_TEAMD), y)
SONIC_INSTALL_DOCKER_IMAGES += $(DOCKER_TEAMD)
endif

SONIC_DOCKER_DBG_IMAGES += $(DOCKER_TEAMD_DBG)
ifeq ($(INCLUDE_TEAMD), y)
SONIC_INSTALL_DOCKER_DBG_IMAGES += $(DOCKER_TEAMD_DBG)
endif

$(DOCKER_TEAMD)_CONTAINER_NAME = teamd
$(DOCKER_TEAMD)_RUN_OPT += -t --cap-add=NET_ADMIN
ifeq ($(ENABLE_ASAN), y)
$(DOCKER_TEAMD)_RUN_OPT += --cap-add=SYS_PTRACE
endif
$(DOCKER_TEAMD)_RUN_OPT += -v /etc/sonic:/etc/sonic:ro
$(DOCKER_TEAMD)_RUN_OPT += -v /etc/localtime:/etc/localtime:ro 

$(DOCKER_TEAMD)_BASE_IMAGE_FILES += teamdctl:/usr/bin/teamdctl

SONIC_TRIXIE_DOCKERS += $(DOCKER_TEAMD)
SONIC_TRIXIE_DBG_DOCKERS += $(DOCKER_TEAMD_DBG)

# Native source OCI images share the exact SWSS parent and libteam owner TARs.
# Preserve the legacy declarations above for all excluded build profiles.
ifeq ($(BLDENV),trixie)
SONIC_BAZEL_SWITCHABLE_IMAGES += $(DOCKER_TEAMD) $(DOCKER_TEAMD_DBG)
ifeq ($(BUILD_WITH_BAZEL_WHEN_AVAILABLE):$(CONFIGURED_PLATFORM):$(CONFIGURED_ARCH):$(INCLUDE_FIPS):$(DBG_IMAGE_MARK),y:vs:amd64:y:dbg)
ifeq ($(filter y,$(CROSS_BUILD_ENVIRON) $(MULTIARCH_QEMU_ENVIRON) $(ENABLE_ASAN)),)
SONIC_BAZEL_DOCKER_IMAGES += $(DOCKER_TEAMD)
SONIC_BAZEL_DBG_DOCKER_IMAGES += $(DOCKER_TEAMD_DBG)
$(DOCKER_TEAMD_DBG)_PATH = $($(DOCKER_TEAMD)_PATH)
$(DOCKER_TEAMD)_BAZEL_TARGET = //dockers/docker-teamd:$(DOCKER_TEAMD)
$(DOCKER_TEAMD_DBG)_BAZEL_TARGET = //dockers/docker-teamd:$(DOCKER_TEAMD_DBG)
$(DOCKER_TEAMD)_BAZEL_ARGS = --//dockers/docker-teamd:image_version=$(SONIC_IMAGE_VERSION)
$(DOCKER_TEAMD_DBG)_BAZEL_ARGS = $($(DOCKER_TEAMD)_BAZEL_ARGS)
SONIC_BAZEL_MANIFESTS += docker-teamd docker-teamd-$(DBG_IMAGE_MARK)
docker-teamd_MANIFEST_IMAGE = $(DOCKER_TEAMD)
docker-teamd-$(DBG_IMAGE_MARK)_MANIFEST_IMAGE = $(DOCKER_TEAMD)
docker-teamd-$(DBG_IMAGE_MARK)_MANIFEST_SUFFIX = $(DBG_IMAGE_MARK)
$(DOCKER_TEAMD)_BAZEL_DEPENDS = $(TARGET_PATH)/bazel-manifests/docker-base-trixie/manifest.json \
    $(TARGET_PATH)/bazel-manifests/docker-config-engine-trixie/manifest.json \
    $(TARGET_PATH)/bazel-manifests/docker-swss-layer-trixie/manifest.json \
    $(TARGET_PATH)/bazel-manifests/docker-teamd/manifest.json
$(DOCKER_TEAMD_DBG)_BAZEL_DEPENDS = $($(DOCKER_TEAMD)_BAZEL_DEPENDS) $(TARGET_PATH)/bazel-manifests/docker-teamd-$(DBG_IMAGE_MARK)/manifest.json
endif
endif
endif
