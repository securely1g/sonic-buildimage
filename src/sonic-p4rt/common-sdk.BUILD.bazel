# Template for tools/bazel/p4rt_common_sdk.py. This repository contains binaries
# and headers built by Common's Bazel 8.5.1 build, never Common source files.
package(default_visibility = ["//visibility:public"])

# The standalone legacy SDK keeps its original slave dependency contract.
# Image preparation selects declared libnl and libyang inputs matching its parent.
_DECLARED_LIBNL = False
_DECLARED_LIBYANG = False

_LIBNL_STEMS = [
    "libnl-genl-3",
    "libnl-nf-3",
    "libnl-route-3",
    "libnl-3",
]

[
    cc_import(
        name = stem,
        # The pinned owner also links these names with -l<name>.
        shared_library = "lib/" + stem + ".so",
    )
    for stem in _LIBNL_STEMS
    if _DECLARED_LIBNL
]

cc_library(
    name = "libnl",
    hdrs = glob(["include/libnl3/**/*.h"]),
    includes = ["include/libnl3"] if _DECLARED_LIBNL else [],
    linkopts = [] if _DECLARED_LIBNL else ["-l" + stem[3:] for stem in _LIBNL_STEMS],
    deps = [":" + stem for stem in _LIBNL_STEMS] if _DECLARED_LIBNL else [],
)

[
    cc_import(
        name = "libyang",
        shared_library = "lib/libyang.so.3",
    )
    for _ in [True] if _DECLARED_LIBYANG
]

cc_library(
    name = "swsscommon_library",
    srcs = ["lib/libswsscommon.so.0"],
    deps = [":libnl"] + ([":libyang"] if _DECLARED_LIBYANG else []),
)

cc_library(
    name = "common",
    hdrs = glob([
        "include/swss/**/*.h",
        "include/swss/**/*.hpp",
    ]),
    includes = [
        "include",
        "include/swss",
    ],
    linkopts = [
        "-lpthread",
        "-lhiredis",
        "-lzmq",
        "-lboost_serialization",
        "-luuid",
    ] + ([] if _DECLARED_LIBYANG else ["-lyang"]),
    deps = [":swsscommon_library"],
)

# Preserve both entry points used by the pinned sonic-pins checkout.
alias(
    name = "libswsscommon",
    actual = ":common",
)
