    name = "runtime_package_metadata",
    target_compatible_with = select({":bookworm": ["@platforms//:incompatible"], "//conditions:default": []}),
    control = "@frr_source//:debian/control",
    changelog = ":package_changelog",
    debian_files = {"compat": "@frr_source//:debian/compat"},
    module_name = "sonic-buildimage",
    packages = {"frr": ":frr_layout", "frr-pythontools": ":pythontools_layout"},
    dependencies = ["@libyang//:runtime_packages.json", "//src/libraries/sonic-fib:runtime_packages.json"],
    apt_packages = {
        "@frr_deps//" + package + ":data": "@frr_deps//" + package + ":control"
        for package in [
            "libcares2", "libcap2", "libcrypt1", "libjson-c5", "libpam0g",
            "libpcre2-posix3", "libreadline8t64", "libgoogle-perftools4t64",
            "libunwind8", "libsnmp40t64",
        ]
    },
    required_paths = {"frr": ["usr/lib/frr/bgpd", "usr/lib/frr/zebra"], "frr-pythontools": ["usr/lib/frr/frr-reload.py"]},
)

runtime_packages(
    name = "snmp_package_metadata",
    target_compatible_with = select({":bookworm": ["@platforms//:incompatible"], "//conditions:default": []}),
    control = "@frr_source//:debian/control",
    changelog = ":package_changelog",
    debian_files = {"compat": "@frr_source//:debian/compat"},
    module_name = "sonic-buildimage",
