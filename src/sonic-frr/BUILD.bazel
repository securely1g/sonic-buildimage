[
    expand_template(
        name = name + "_configured",
        template = "@frr_source//:tools/" + name + ".in",
        out = "resources/" + name,
        substitutions = {"@" + key + "@": value for key, value in _SUBSTITUTIONS.items()},
    )
    for name in ["frrcommon.sh", "frrinit.sh", "watchfrr.sh", "frr.service", "frr@.service"]
]

[
    expand_template(
        name = path.rsplit("/", 1)[1] + "_configured",
        template = "@frr_source//:" + path,
        out = "resources/" + path.rsplit("/", 1)[1],
        substitutions = {"#!/usr/bin/env python3": "#!/usr/bin/python3"},
    )
    for path in ["tools/frr-reload.py", "tools/generate_support_bundle.py", "tools/frr_babeltrace.py", "ospfclient/ospfclient.py"]
]

pkg_files(
    name = "configuration_files",
    srcs = ["@frr_source//:" + path for path in [
        "tools/etc/frr/daemons",
        "tools/etc/frr/frr.conf",
        "tools/etc/frr/support_bundle_commands.conf",
        "tools/etc/frr/vtysh.conf",
        "tools/etc/iproute2/rt_protos.d/frr.conf",
        "tools/etc/logrotate.d/frr",
        "tools/etc/rsyslog.d/45-frr.conf",
    ]],
    strip_prefix = strip_prefix.from_root("tools"),
)

pkg_files(
    name = "service_data",
    srcs = [
        "@frr_source//:debian/frr.pam",
        "@frr_source//:debian/frr.conf",
