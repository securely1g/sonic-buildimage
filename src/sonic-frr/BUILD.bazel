    "DFLT_NAME": "traditional",
    "GRPC_TRUE": "#",
    "PACKAGE_BUGREPORT": "https://github.com/frrouting/frr/issues",
    "PACKAGE_NAME": "frr",
    "PACKAGE_STRING": "frr 10.5.4",
    "PACKAGE_TARNAME": "frr",
    "PACKAGE_URL": "https://frrouting.org/",
    "PACKAGE_VERSION": "10.5.4",
    "SCRIPTING_TRUE": "#",
    "TIMEOUT_MIN": "2",
    "ZEROMQ_TRUE": "#",
    "e_bindir": "/usr/bin",
    "e_frr_libstatedir": "/var/lib/frr",
    "e_frr_runstatedir": "/var/run/frr",
    "e_frr_sysconfdir": "/etc/frr",
    "e_sbindir": "/usr/lib/frr",
    "e_scriptdir": "/etc/frr/scripts",
    "e_vtysh_bin": "/usr/bin/vtysh",
