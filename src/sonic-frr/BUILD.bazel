# The epoch is the date of the fixed source's first debian/changelog stanza.
_DOCUMENTATION_EPOCH = "1776672000"
# FRR's upstream conf.py accepts the declared version; all docs stay in place.
[
    run_binary(
        name = "documentation_" + builder,
        tool = "@sonic_build_infra//tools/build_tools:sphinx",
        srcs = ["@frr_source//:documentation_sources", "@frr_source//:doc/" + source + "/conf.py"],
        out_dirs = ["documentation/" + builder],
        args = [
            "--builder", builder,
            "--source-config", "$(execpath @frr_source//:doc/" + source + "/conf.py)",
            "--output", "$(RULEDIR)/documentation/" + builder,
        ],
        env = {
            "SOURCE_DATE_EPOCH": _DOCUMENTATION_EPOCH,
            "TZ": "UTC",
            "FRR_DOCUMENTATION_VERSION": _SUBSTITUTIONS["PACKAGE_VERSION"],
        },
    )
    for builder, source in [("man", "manpages"), ("html", "user"), ("texinfo", "user")]
]

run_binary(
    name = "documentation_info",
    tool = "@sonic_build_infra//tools/build_tools:makeinfo",
    srcs = [":documentation_texinfo"],
    outs = ["documentation/info/frr.info"],
    args = ["--no-split", "-o", "$(execpath :documentation/info/frr.info)", "$(execpath :documentation_texinfo)/frr.texi"],
    env = {"SOURCE_DATE_EPOCH": _DOCUMENTATION_EPOCH, "TZ": "UTC"},
)

filegroup(
    name = "documentation",
    srcs = [":documentation_" + kind for kind in ["man", "html", "texinfo", "info"]],
)

# Exact install outputs of upstream doc/manpages/conf.py:man_pages.
_MANPAGES = [('frr-bfdd', 8), ('frr-bgpd', 8), ('frr-eigrpd', 8), ('frr-fabricd', 8), ('frr-isisd', 8), ('frr-ldpd', 8), ('frr-nhrpd', 8), ('frr-ospf6d', 8), ('frr-ospfclient', 8), ('frr-ospfd', 8), ('frr-pbrd', 8), ('frr-pimd', 8), ('frr-ripd', 8), ('frr-ripngd', 8), ('frr-sharpd', 8), ('frr-staticd', 8), ('frr-vrrpd', 8), ('frr-watchfrr', 8), ('frr-zebra', 8), ('frr', 1), ('mtracebis', 8), ('vtysh', 1)]
[
    genrule(
        name = "manual_" + name,
        srcs = [":documentation_man"],
        tools = ["@sonic_build_infra//tools/gzip:reproducible_gzip"],
        outs = ["manpages/man" + str(section) + "/" + name + "." + str(section) + ".gz"],
        cmd = "$(location @sonic_build_infra//tools/gzip:reproducible_gzip) -9 -c $(location :documentation_man)/" + name + "." + str(section) + " > $@",
    )
    for name, section in _MANPAGES
]

filegroup(
    name = "compressed_manpages",
    srcs = [":manual_" + name for name, _section in _MANPAGES],
)

pkg_files(
    name = "manual_files",
    srcs = [":compressed_manpages"],
    prefix = "usr/share/man",
    strip_prefix = strip_prefix.from_pkg("manpages"),
)

pkg_tar(
    name = "resources",
    srcs = [
        ":configuration_files", ":service_data", ":service_programs", ":sysv_init",
        ":yang_model_files", ":runtime_directories", ":frr_copyright_changelog",
        ":readme_and_emacs", ":manual_files",
    ],
    mtime = 0,
    portable_mtime = False,
)

pkg_files(
