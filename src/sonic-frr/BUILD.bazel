py_binary(name = "test_generation", srcs = ["test_generation.py"])
# Release metadata is bound to the fixed 10.5.4 source's first Debian stanza.
expand_template(
    name = "package_changelog",
    template = "@frr_source//:debian/changelog",
    out = "metadata/changelog.Debian",
    substitutions = {
        "frr (10.5.4-0) unstable; urgency=medium": "frr (10.5.4-sonic-0) UNRELEASED; urgency=medium\n\n  * Build the SONiC-patched FRRouting sources.\n\n -- SONiC <sonicproject@googlegroups.com>  Mon, 20 Apr 2026 02:00:00 -0600\n\nfrr (10.5.4-0) unstable; urgency=medium",
    },
)

gzip_compress(
    name = "package_changelog_gzip",
    src = ":package_changelog",
    level = 9,
)

alias(name = "metadata/changelog.Debian.gz", actual = ":package_changelog_gzip")

