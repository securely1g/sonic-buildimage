genrule(
    name = "lib/command_lex",
    srcs = ["lib/command_lex.l"],
    outs = ["lib/command_lex.c", "lib/command_lex.h"],
    tools = ["@sonic_build_infra//tools/build_tools:flex"],
    cmd = "execroot=\"$$PWD\"; root=\"$(RULEDIR)\"; relative=\"$(location lib/command_lex.l)\"; IFS=/ read -ra parts <<< \"$$root\"; for part in \"$${parts[@]}\"; do relative=\"../$$relative\"; done; cd \"$$root\"; exec \"$$execroot/$(location @sonic_build_infra//tools/build_tools:flex)\" '--outfile=lib/command_lex.c' '--header-file=lib/command_lex.h' \"$$relative\"",
)

