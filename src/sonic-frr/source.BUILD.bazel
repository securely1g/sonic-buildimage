# Preserve the upstream source, include and lib search roots ahead of system
# headers, including FRR's Linux API headers and memory.h. These are native
# virtual includes that reference the original files.
[
    cc_library(
        name = "source_headers_" + name,
        hdrs = glob(["**/*.h"] if directory == "." else [directory + "/**/*.h"]),
        strip_include_prefix = directory,
        features = ["-external_include_paths"],
        visibility = ["//visibility:private"],
    )
    for name, directory in [("root", "."), ("include", "include"), ("lib", "lib")]
]

_SOURCE_HEADER_DEPS = [":source_headers_root", ":source_headers_include", ":source_headers_lib"]

# Upstream assert.h must precede the system header; the native virtual include
# exposes that logical name without copying the source header tree.
cc_library(
    name = "assert_headers",
    hdrs = ["lib/assert/assert.h"],
    strip_include_prefix = "lib/assert",
    features = ["-external_include_paths"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "headers",
    deps = ["@sonic-buildimage//src/sonic-frr:configuration", ":system_headers", ":assert_headers"] + _SOURCE_HEADER_DEPS,
    includes = [".", "include", "lib"],
    defines = ["HAVE_CONFIG_H", "_GNU_SOURCE", "CONFDATE=0"],
)

