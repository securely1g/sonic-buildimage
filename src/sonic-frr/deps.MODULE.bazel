# Keep package indexes separate: the upstream resolver keys by name/version,
# so equal-version packages from different Debian suites must retain identity.
apt_bookworm = use_extension("@sonic_build_infra//toolchains/bookworm:apt.bzl", "apt")
apt_bookworm.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main"],
    suites = ["bookworm", "bookworm-updates"],
    uris = ["https://snapshot.debian.org/archive/debian/20260727T143429Z"],
)
apt_bookworm.sources_list(
    architectures = ["amd64", "arm64"],
    components = ["main"],
    suites = ["bookworm-security"],
    uris = ["https://snapshot.debian.org/archive/debian-security/20260726T121236Z"],
)
apt_bookworm.install(
    dependency_set = "frr_bookworm_deps",
    packages = [
        "libc-ares-dev", "libcap-dev", "libjson-c-dev", "libpam0g-dev",
        "libpcre2-dev", "libreadline-dev", "libgoogle-perftools-dev",
        "libunwind-dev", "libelf-dev", "libcrypt-dev", "libcunit1-dev",
    ],
    suites = ["bookworm", "bookworm-updates", "bookworm-security"],
)
use_repo(apt_bookworm, "frr_bookworm_deps")
