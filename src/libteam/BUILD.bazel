load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@sonic_build_infra//oci:runtime_packages.bzl", "runtime_packages")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@sonic_build_infra//cc:runtime_test.bzl", "native_runtime_test")

package(default_visibility = ["//visibility:public"])
exports_files(["libteam.BUILD.bazel", "config.h.in"] + glob(["patch/*"]))
[
    alias(name = name, actual = "@libteam_source//:" + name)
    for name in [
        "libteam", "libteam_shared", "libteamdctl", "libteamdctl_shared",
        "teamd", "teamnl", "teamdctl", "team_manual_control", "team_monitor",
        "libteam_runtime", "libteam_runtime.debug_symbols",
        "libteamdctl_runtime", "libteamdctl_runtime.debug_symbols",
        "libteam_utils_runtime", "libteam_utils_runtime.debug_symbols",
        "libteam_dev",
    ]
]

cc_binary(
    name = "consumer_binary",
    srcs = ["consumer_test.c"],
    deps = [":libteam", ":libteamdctl"],
)

native_runtime_test(
    name = "consumer_test",
    binary = ":consumer_binary",
    runtime_payloads = [
        "@sysroot//libc6:data",
        "@libteam_deps//:packages",
        ":libteam_runtime",
        ":libteamdctl_runtime",
    ] + ["@libnl3//:" + name + "-runtime_files" for name in ["libnl-3", "libnl-genl-3", "libnl-route-3", "libnl-cli-3", "libnl-nf-3"]],
)

# dh/dpkg-gencontrol leaves misc:Recommends empty: this recipe has no helper
# that supplies recommendations. Keep the existing control template intact.
write_file(
    name = "runtime_substvars",
    out = "libteam.substvars",
    content = ["misc:Recommends=", ""],
    visibility = ["//visibility:private"],
)

runtime_packages(
    name = "runtime_packages.json",
    control = "@libteam_debian//:debian/control",
    changelog = "@libteam_debian//:debian/changelog",
    module_name = "sonic-buildimage",
    substvars = {package: ":runtime_substvars" for package in ["libteam5", "libteamdctl0", "libteam-utils"]},
    symbols = {"libteam5": "@libteam_debian//:debian/libteam5.symbols", "libteamdctl0": "@libteam_debian//:debian/libteamdctl0.symbols"},
    packages = {"libteam5": ":libteam_runtime", "libteamdctl0": ":libteamdctl_runtime", "libteam-utils": ":libteam_utils_runtime"},
    dependencies = ["@libnl3//:runtime_packages.json"],
    apt_packages = {
        "@libteam_deps//" + package + ":data": "@libteam_deps//" + package + ":control"
        for package in ['libbsd0', 'libcap2', 'libcom-err2', 'libdaemon0', 'libdbus-1-3', 'libgssapi-krb5-2', 'libjansson4', 'libk5crypto3', 'libkeyutils1', 'libkrb5-3', 'libkrb5support0', 'libmd0', 'libnorm1t64', 'libpgm-5.3-0t64', 'libsodium23', 'libssl3t64', 'libsystemd0', 'libzmq5', 'libzstd1', 'openssl-provider-legacy', 'zlib1g']
    },
    required_paths = {"libteam5": ["usr/lib/{multiarch}/libteam.so.5"], "libteamdctl0": ["usr/lib/{multiarch}/libteamdctl.so.0"], "libteam-utils": ["usr/bin/teamd", "usr/bin/teamnl", "usr/bin/teamdctl"]},
)
