module(
    name = "libteam",
    # Debian source identity 1.31-1 built from this in-tree overlay; the root
    # sonic-buildimage module selects it with local_path_override.
    version = "1.31.sonic-buildimage",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "aspect_bazel_lib", version = "2.14.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.13")
bazel_dep(name = "rules_gzip", version = "1.0.0")
bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")
bazel_dep(name = "libnl3", version = "3.7.0.sonic.6")
bazel_dep(
    name = "sonic-build-infra",
    version = "0.0.25-17a1e555291c64be1a6ff008f33352bffc4f8e5c",
    repo_name = "sonic_build_infra",
)

# Standalone builds from src/libteam select the shared Trixie toolchains. These
# are dev dependencies: the sonic-buildimage root registers its own.
gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc", dev_dependency = True)
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all", dev_dependency = True)

tar_toolchains = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains", dev_dependency = True)
use_repo(tar_toolchains, "bsd_tar_toolchains")

register_toolchains("@bsd_tar_toolchains//:all", dev_dependency = True)

# Debian 1.31-1 source identity and SONiC's ordered StGit patch series.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "libteam_source",
    urls = ["https://deb.debian.org/debian/pool/main/libt/libteam/libteam_1.31.orig.tar.xz"],
    sha256 = "a39c636a71c30c631a9dcf1f175597dabb19594e4fb4a3129eb5a58d1701d486",
    strip_prefix = "libteam-1.31",
    build_file = "//:libteam.BUILD.bazel",
    patch_args = ["-p1"],
    patches = [
        "//:patch/0001-libteam-Temporarily-remove-redundant-debug-messages.patch",
        "//:patch/0002-teamd-lacp-runner-will-send-lacp-update-right-after-.patch",
        "//:patch/0003-libteam-Add-fallback-support-for-single-member-port-.patch",
        "//:patch/0005-Increase-default-buffer-size-from-98304-to-2097152.patch",
        "//:patch/0006-teamd-Administratively-shutdown-port-channel-has-mem.patch",
        "//:patch/0008-libteam-Add-warm_reboot-mode.patch",
        "//:patch/0011-Remove-extensive-debug-output.patch",
        "//:patch/0012-Increase-min_ports-upper-limit-to-1024.patch",
        "//:patch/0013-set-port-to-disabled-state-during-removal.patch",
        "//:patch/0014-dont-move-the-port-state-from-disabled-when-admin-state-is-down.patch",
        "//:patch/0015-add-support-for-custom-retry.patch",
        "//:patch/0016-block-retry-count-changes.patch",
        "//:patch/0017-Specify-netlink-recv-buffer-size-to-avoid-a-syscall.patch",
        "//:patch/0018-Replace-FD_SET-select-with-poll-to-avoid-FD_SETSIZE-abort.patch",
        "//:patch/0019-fix-event-fd-init-and-free.patch",
        "//:patch/0020-Extend-LACP-fallback-support-to-multiple-ports.patch",
    ],
)
http_archive(
    name = "libteam_debian",
    urls = ["https://deb.debian.org/debian/pool/main/libt/libteam/libteam_1.31-1.debian.tar.xz"],
    sha256 = "e31d0f79ecc4cfa462d4fdfb4551792ba09b3b7c5aa2ab87c18777d95aec38ef",
    build_file_content = 'exports_files(glob(["debian/**"]))',
)

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "libteam_deps",
    packages = [
        # Export both compilation interfaces and the runtime metadata closure.
        "libbsd0",
        "libcap2",
        "libcom-err2",
        "libdaemon-dev",
        "libdaemon0",
        "libdbus-1-3",
        "libdbus-1-dev",
        "libgssapi-krb5-2",
        "libjansson-dev",
        "libjansson4",
        "libk5crypto3",
        "libkeyutils1",
        "libkrb5-3",
        "libkrb5support0",
        "libmd0",
        "libnorm1t64",
        "libpgm-5.3-0t64",
        "libsodium23",
        "libssl3t64",
        "libsystemd0",
        "libzmq3-dev",
        "libzmq5",
        "libzstd1",
        "openssl-provider-legacy",
        "zlib1g",
    ],
    suites = ["trixie", "trixie-updates", "trixie-security"],
)
use_repo(apt, "libteam_deps", "sysroot")
