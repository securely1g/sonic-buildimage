load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//:flags.bzl", "CFLAGS_ASAN", "CFLAGS_COMMON", "DBGFLAGS", "LDFLAGS_ASAN")
load("//:gnoi.bzl", "gnoi_cc_protos")

exports_files(["reboot.xml"])

genrule(
    name = "reboot_dbus.h.gen",
    srcs = [":reboot.xml"],
    outs = ["reboot_dbus.h"],
    cmd = "$(execpath //tools/dbus:generate) --runtime $(location //tools/dbus:runtime) --xml $(location :reboot.xml) --mode proxy --output $@",
    tools = [
        "//tools/dbus:generate",
        "//tools/dbus:runtime",
    ],
)

cc_library(
    name = "reboot_dbus",
    hdrs = [":reboot_dbus.h.gen"],
    includes = ["."],
)

gnoi_cc_protos(name = "gnoi_cc_protos")

cc_library(
    name = "proto_compat",
    hdrs = ["proto_compat.h"],
    deps = [
        "@sonic_protobuf//:libprotobuf",
    ],
)

cc_library(
    name = "reboot_core",
    srcs = [
        "reboot_thread.cpp",
        "rebootbe.cpp",
    ],
    hdrs = [
        "reboot_common.h",
        "reboot_interfaces.h",
        "reboot_thread.h",
        "rebootbe.h",
    ],
    cxxopts = DBGFLAGS + CFLAGS_COMMON + CFLAGS_ASAN,
    includes = ["."],
    linkopts = LDFLAGS_ASAN,
    visibility = ["//:__subpackages__"],
    deps = [
        ":gnoi_cc_protos",
        ":proto_compat",
        "@sonic_swss_common//:libswsscommon_shared",
    ],
)

cc_binary(
    name = "rebootbackend",
    srcs = [
        "interfaces.cpp",
        "interfaces.h",
        "rebootbackend.cpp",
    ],
    cxxopts = DBGFLAGS + CFLAGS_COMMON + CFLAGS_ASAN,
    linkopts = LDFLAGS_ASAN,
    visibility = ["//:__subpackages__"],
    deps = [
        ":reboot_core",
        ":reboot_dbus",
        "@trixie//libdbus-c++-dev:libdbus-c++",
    ],
)

# Validate the generated gNOI messages with the selected shared runtime.
cc_test(
    name = "gnoi_runtime_test",
    srcs = ["gnoi_runtime_test.cpp"],
    visibility = ["//visibility:public"],
    deps = [":gnoi_cc_protos"],
)
