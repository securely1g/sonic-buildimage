load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//:flags.bzl", "CFLAGS_ASAN", "CFLAGS_COMMON", "DBGFLAGS", "LDFLAGS_ASAN")
load("//:gnoi.bzl", "gnoi_cc_protos")

# TODO(bazel-ready): Support debug
# if DEBUG
# DBGFLAGS = -ggdb -DDEBUG
# else
# DBGFLAGS = -g
# endif

# TODO(bazel-ready): Fix the proto warnings on build

genrule(
    name = "reboot_dbus.h.gen",
    srcs = [":reboot.xml"],
    outs = ["reboot_dbus.h"],
    cmd = "$(execpath @libdbus_bin//:dbusxx-xml2cpp) $(SRCS) --proxy=$(OUTS)",
    tools = ["@libdbus_bin//:dbusxx-xml2cpp"],
)

cc_library(
    name = "reboot_dbus",
    hdrs = [":reboot_dbus.h.gen"],
    includes = ["."],
)

gnoi_cc_protos(name = "gnoi_cc_protos")

cc_library(
    name = "proto_compat",
    hdrs = ["proto_compat.h"],
    deps = [
        "@sonic_protobuf//:libprotobuf",
    ],
)

cc_binary(
    name = "rebootbackend",
    srcs = glob(
        [
            "*.cpp",
            "*.h",
        ],
        exclude = ["gnoi_runtime_test.cpp"],
    ),
    cxxopts = DBGFLAGS + CFLAGS_COMMON + CFLAGS_ASAN,
    linkopts = LDFLAGS_ASAN,
    visibility = ["//:__subpackages__"],
    deps = [
        ":gnoi_cc_protos",
        ":proto_compat",
        ":reboot_dbus",
        "@sonic_swss_common//:libswsscommon_shared",
        "@trixie//libdbus-c++-dev:libdbus-c++",
    ],
)

# Validate the generated gNOI messages with the selected shared runtime.
cc_test(
    name = "gnoi_runtime_test",
    srcs = ["gnoi_runtime_test.cpp"],
    visibility = ["//visibility:public"],
    deps = [":gnoi_cc_protos"],
)
