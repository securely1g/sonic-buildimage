module(
    name = "sonic-sysmgr",
    version = "0.0.0.sonic-buildimage",
    bazel_compatibility = [
        ">=8.5.1",
        "<=8.5.1",
    ],
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3", dev_dependency = True)

bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_rs", version = "0.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "tar.bzl", version = "0.10.5-sonic.1")
bazel_dep(name = "patchelf", version = "0.18.0.bcr.1")
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.16")
bazel_dep(name = "sonic-build-infra", version = "0.0.26-51c838da6ff57295fde6e0bc3807841cb31a8568", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "0.0.8-43598143ef4a46431eae0859915cd7d951dad1ed", repo_name = "sonic_swss_common")
bazel_dep(name = "protobuf-legacy", version = "3.21.12.sonic.2", repo_name = "sonic_protobuf")
bazel_dep(name = "googletest", version = "1.14.0.bcr.1", repo_name = "com_google_googletest")

# Keep the owner's patched interfaces selected over older transitive requests.
single_version_override(
    module_name = "sonic-build-infra",
    version = "0.0.26-51c838da6ff57295fde6e0bc3807841cb31a8568",
)

single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5-sonic.1",
)

single_version_override(
    module_name = "rules_cc",
    version = "0.2.20",
)

single_version_override(
    module_name = "rules_go",
    version = "0.64.1-sonic.1",
)

gcc = use_extension("@sonic_build_infra//toolchains/gcc:extensions.bzl", "gcc")
use_repo(gcc, "gcc_toolchains")

register_toolchains("@gcc_toolchains//:all")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)
python.toolchain(python_version = "3.11")

# Common owns its Rust libraries. Its module extension still requires the
# consuming root to select the shared toolchain even for C++-only targets.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

bindgen = use_extension("@rules_rs//rs:rules_rust_bindgen.bzl", "rules_rust_bindgen")
use_repo(bindgen, "rules_rust_bindgen")

register_toolchains("@rules_rust_bindgen//:all")

# Infrastructure owns the immutable Trixie snapshot and compilation packages.
# Extend its shared execution-tool set for generation and private test services.
# These tools are not image payloads.
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    dependency_set = "build_tools",
    packages = [
        "binutils:amd64",
        "bubblewrap:amd64",
        "dbus-daemon:amd64",
        "libdbus-c++-bin:amd64",
        "redis-server:amd64",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(apt, "build_tools", "trixie")

# Preserve the exact gNOI gitlink and generator inputs used by Automake.
vendored_protos = use_repo_rule("//:vendored_protos.bzl", "vendored_protos")

vendored_protos(name = "gnoi_protos")
