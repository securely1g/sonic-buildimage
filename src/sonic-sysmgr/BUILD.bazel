load("@rules_python//python:py_binary.bzl", "py_binary")
load("@sonic_build_infra//tar:sonic_deploy_tar.bzl", "sonic_deploy_tar")

sonic_deploy_tar(
    name = "sysmgr_pkg",
    srcs = ["//rebootbackend"],
    binaries = {
        "./usr/bin/rebootbackend type=file uid=0 gid=0 mode=0755 time=0": "//rebootbackend:rebootbackend",
        "./usr/lib/x86_64-linux-gnu/librebootgnoi.so.0.0.0 type=file uid=0 gid=0 mode=0644 time=0": "//rebootbackend:librebootgnoi.so.0.0.0",
    },
    force_debug_build = True,
    mtree = [
        "./usr type=dir uid=0 gid=0 mode=0755 time=0",
        "./usr/bin type=dir uid=0 gid=0 mode=0755 time=0",
        "./usr/lib type=dir uid=0 gid=0 mode=0755 time=0",
        "./usr/lib/x86_64-linux-gnu type=dir uid=0 gid=0 mode=0755 time=0",
        # The soname and the linker name, as libtool lays them out.
        "./usr/lib/x86_64-linux-gnu/librebootgnoi.so.0 type=link link=librebootgnoi.so.0.0.0 uid=0 gid=0 time=0",
        "./usr/lib/x86_64-linux-gnu/librebootgnoi.so type=link link=librebootgnoi.so.0.0.0 uid=0 gid=0 time=0",
    ],
    visibility = ["//visibility:public"],
)

# Map the deployment payload to Make's existing package for equivalence checks.
# Keep the tag outside sonic_deploy_tar, which propagates tags to internal rules.
filegroup(
    name = "sysmgr_runtime_equivalence",
    srcs = [":sysmgr_pkg"],
    tags = ["make-deb:sysmgr_1.0.0_amd64.deb"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "root_owned_tar",
    srcs = ["tools/bazel/root_owned_tar.py"],
    main = "tools/bazel/root_owned_tar.py",
    visibility = ["//visibility:public"],
)

# The debug tar's generated parent entries can inherit the build user's owner.
# Normalize the headers before including them in a package or an OCI layer.
genrule(
    name = "sysmgr_debug_pkg",
    srcs = [":sysmgr_pkg.debug_symbols"],
    outs = ["sysmgr_debug_pkg.tar"],
    cmd = '$(location :root_owned_tar) "$(location :sysmgr_pkg.debug_symbols)" "$@"',
    tags = ["make-deb:sysmgr-dbg_1.0.0_amd64.deb"],
    tools = [":root_owned_tar"],
    visibility = ["//visibility:public"],
)
