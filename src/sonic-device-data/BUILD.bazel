load("@aspect_bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_gzip//gzip/compress:defs.bzl", "gzip_compress")
load("@rules_python//python:defs.bzl", "py_binary")
load("@tar.bzl//tar:tar.bzl", "tar")

_DEVICE = "//device:platform_files"
_INPUTS = "@vs_device_data_inputs//:metadata.json"
_PROFILES = glob(["src/*.ini", "src/*.vs_profile"])

py_binary(
    name = "prepare_vs",
    srcs = ["prepare_vs.py", "src/generate_vs_hwsku.py"],
    imports = ["src"],
    main = "prepare_vs.py",
)

gzip_compress(
    name = "changelog_gzip",
    src = "src/debian/changelog",
    level = 9,
)

run_binary(
    name = "vs_install_files",
    srcs = [
        _DEVICE,
        "//device:BUILD.bazel",
        _INPUTS,
        ":changelog_gzip",
        "src/debian/copyright",
    ] + _PROFILES + glob(["tests/*_checker", "tests/permitted_list"]),
    tool = ":prepare_vs",
    args = [
        "$(execpath //device:BUILD.bazel)",
        "$(execpath src/sai.vs_profile)",
        "$(execpath " + _INPUTS + ")",
        "$(execpath :changelog_gzip)",
        "$(RULEDIR)/generated",
        "$(RULEDIR)/vs_install.mtree",
    ],
    outs = ["vs_install.mtree"],
    out_dirs = ["generated"],
    mnemonic = "GenerateVsDeviceData",
)

tar(
    name = "vs_runtime_tar",
    srcs = [
        _DEVICE,
        ":changelog_gzip",
        ":vs_install_files",
        "src/debian/copyright",
    ] + _PROFILES,
    compress = None,
    mtree = ":vs_install.mtree",
    visibility = ["//visibility:public"],
)

# Host installation metadata for the native VS assembler.
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@sonic_build_infra//oci:runtime_packages.bzl", "runtime_packages")
write_file(name = "vs_platform_asic", out = "vs.platform_asic", content = ["vs", ""], newline = "unix", visibility = ["//visibility:public"])
runtime_packages(
    name = "runtime_packages.json",
    packages = {"sonic-device-data": ":vs_runtime_tar"},
    control = "src/debian/control",
    changelog = "src/debian/changelog",
    required_paths = {"sonic-device-data": ["usr/share/sonic/device/x86_64-kvm_x86_64-r0/platform_asic", "usr/share/sonic/device/x86_64-kvm_x86_64-r0/Force10-S6000/port_config.ini"]},
    visibility = ["//visibility:public"],
)
