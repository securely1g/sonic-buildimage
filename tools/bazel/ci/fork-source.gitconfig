# CI in this fork preserves recorded source revisions while fetching SONiC
# sources from the corresponding securely1g repositories.
[url "https://github.com/securely1g/"]
    insteadOf = https://github.com/sonic-net/
    insteadOf = git@github.com:sonic-net/
    insteadOf = ssh://git@github.com/sonic-net/
