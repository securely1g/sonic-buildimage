Preserve oversized configure CPPFLAGS before the first process launch.

The BMv2 closure exceeds Linux's per-environment-string limit before /bin/sh
starts. Retain the selected infrastructure and APT lock policy. This adapts
the owner's private-vector reader and sourced, declared-Python transport:
https://github.com/securely1g/sonic-build-infra/commit/08e0956f80574b27a9b68e72fe855cc0089058e5
https://github.com/securely1g/sonic-build-infra/commit/3009f64f0e546afca33ee249351ea8794de3a5cc

Only the explicit private preprocessor vector is expanded; ordinary response
files and existing compiler/include/library ordering remain unchanged.

diff --git a/tools/build_tools/configure_environment.sh b/tools/build_tools/configure_environment.sh
--- a/tools/build_tools/configure_environment.sh
+++ b/tools/build_tools/configure_environment.sh
@@ -26,6 +26,32 @@
 set -eu
 compiler=$1
 shift
+# Only the owner-generated vector beside this launcher uses this transport.
+# Ordinary GCC response files remain opaque. Expand before include-class
+# adaptation so recursive Make and Libtool preserve the original token order.
+preprocessor_response="${0%/*}/.sonic-preprocessor-arguments"
+if test -f "$preprocessor_response"; then
+    remaining=$#
+    while test "$remaining" -gt 0; do
+        argument=$1
+        shift
+        remaining=$((remaining - 1))
+        if test "$argument" = "@$preprocessor_response"; then
+            {
+                IFS= read -r response_format
+                test "$response_format" = sonic-preprocessor-arguments-v1 || {
+                    echo "Invalid private preprocessor argument response" >&2
+                    exit 2
+                }
+                while IFS= read -r response_argument || test -n "$response_argument"; do
+                    set -- "$@" "$response_argument"
+                done
+            } < "$preprocessor_response"
+        else
+            set -- "$@" "$argument"
+        fi
+    done
+fi
 # Response files may contain native includes. Preserve their driver ordering
 # rather than partially rewriting a group whose contents are not visible here.
 for argument in "$@"; do
diff --git a/tools/build_tools/configure_preprocessor_flags.sh b/tools/build_tools/configure_preprocessor_flags.sh
new file mode 100644
--- /dev/null
+++ b/tools/build_tools/configure_preprocessor_flags.sh
@@ -0,0 +1,26 @@
+# Source before the first exec: . configure_preprocessor_flags.sh PYTHON COMMAND [ARG...]
+# PYTHON is a declared execution-side interpreter. configure_environment.sh must
+# create its compiler launcher in this same directory to consume the vector.
+(
+    set -eu
+    sonic_python=${1:?a declared Python interpreter is required}
+    shift
+    : "${1:?a configure command is required}"
+    sonic_preprocessor_arguments="$PWD/.sonic-preprocessor-arguments"
+    # Only shell builtins may run until the oversized environment entry is gone.
+    printf '%s\n' "${CPPFLAGS:-}" > "$sonic_preprocessor_arguments.raw"
+    export CPPFLAGS="@$sonic_preprocessor_arguments"
+    "$sonic_python" - "$sonic_preprocessor_arguments.raw" "$sonic_preprocessor_arguments" <<'PY'
+import pathlib
+import shlex
+import sys
+
+arguments = shlex.split(pathlib.Path(sys.argv[1]).read_text())
+if any("\n" in value or "\r" in value for value in arguments):
+    raise ValueError("Preprocessor arguments cannot contain line breaks")
+pathlib.Path(sys.argv[2]).write_text(
+    "sonic-preprocessor-arguments-v1\n" + "".join(value + "\n" for value in arguments)
+)
+PY
+    "$@"
+)
diff --git a/tools/build_tools/BUILD.bazel b/tools/build_tools/BUILD.bazel
--- a/tools/build_tools/BUILD.bazel
+++ b/tools/build_tools/BUILD.bazel
@@ -526,7 +526,10 @@
     visibility = ["//visibility:public"],
 )

-exports_files(["configure_environment.sh"])
+exports_files([
+    "configure_environment.sh",
+    "configure_preprocessor_flags.sh",
+])

 filegroup(
     name = "libtool_sources",
