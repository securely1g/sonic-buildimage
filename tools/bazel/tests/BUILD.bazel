load("@rules_python//python:defs.bzl", "py_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Run the unchanged Rust tests with Common's declared native runtime. The owner
# helper, runtime TAR and Rust binary are all inputs to the Bazel test action.
sh_test(
    name = "swss_common_rust_test",
    srcs = ["@sonic_swss_common//tools/bazel/runtime:run_with_runtime.py"],
    args = [
        "$(rootpath @sonic_swss_common//tools/bazel/runtime:test_runtime)",
        "-",
    ] + select({
        "@sonic_swss_common//tools/bazel:yang_modules_enabled": ["enabled"],
        "//conditions:default": ["disabled"],
    }) + ["$(rootpath @sonic_swss//crates/countersyncd:common_rust_test)"],
    data = [
        "@sonic_swss//crates/countersyncd:common_rust_test",
        "@sonic_swss_common//tools/bazel/runtime:test_runtime",
    ],
)

py_test(
    name = "make_bridge_test",
    size = "small",
    srcs = ["make_bridge_test.py"],
    data = ["//:make_bridge_test_data"],
)

py_test(
    name = "swss_contract_test",
    size = "small",
    srcs = [
        "swss_container_test.py",
        "swss_contract_test.py",
    ],
    imports = ["."],
)
