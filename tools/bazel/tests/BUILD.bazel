load("@config_engine_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")
load("//src/sonic-config-engine:template.bzl", "sonic_cfggen_template")

package(default_visibility = ["//visibility:public"])

py_test(
    name = "sonic_config_engine_full_test",
    size = "large",
    srcs = ["integration/component_pytest_runner.py"],
    args = [
        "--component-setup=$(rootpath //src/sonic-config-engine:setup.py)",
        "--models=$(rootpath @sonic_yang_models//:yang_models)",
        "--cfggen=$(rootpath //src/sonic-config-engine:sonic_cfggen)",
    ],
    data = [
        "//device:config_engine_test_data",
        "//dockers:config_engine_test_data",
        "//files/build_templates:config_engine_test_data",
        "//files/image_config:config_engine_test_data",
        "//src/sonic-config-engine:setup.py",
        "//src/sonic-config-engine:sonic_cfggen",
        "//src/sonic-config-engine:test_sources",
        "@sonic_yang_models//:yang_models",
    ],
    legacy_create_init = False,
    main = "integration/component_pytest_runner.py",
    python_version = "3.13",
    deps = [
        "//src/sonic-config-engine:sonic_config_engine",
        requirement("mock"),
        requirement("mockredispy"),
        requirement("pytest"),
        requirement("redis"),
        requirement("swsssdk"),
    ],
)

