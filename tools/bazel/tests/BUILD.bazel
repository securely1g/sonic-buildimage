sonic_cfggen_template(
    name = "cfggen_template_fixture",
    testonly = True,
    srcs = ["cfggen_fixture_fragment.j2"],
    out = "cfggen-template-fixture.txt",
    additional_data = {
        "message": "two words 'single' \"double\" $HOME $(ignored) `literal` \\ end",
        "prefix": "198.51.100.19/24",
        "values": [
            "a b",
            "c",
        ],
    },
    template = "cfggen_fixture.j2",
)

