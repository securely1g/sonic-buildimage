"""Link source-built clients against the reviewed AMD64 P4/DASH package tuple."""

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_test")
load("@sonic_sairedis//bazel:common.bzl", "working_directory_test")

package(default_visibility = ["//visibility:public"])

_AMD64 = ["@platforms//cpu:x86_64", "@platforms//os:linux"]
_TAR = "@bsd_tar_toolchains//:resolved_toolchain"

# http_file repositories verify the existing packages against packages.lock.json.
# These declared actions use upstream BSD tar and never invoke a DEB producer.
_PACKAGES = {
    "pi": "@p4_prebuilt_pi//file",
    "dash": "@p4_prebuilt_dash//file",
    "dash_dev": "@p4_prebuilt_dash_dev//file",
}

[
    genrule(
        name = name + "_data",
        srcs = [source],
        outs = [name + ".data.tar"],
        cmd = 'set -euo pipefail\nexport LC_ALL=C.UTF-8\n' +
              '"$(BSDTAR_BIN)" -xOf "$(execpath ' + source + ')" data.tar.xz | ' +
              '"$(BSDTAR_BIN)" --format=pax -cf "$@" @-',
        toolchains = [_TAR],
        tools = [_TAR],
        target_compatible_with = _AMD64,
    )
    for name, source in _PACKAGES.items()
]

# Keep imported ELF bytes unchanged. PI's SONAME names are the declared output
# names so Bazel's solib tree also supplies the names used by the dynamic loader.
_LIBRARIES = {
    "libsai": ("dash", "libsai.so", "libsai.so"),
    "piprotobuf": ("pi", "libpiprotobuf.so.0.0.0", "libpiprotobuf.so.0"),
    "piprotogrpc": ("pi", "libpiprotogrpc.so.0.0.0", "libpiprotogrpc.so.0"),
}

[
    genrule(
        name = name + "_file",
        srcs = [":" + source + "_data"],
        outs = [output],
        cmd = 'export LC_ALL=C.UTF-8\n"$(BSDTAR_BIN)" -xOf "$(execpath :' + source +
              '_data)" ./usr/lib/x86_64-linux-gnu/' + original + ' > "$@"',
        toolchains = [_TAR],
        tools = [_TAR],
        target_compatible_with = _AMD64,
    )
    for name, (source, original, output) in _LIBRARIES.items()
]

[
    cc_import(
        name = name,
        shared_library = ":" + name + "_file",
        target_compatible_with = _AMD64,
    )
    for name in _LIBRARIES
]

cc_library(
    name = "dash_sai",
    deps = [
        ":libsai",
        ":piprotobuf",
        ":piprotogrpc",
        "@p4_sdk_debian//libprotobuf-dev:libprotobuf",
        "@p4_sdk_debian//libgrpc++-dev:libgrpc++",
    ],
    target_compatible_with = _AMD64,
)

