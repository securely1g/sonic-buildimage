genrule(
    name = "sai_header_files",
    srcs = [":dash_dev_data"],
    outs = ["include/sai/" + name for name in _SAI_HEADERS],
    cmd = 'set -euo pipefail\nexport LC_ALL=C.UTF-8\n' +
          'mkdir -p "$(RULEDIR)/include/sai"\n' +
          '"$(BSDTAR_BIN)" -xf "$(execpath :dash_dev_data)" ' +
          '-C "$(RULEDIR)/include/sai" --strip-components=4 ./usr/include/sai',
    toolchains = [_TAR],
    tools = [_TAR],
    target_compatible_with = _AMD64,
)

cc_library(
    name = "sai_headers",
    hdrs = [":sai_header_files"],
    includes = ["include/sai"],
    target_compatible_with = _AMD64,
)

cc_binary(
    name = "sdk_smoke",
    testonly = True,
    srcs = ["sdk_smoke.cc"],
    deps = [":sai_headers", ":dash_sai"],
    target_compatible_with = _AMD64,
)

working_directory_test(
    name = "sdk_runtime_test",
    program = ":sdk_smoke",
    working_directory = "tools/bazel/p4/sdk",
    tags = ["manual"],
    target_compatible_with = _AMD64,
)

py_test(
    name = "packages_test",
    srcs = ["packages_test.py"],
    main = "packages_test.py",
    args = [
        "--syncd-runtime", "$(rootpath @sonic_sairedis//syncd:syncd_pkg)",
        "--syncd-debug", "$(rootpath @sonic_sairedis//syncd:syncd_pkg.debug_symbols)",
        "--vs-runtime", "$(rootpath @sonic_sairedis//vslib:libsaivs_pkg)",
        "--vs-debug", "$(rootpath @sonic_sairedis//vslib:libsaivs_pkg.debug_symbols)",
    ],
    data = [
        "@sonic_sairedis//syncd:syncd_pkg",
        "@sonic_sairedis//syncd:syncd_pkg.debug_symbols",
        "@sonic_sairedis//vslib:libsaivs_pkg",
        "@sonic_sairedis//vslib:libsaivs_pkg.debug_symbols",
    ],
    deps = ["//tools/bazel/ci:artifact_validation"],
    tags = ["manual"],
    target_compatible_with = _AMD64,
)
