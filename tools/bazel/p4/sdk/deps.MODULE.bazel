# Exact Debian ABI dependencies for the reviewed P4/DASH binary tuple.
# The shared infrastructure module supplies the pinned Trixie snapshot sources.
p4_sdk_apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
p4_sdk_apt.install(
    dependency_set = "p4_sdk_debian",
    packages = [
        "libgrpc++-dev (= 1.51.1-6) [amd64]",
        "libprotobuf-dev (= 3.21.12-11+deb13u1) [amd64]",
    ],
    suites = [
        "trixie",
        "trixie-updates",
        "trixie-security",
    ],
)
use_repo(p4_sdk_apt, "p4_sdk_debian")
