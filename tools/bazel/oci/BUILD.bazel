load("@container_config_pip//:requirements.bzl", "requirement")
load("@rules_gzip//gzip/compress:defs.bzl", "gzip_compress")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load(":docker_archive_to_oci.bzl", "docker_archive_to_oci_layout")
load(":sonic_docker_archive.bzl", "sonic_docker_archive")

package(default_visibility = ["//visibility:public"])

exports_files(["requirements_lock.txt"])

py_library(
    name = "container_config",
    srcs = ["container_config.py"],
    imports = ["."],
    deps = [requirement("jinja2")],
)

py_test(
    name = "container_config_test",
    size = "small",
    srcs = ["container_config_test.py"],
    deps = [":container_config"],
)

# The same pinned executable and import wrapper are used by production and tests.
filegroup(
    name = "regctl",
    srcs = ["@oci_regctl_toolchains//:current_toolchain"],
)

py_binary(
    name = "import_docker_archive",
    srcs = ["import_docker_archive.py"],
)

py_library(
    name = "import_fixture_lib",
    srcs = ["import_fixture.py"],
    imports = ["."],
)

py_binary(
    name = "import_fixture",
    srcs = ["import_fixture.py"],
)

py_test(
    name = "docker_archive_to_oci_layout_test",
    size = "small",
    srcs = ["docker_archive_to_oci_layout_test.py"],
    args = [
        "--wrapper=$(location :import_docker_archive)",
        "--regctl=$(location :regctl)",
    ],
    data = [
        ":import_docker_archive",
        ":regctl",
    ],
    deps = [":import_fixture_lib"],
)

# Exercise the production import macro and rules_oci consumer on native CI
# architectures, with no Docker daemon or Make-built package dependencies.
genrule(
    name = "import_fixture_sources",
    outs = [
        "import-first.tar",
        "import-renamed.tar.gz",
        "import-overlay.tar",
    ],
    cmd = "$(execpath :import_fixture) " +
          "--first $(location :import-first.tar) " +
          "--second $(location :import-renamed.tar.gz) " +
          "--overlay $(location :import-overlay.tar) --architecture amd64",
    tools = [":import_fixture"],
)

docker_archive_to_oci_layout(
    name = "import_fixture_first",
    src = ":import-first.tar",
    expected_platform = "linux/amd64",
)

docker_archive_to_oci_layout(
    name = "import_fixture_second",
    src = ":import-renamed.tar.gz",
    expected_platform = "linux/amd64",
)

oci_image(
    name = "import-consumer-first",
    base = ":import_fixture_first",
    env = {"CONSUMER_FIXTURE": "added"},
    tars = [":import-overlay.tar"],
)

oci_image(
    name = "import-consumer-second",
    base = ":import_fixture_second",
    env = {"CONSUMER_FIXTURE": "added"},
    tars = [":import-overlay.tar"],
)

sonic_docker_archive(
    name = "import-consumer-first.gz",
    image = ":import-consumer-first",
)

sonic_docker_archive(
    name = "import-consumer-second.gz",
    image = ":import-consumer-second",
)

py_test(
    name = "docker_archive_import_consumer_test",
    size = "small",
    srcs = ["docker_archive_import_consumer_test.py"],
    args = [
        "--first-layout=$(location :import_fixture_first)",
        "--second-layout=$(location :import_fixture_second)",
        "--first-export=$(location :import-consumer-first.gz)",
        "--second-export=$(location :import-consumer-second.gz)",
        "--architecture=amd64",
    ],
    data = [
        ":import-consumer-first.gz",
        ":import-consumer-second.gz",
        ":import_fixture_first",
        ":import_fixture_second",
    ],
    deps = [":import_fixture_lib"],
)

# A source-only fixture exercises the production archive macro on both native
# CI architectures without requiring Make-built components or a Docker daemon.
py_binary(
    name = "archive_fixture",
    srcs = ["archive_fixture.py"],
)

genrule(
    name = "archive_fixture_layer",
    outs = ["archive-layer.tar"],
    cmd = "$(execpath :archive_fixture) --layer $@",
    tools = [":archive_fixture"],
)

oci_image(
    name = "archive-fixture",
    architecture = select({
        "@platforms//cpu:aarch64": "arm64",
        "//conditions:default": "amd64",
    }),
    os = "linux",
    tars = [":archive-layer.tar"],
)

sonic_docker_archive(
    name = "archive-fixture.gz",
    image = ":archive-fixture",
)

genrule(
    name = "archive_fixture_sources",
    srcs = [":archive-fixture.tar"],
    outs = [
        "archive-first.tar",
        "different-source-name.tar",
    ],
    cmd = "$(execpath :archive_fixture) --copy $(location :archive-fixture.tar) " +
          "--first $(location :archive-first.tar) " +
          "--second $(location :different-source-name.tar)",
    tools = [":archive_fixture"],
)

gzip_compress(
    name = "archive_fixture_first",
    src = ":archive-first.tar",
    level = 6,
)

gzip_compress(
    name = "archive_fixture_second",
    src = ":different-source-name.tar",
    level = 6,
)

py_test(
    name = "sonic_docker_archive_test",
    size = "small",
    srcs = ["sonic_docker_archive_test.py"],
    args = [
        "--archive=$(location :archive-fixture.gz)",
        "--first=$(location :archive_fixture_first)",
        "--second=$(location :archive_fixture_second)",
        "--first-source=$(location :archive-first.tar)",
        "--second-source=$(location :different-source-name.tar)",
    ] + select({
        "@platforms//cpu:aarch64": ["--architecture=arm64"],
        "//conditions:default": ["--architecture=amd64"],
    }),
    data = [
        ":archive-first.tar",
        ":archive-fixture.gz",
        ":archive_fixture_first",
        ":archive_fixture_second",
        ":different-source-name.tar",
    ],
)
