load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files(["prepare_oci_base.py"])

py_library(
    name = "manifest_labels_lib",
    srcs = ["manifest_labels.py"],
    imports = ["."],
)

py_binary(
    name = "manifest_labels",
    srcs = ["manifest_labels.py"],
)

# The same validator is used by Make publication and the Bazel consumer.
py_library(
    name = "oci_layout",
    srcs = ["oci_layout.py"],
    imports = ["."],
)

py_binary(
    name = "validate_oci_layout",
    srcs = ["oci_layout.py"],
    main = "oci_layout.py",
)

py_binary(
    name = "prepare_oci_base",
    srcs = ["prepare_oci_base.py"],
    deps = [":oci_layout"],
)
