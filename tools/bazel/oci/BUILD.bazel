load("@aspect_bazel_lib//lib:run_binary.bzl", "run_binary")
load("@container_config_pip//:requirements.bzl", "requirement")
load("@rules_gzip//gzip/compress:defs.bzl", "gzip_compress")
load("@rules_oci//oci:defs.bzl", "oci_image")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load(":oci_base_layout.bzl", "oci_base_layout")
load(":sonic_docker_archive.bzl", "sonic_docker_archive")

package(default_visibility = ["//visibility:public"])

exports_files(["requirements_lock.txt"])

py_library(
    name = "container_config",
    srcs = ["container_config.py"],
    imports = ["."],
    deps = [requirement("jinja2")],
)

py_test(
    name = "container_config_test",
    size = "small",
    srcs = ["container_config_test.py"],
    deps = [":container_config"],
)

# The same validator is used by Make publication and the Bazel consumer.
py_library(
    name = "oci_layout",
    srcs = ["oci_layout.py"],
    imports = ["."],
)

py_binary(
    name = "validate_oci_layout",
    srcs = ["oci_layout.py"],
    main = "oci_layout.py",
)

py_library(
    name = "oci_base_fixture_lib",
    srcs = ["oci_base_fixture.py"],
    imports = ["."],
)

py_binary(
    name = "oci_base_fixture",
    srcs = ["oci_base_fixture.py"],
    data = ["//tools/bazel/swss:prepare_oci_base"],
    deps = ["@rules_python//python/runfiles"],
)

py_test(
    name = "oci_base_layout_test",
    size = "small",
    srcs = ["oci_base_layout_test.py"],
    deps = [
        ":oci_base_fixture_lib",
        ":oci_layout",
    ],
)

# Different outer archive timestamps must leave the original OCI bytes intact.
# Each fixture invokes Make's actual publication helper before Bazel reads it.
run_binary(
    name = "oci_fixture_first",
    args = [
        "--out",
        "$@",
        "--mtime",
        "946684800",
    ],
    out_dirs = ["oci-fixture-first"],
    tool = ":oci_base_fixture",
)

run_binary(
    name = "oci_fixture_second",
    args = [
        "--out",
        "$@",
        "--mtime",
        "1700000000",
    ],
    out_dirs = ["oci-fixture-second"],
    tool = ":oci_base_fixture",
)

oci_base_layout(
    name = "oci_base_first",
    srcs = [":oci_fixture_first"],
    expected_platform = "linux/amd64",
    marker = "$(execpath :oci_fixture_first)/oci-layout",
    root = "tools/bazel/oci/oci-fixture-first",
)

oci_base_layout(
    name = "oci_base_second",
    srcs = [":oci_fixture_second"],
    expected_platform = "linux/amd64",
    marker = "$(execpath :oci_fixture_second)/oci-layout",
    root = "tools/bazel/oci/oci-fixture-second",
)

genrule(
    name = "oci_fixture_overlay",
    outs = ["oci-overlay.tar"],
    cmd = "$(execpath :oci_base_fixture) --overlay $@",
    tools = [":oci_base_fixture"],
)

oci_image(
    name = "oci-consumer-first",
    base = ":oci_base_first",
    env = {"CONSUMER_FIXTURE": "added"},
    tars = [":oci_fixture_overlay"],
)

oci_image(
    name = "oci-consumer-second",
    base = ":oci_base_second",
    env = {"CONSUMER_FIXTURE": "added"},
    tars = [":oci_fixture_overlay"],
)

sonic_docker_archive(
    name = "oci-consumer-first.gz",
    image = ":oci-consumer-first",
)

sonic_docker_archive(
    name = "oci-consumer-second.gz",
    image = ":oci-consumer-second",
)

py_test(
    name = "oci_base_consumer_test",
    size = "small",
    srcs = ["oci_base_consumer_test.py"],
    args = [
        "--first-layout=$(location :oci_base_first)",
        "--second-layout=$(location :oci_base_second)",
        "--first-image=$(location :oci-consumer-first)",
        "--second-image=$(location :oci-consumer-second)",
        "--first-export=$(location :oci-consumer-first.gz)",
        "--second-export=$(location :oci-consumer-second.gz)",
    ],
    data = [
        ":oci-consumer-first",
        ":oci-consumer-first.gz",
        ":oci-consumer-second",
        ":oci-consumer-second.gz",
        ":oci_base_first",
        ":oci_base_second",
    ],
    deps = [":oci_base_fixture_lib"],
)

# A source-only fixture exercises the production archive macro on both native
# CI architectures without requiring Make-built components or a Docker daemon.
py_binary(
    name = "archive_fixture",
    srcs = ["archive_fixture.py"],
)

genrule(
    name = "archive_fixture_layer",
    outs = ["archive-layer.tar"],
    cmd = "$(execpath :archive_fixture) --layer $@",
    tools = [":archive_fixture"],
)

oci_image(
    name = "archive-fixture",
    architecture = select({
        "@platforms//cpu:aarch64": "arm64",
        "//conditions:default": "amd64",
    }),
    os = "linux",
    tars = [":archive-layer.tar"],
)

sonic_docker_archive(
    name = "archive-fixture.gz",
    image = ":archive-fixture",
)

genrule(
    name = "archive_fixture_sources",
    srcs = [":archive-fixture.tar"],
    outs = [
        "archive-first.tar",
        "different-source-name.tar",
    ],
    cmd = "$(execpath :archive_fixture) --copy $(location :archive-fixture.tar) " +
          "--first $(location :archive-first.tar) " +
          "--second $(location :different-source-name.tar)",
    tools = [":archive_fixture"],
)

gzip_compress(
    name = "archive_fixture_first",
    src = ":archive-first.tar",
    level = 6,
)

gzip_compress(
    name = "archive_fixture_second",
    src = ":different-source-name.tar",
    level = 6,
)

py_test(
    name = "sonic_docker_archive_test",
    size = "small",
    srcs = ["sonic_docker_archive_test.py"],
    args = [
        "--archive=$(location :archive-fixture.gz)",
        "--first=$(location :archive_fixture_first)",
        "--second=$(location :archive_fixture_second)",
        "--first-source=$(location :archive-first.tar)",
        "--second-source=$(location :different-source-name.tar)",
    ] + select({
        "@platforms//cpu:aarch64": ["--architecture=arm64"],
        "//conditions:default": ["--architecture=amd64"],
    }),
    data = [
        ":archive-first.tar",
        ":archive-fixture.gz",
        ":archive_fixture_first",
        ":archive_fixture_second",
        ":different-source-name.tar",
    ],
)
