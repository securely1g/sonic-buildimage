load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

# apt_install transitions this executable and its original DEB to the native
# execution platform. Its libc comes from the digest-pinned Trixie worker.
alias(
    name = "bubblewrap_archive",
    actual = select({
        "@platforms//cpu:x86_64": "@apt_install_bwrap_amd64//file",
        "@platforms//cpu:arm64": "@apt_install_bwrap_arm64//file",
    }),
)

genrule(
    name = "bubblewrap",
    srcs = [":bubblewrap_archive"],
    outs = ["bwrap"],
    cmd = "set -euo pipefail\n" +
          '"$(BSDTAR_BIN)" -xOf "$(location :bubblewrap_archive)" data.tar.xz | ' +
          '"$(BSDTAR_BIN)" -xOf - ./usr/bin/bwrap > "$@"\nchmod 0755 "$@"',
    executable = True,
    toolchains = ["@bsd_tar_toolchains//:resolved_toolchain"],
    tools = ["@bsd_tar_toolchains//:resolved_toolchain"],
)

