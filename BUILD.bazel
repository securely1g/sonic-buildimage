# Expose Make-generated inputs to Bazel.
#
# Make prepares the config-engine OCI base, Scapy wheel, Debian packages and
# service manifests under target/ before Bazel assembles the images. This file
# declares existing files as Bazel inputs; it does not generate them or invoke Make.
#
# target/ has no BUILD.bazel of its own, so its files belong to this root Bazel
# package. Keep this input boundary here for now. Source exports, configuration
# rules and image assembly belong in their owners' BUILD.bazel files, such as
# dockers/docker-orchagent/BUILD.bazel and its config/BUILD.bazel.
#
# Empty globs allow this package to load before Make has prepared the inputs.
# The files must exist before building the Bazel targets that consume them.
exports_files(
    glob(
        [
            "target/docker-config-engine-trixie.oci/oci-layout",
            "target/bazel-manifests/*/manifest.json",
            "target/python-wheels/trixie/scapy-2.6.1.dev0-py3-none-any.whl",
        ],
        allow_empty = True,
    ),
)

# Track every OCI metadata file and blob, not just the oci-layout marker exported
# above, so changed contents and newly published layers invalidate Bazel actions.
filegroup(
    name = "config_engine_oci_files",
    srcs = glob(
        ["target/docker-config-engine-trixie.oci/**"],
        allow_empty = True,
        exclude = ["target/docker-config-engine-trixie.oci/oci-layout"],
    ),
    visibility = ["//visibility:public"],
)

# Syncd imports these existing Make packages through the shared deb_import rule.
# Keep filenames explicit: adding another file under target/debs must not change
# the image. Installation order belongs in dockers/docker-syncd-vs/BUILD.bazel.
exports_files([
    "target/debs/trixie/libnl-3-dev_3.7.0-0.2+b1sonic1_amd64.deb",
    "target/debs/trixie/libnl-route-3-dev_3.7.0-0.2+b1sonic1_amd64.deb",
