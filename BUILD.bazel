# Files needed for the Bazel build
_BAZEL_FILES = [
    "MODULE.bazel",
    "build_debian.sh",
    "files/build_templates/sonic_debian_extension.j2",
    "files/scripts/arp_update",
    "files/build_templates/arp_update_vars.j2",
    "files/build_templates/manifest.json.j2",
    "files/build_templates/per_namespace/swss.service.j2",
    "files/build_templates/swss.service.j2",
    "rules/docker-orchagent.mk",
]

exports_files(
    # Capture files produced by Make (e.g. the base docker layers).
    # allow_empty: on a clean tree Make has not produced anything yet.
    glob(
        [
            "target/*",
            "target/python-wheels/trixie/*.whl",
        ],
        allow_empty = True,
    ) +
    _BAZEL_FILES,
)

filegroup(
    name = "image_installer_test_data",
    srcs = [
        "installer/default_platform.conf",
        "installer/efi_sbatlevel.py",
        "installer/install.sh",
        "installer/sharch_body.sh",
        "onie-image.conf",
        "platform/vs/platform.conf",
    ],
    visibility = ["//tools/bazel/image:__pkg__"],
)

filegroup(
    name = "make_bridge_test_data",
    srcs = [
        "Makefile",
        "Makefile.work",
        "rules/config",
        "rules/docker-orchagent.mk",
        "rules/docker-sysmgr.mk",
        "slave.mk",
    ],
    visibility = ["//tools/bazel/tests:__pkg__"],
)
